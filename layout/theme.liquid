{%- comment -%} Hreflang (NL / EN / DE) - vlak vóór </head> {%- endcomment -%}
{%- assign current_path = request.path -%}
{%- assign clean_path = current_path -%}

{%- comment -%} Verwijder taal-prefixes om clean pad te krijgen {%- endcomment -%}
{%- if current_path contains '/en/' -%}
  {%- assign clean_path = current_path | replace_first: '/en/', '/' | replace_first: '/en', '/' -%}
{%- elsif current_path contains '/de/' -%}
  {%- assign clean_path = current_path | replace_first: '/de/', '/' | replace_first: '/de', '/' -%}
{%- elsif current_path == '/en' -%}
  {%- assign clean_path = '/' -%}
{%- elsif current_path == '/de' -%}
  {%- assign clean_path = '/' -%}
{%- endif -%}

{%- comment -%} Zorg dat lege paden / worden {%- endcomment -%}
{%- if clean_path == '' -%}
  {%- assign clean_path = '/' -%}
{%- endif -%}

{%- comment -%} Hreflang (EN / NL / DE) - EN is default zonder prefix {%- endcomment -%}
{%- assign current_path = request.path -%}
{%- assign clean_path = current_path -%}

{%- comment -%} Verwijder taal-prefixes om clean pad te krijgen {%- endcomment -%}
{%- if current_path contains '/nl/' -%}
  {%- assign clean_path = current_path | replace_first: '/nl/', '/' -%}
{%- elsif current_path contains '/de/' -%}
  {%- assign clean_path = current_path | replace_first: '/de/', '/' -%}
{%- elsif current_path contains '/nl' -%}
  {%- assign clean_path = current_path | replace_first: '/nl', '' -%}
{%- elsif current_path contains '/de' -%}
  {%- assign clean_path = current_path | replace_first: '/de', '' -%}
{%- endif -%}

{%- comment -%} Fix lege paden {%- endcomment -%}
{%- if clean_path == '' or clean_path == blank -%}
  {%- assign clean_path = '/' -%}
{%- endif -%}

{%- comment -%} Zorg dat pad begint met slash {%- endcomment -%}
{%- unless clean_path contains '/' -%}
  {%- assign clean_path = '/' | append: clean_path -%}
{%- endunless -%}

{%- comment -%} Check of we op ECHTE homepage zijn {%- endcomment -%}
{%- assign show_xdefault = false -%}
{%- if template.name == 'index' -%}
  {%- if request.path == '/' or request.path == '/nl' or request.path == '/de' or request.path == '/nl/' or request.path == '/de/' -%}
    {%- assign show_xdefault = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Hreflang-tags (EN / NL / DE) - EN is default {%- endcomment -%}
{%- assign current_path = request.path -%}
{%- assign clean_path = current_path -%}

{%- comment -%} Verwijder taal-prefixes {%- endcomment -%}
{%- if current_path contains '/nl/' -%}
  {%- assign clean_path = current_path | replace_first: '/nl/', '/' -%}
{%- elsif current_path contains '/de/' -%}
  {%- assign clean_path = current_path | replace_first: '/de/', '/' -%}
{%- elsif current_path == '/nl' -%}
  {%- assign clean_path = '/' -%}
{%- elsif current_path == '/de' -%}
  {%- assign clean_path = '/' -%}
{%- endif -%}

{%- comment -%} Fix lege paden {%- endcomment -%}
{%- if clean_path == '' or clean_path == blank -%}
  {%- assign clean_path = '/' -%}
{%- endif -%}

{%- comment -%} Bouw hreflang tags {%- endcomment -%}
{%- if clean_path == '/' -%}
  {%- comment -%} Homepage met trailing slashes {%- endcomment -%}
  <link rel="alternate" hreflang="en" href="{{ shop.url }}/" />
  <link rel="alternate" hreflang="nl" href="{{ shop.url }}/nl/" />
  <link rel="alternate" hreflang="de" href="{{ shop.url }}/de/" />
  {%- if template.name == 'index' -%}
  <link rel="alternate" hreflang="x-default" href="{{ shop.url }}/" />
  {%- endif -%}
{%- else -%}
  {%- comment -%} Andere pagina's {%- endcomment -%}
  <link rel="alternate" hreflang="en" href="{{ shop.url }}{{ clean_path }}" />
  <link rel="alternate" hreflang="nl" href="{{ shop.url }}/nl{{ clean_path }}" />
  <link rel="alternate" hreflang="de" href="{{ shop.url }}/de{{ clean_path }}" />
{%- endif -%}


<script async src="https://cdn.rebuyengine.com/onsite/js/storefront-helper.js"></script>

<style>
    /* Gorgias chat-button overlay fix: zorgt dat het kruisje van de chat-bubble klikbaar blijft */
      #chat-button,
        #chat-input {
            z-index: 2147483636 !important;
              }
              </style>
              
</head>

<body class="template-{{ template | split: '.' | first | handle }}
    {%- if template.suffix %} template-suffix-{{ template.suffix }}{% endif -%}
    {%- if settings.swatch_enabled %} swatch-method-{{ settings.swatch_method }} swatch-style-{{ settings.swatch_style }}{% endif -%}
    {%- if settings.enable_anims_image_load %} image-load-anim-enabled{% endif -%}
    {%- if template.suffix == 'black-friday' or template.name == 'index' or template.suffix == 'our-story' or template.suffix == 'w2024-collection' or template.suffix == 'dxr-collection' or template.suffix == 'duurzaamheid' or template.suffix == 'leopard' %} always-fixed-header{% endif -%}
    {% comment %} {%- if template.suffix == 'black-friday' or template.name == 'index' or template.suffix == 'leopard' %} white-header{% endif -%} {% endcomment %}
    " data-cc-animate-timeout="0">

  {%- if settings.enable_anims_reveal -%}
    <script>
      if ('IntersectionObserver' in window) {
        document.body.classList.add("cc-animate-enabled");
      }
    </script>
  {%- endif -%}

  <a class="skip-link visually-hidden" href="#content">{{ 'general.accessibility_labels.skip_to_content' | t }}</a>

  {%- sections 'header-group' -%}
  
<script>document.addEventListener("startasyncloading",function(){document.querySelectorAll("script[data-src]").forEach(a=>{datasrc=a.dataset.src,null!=datasrc&&(a.src=datasrc), delete a.dataset.src})});</script>  <script>document.addEventListener("startasyncloading",function(){document.querySelectorAll("link[data-href]").forEach(a=>{datahref=a.dataset.href,null!=datahref&&(a.href=datahref), delete a.dataset.href})});</script>
  
  {%- sections 'overlay-group' -%}

  <main id="content">
    <div class="main-container container">

      {{ content_for_layout }}
      {% if template.suffix == 'duurzaamheid' %}
        <div class="duurzaamheid-scroll-outer-wrap">
          {%- sections 'duurzaamheid-group' -%}
        </div>
      {% endif %}
    </div>
  </main>

  {% if request.path != '/challenge' %}
    {%- sections 'footer-group' -%}
  {% endif %}
<script>document.addEventListener("startasyncloading",function(){document.querySelectorAll("script[type='text/javascripts']").forEach(e=>{var t=document.createElement("script");for(a=0;a<e.attributes.length;a++){var r=e.attributes[a];t.setAttribute(r.name,r.value)}t.type="text/javascript",t.innerHTML=e.innerHTML,e.parentNode.insertBefore(t,e),e.parentNode.removeChild(e)})});</script>
	 
  {%- render 'lazy-loading' -%}

  <template id="ModalTemplate">
    <div class="quickbuy-modal cc-popup cc-popup--right" aria-hidden="true" data-freeze-scroll="true">
      <div class="cc-popup-background"></div>
      <div class="cc-popup-modal" role="dialog" aria-modal="true" aria-labelledby="">
        <div class="cc-popup-container">
          <button type="button" class="cc-popup-close tap-target" aria-label="{{ 'general.accessibility_labels.close' | t | escape }}">
            {%- render 'popup-close' -%}
          </button>
          <div class="cc-popup-content">
            <div class="loading-spinner"></div>
          </div>
        </div>
      </div>
  	</div>
  </template>
  {% if template.name == 'collection' or template.name == 'search' %}
  {% comment %} <script>
      var observer = new MutationObserver((mutationsList) => {
            for (const mutation of mutationsList) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    const htmlTag = document.documentElement;
                    if (htmlTag.classList.contains('spf-status-loaded')) {
                        onStatusLoaded();
                    }
                }
            }
        });
      function onStatusLoaded() {
        const parentSpan = document.querySelector('.gf-filter-trigger i').parentElement;
        const newSpan = document.createElement('span');
        newSpan.className = 'btn-text'; // Add the class 'text'
        
        // Move the existing text node into the new span
        newSpan.textContent = parentSpan.childNodes[1].textContent;
        
        parentSpan.childNodes[1].textContent = '';
        
        parentSpan.appendChild(newSpan);
        if(document.querySelector('.btn-coll-filter .button-icon'))
        parentSpan.querySelector('i').replaceWith(document.querySelector('.btn-coll-filter .button-icon').cloneNode(true))

        observer.disconnect();
      }

        

        const config = { attributes: true, attributeFilter: ['class'] };
        observer.observe(document.documentElement, config);
  </script> {% endcomment %}
    {% endif %}

  {% render 'rebuy-templates' %}
  <!-- shopify issue -->
{%- capture productTemplate -%}{% render 'globo.filter.product', themeTranslation: shop.metafields.globoFilter.themeTranslation.value[request.locale.iso_code] %}{%- endcapture -%}{%- unless productTemplate contains 'Liquid error' -%}<script id="gspfProduct" type="template/html">{{- productTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%} 
{%- capture treeTemplate -%}{% render 'globo.filter.tree' %}{%- endcapture -%}{%- unless treeTemplate contains 'Liquid error' -%}<script id="gspfFilterTree" type="template/html">{{- treeTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%} 
{%- capture sortTemplate -%}{% render 'globo.filter.sort' %}{%- endcapture -%}{%- unless sortTemplate contains 'Liquid error' -%}<script id="gspfFilterSort" type="template/html">{{- sortTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%} 
{%- capture searchTemplate -%}{% render 'globo.filter.search' %}{%- endcapture -%}{%- unless searchTemplate contains 'Liquid error' -%}<script id="gspfSearchResult" type="template/html">{{- searchTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%} 
{%- capture paginationTemplate -%}{% render 'globo.filter.pagination' %}{%- endcapture -%}{%- unless paginationTemplate contains 'Liquid error' -%}<script id="gspfPagination" type="template/html">{{- paginationTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%} 
{%- capture YMMTemplate -%}{% render 'globo.filter.form' %}{%- endcapture -%}{%- unless YMMTemplate contains 'Liquid error' -%}<script id="gspfForm" type="template/html">{{- YMMTemplate | replace: "script>", "scripttag>" -}}</script>{%- endunless -%}
  {{ 'custom.min.js' | asset_url | script_tag }}
  <script async src="https://cdn.rebuyengine.com/onsite/js/rebuy.js?shop={{ shop.permanent_domain }}"></script>


  <!-- Utilize StorefrontHelper to enrich product JSON with locale-aware titles -->
<script>
  // update product JSON every time products are loaded or changed
  document.addEventListener('rebuy.productsChange', (e) => {
    const widget = e.detail.widget;
    const storefrontHelper = new ShopifyStorefrontHelper();

    // loop over products in the widget and enrich product json
    widget.data.products.forEach((product) => storefrontHelper.updateProductJSON(product));
  });
</script>

</body>
</html>
