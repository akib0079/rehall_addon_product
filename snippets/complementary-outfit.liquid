{%- comment -%}
  Complete your outfit (native) - replaces the Rebuy "Complete your outfit" widget.
  Server-rendered cards for the `complementary_outfit` block in sections/main-product.liquid.
  Styles: assets/complementary-outfit.css / behaviour: assets/complementary-outfit.js (<complementary-outfit>).

  Accepts:
  - product: {Object} Current product
  - block: {Object} The complementary_outfit block (heading, max_products, use_discovery_fallback,
    image_click, zoom_on_hover)
  - section: {Object} Parent section (reserved)

  A card = one product in ONE colour: that colour's photo, the title, the price and the in-stock sizes of that
  colour only (no colour choice on the card).

  Sources, in order; the first one that renders at least one card is used (sources are never mixed):
  1. product.metafields.custom.complementary_variants (list.variant_reference, "Complete your outfit"):
     each selected variant gives its product and its colour (all variants when the product has no colour option).
  2. product.metafields.custom.complementary_products (list.product_reference, legacy): the colour is picked
     automatically: colour of rec.metafields.custom.priority_variant > colour of the featured image > first
     colour, each only when that colour has a size in stock.
  3. Search & Discovery complementary products (block setting), same automatic colour.

  Skipped: empty or deleted references, the current product, a colour without any size in stock (another colour
  is never substituted), a product + colour that is already shown. Sold-out sizes get no button.

  Usage:
  {% render 'complementary-outfit', product: product, block: block, section: section %}
{%- endcomment -%}
{%- liquid
  assign cyo_max = block.settings.max_products | default: 3 | plus: 0
  if cyo_max < 1
    assign cyo_max = 3
  endif

  assign cyo_image_click = 'reveal'
  if block.settings.image_click == 'link'
    assign cyo_image_click = 'link'
  endif

  assign cyo_add_text = 'products.complementary.add' | t

  # Colour option names ('|'-delimited for exact matching): theme swatch setting + common fallbacks
  assign cyo_colour_names = '|color|colour|kleur|farbe|couleur|colore|cor|farve|'
  assign cyo_setting_names = settings.swatch_option_name | downcase | split: ','
  for cyo_setting_name in cyo_setting_names
    assign cyo_name = cyo_setting_name | strip
    if cyo_name != blank
      assign cyo_needle = cyo_name | prepend: '|' | append: '|'
      unless cyo_colour_names contains cyo_needle
        assign cyo_colour_names = cyo_colour_names | append: cyo_name | append: '|'
      endunless
    endif
  endfor

  assign cyo_source_keys = 'variants,products'
  if block.settings.use_discovery_fallback
    assign cyo_source_keys = 'variants,products,discovery'
  endif
  assign cyo_source_keys = cyo_source_keys | split: ','

  assign cyo_count = 0
-%}

{%- capture cyo_items -%}
  {%- for cyo_source_key in cyo_source_keys -%}
    {%- liquid
      # Stop after the first source that rendered at least one card
      if cyo_count > 0
        break
      endif
      case cyo_source_key
        when 'variants'
          assign cyo_source = product.metafields.custom.complementary_variants.value
        when 'products'
          assign cyo_source = product.metafields.custom.complementary_products.value
        else
          assign cyo_source = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
      endcase
      # Shown groups (by their first in-stock variant id: one per product + colour) and used DOM id suffixes
      assign cyo_seen_groups = '|'
      assign cyo_seen_uids = '|'
    -%}

    {%- for cyo_ref in cyo_source -%}
      {%- liquid
        if cyo_count >= cyo_max
          break
        endif

        # A variant reference carries its product; a product reference is the product
        assign cyo_ref_variant = nil
        if cyo_source_key == 'variants'
          assign cyo_ref_variant = cyo_ref
          assign cyo_rec = cyo_ref.product
        else
          assign cyo_rec = cyo_ref
        endif
        if cyo_rec.id == blank or cyo_rec.id == product.id or cyo_rec.available == false
          continue
        endif

        # Colour option (first match) + names of the remaining ("size") options
        assign cyo_colour_idx = -1
        assign cyo_colour_opt = nil
        assign cyo_rest_names = ''
        for cyo_opt in cyo_rec.options_with_values
          assign cyo_needle = cyo_opt.name | strip | downcase | prepend: '|' | append: '|'
          if cyo_colour_idx == -1 and cyo_colour_names contains cyo_needle
            assign cyo_colour_idx = cyo_opt.position | minus: 1
            assign cyo_colour_opt = cyo_opt
          else
            if cyo_rest_names != ''
              assign cyo_rest_names = cyo_rest_names | append: ' / '
            endif
            assign cyo_rest_names = cyo_rest_names | append: cyo_opt.name
          endif
        endfor
        if cyo_rec.has_only_default_variant or cyo_rest_names == ''
          assign cyo_rest_names = cyo_rec.title
        endif

        # The card's colour as a string ('' = no colour option: all variants of the product form the group)
        assign cyo_colour = ''
        assign cyo_featured_colour = ''
        if cyo_colour_idx >= 0
          if cyo_source_key == 'variants'
            assign cyo_colour = cyo_ref_variant.options[cyo_colour_idx] | append: ''
          else
            # Product reference: colour of the priority variant, then the colour of the first variant (sold-out
            # ones included) whose media is the featured media (media ids; variant images as fallback key),
            # then the first colour; each only when it has a size in stock. Colours in stock as an array of
            # strings: `contains` on it is an exact match.
            assign cyo_opt_key = 'option' | append: cyo_colour_opt.position
            assign cyo_avail_colours = cyo_rec.variants | where: 'available' | map: cyo_opt_key | uniq
            assign cyo_pv_id = cyo_rec.metafields.custom.priority_variant.value.id
            assign cyo_priority_colour = ''
            assign cyo_feat_media_id = cyo_rec.featured_media.id
            assign cyo_feat_image_id = cyo_rec.featured_image.id
            for cyo_v in cyo_rec.variants
              assign cyo_v_colour = cyo_v.options[cyo_colour_idx] | append: ''
              if cyo_pv_id != blank and cyo_v.id == cyo_pv_id
                assign cyo_priority_colour = cyo_v_colour
              endif
              if cyo_featured_colour == ''
                assign cyo_v_media_id = cyo_v.featured_media.id
                if cyo_v_media_id != blank and cyo_feat_media_id != blank
                  if cyo_v_media_id == cyo_feat_media_id
                    assign cyo_featured_colour = cyo_v_colour
                  endif
                elsif cyo_feat_image_id != blank and cyo_v.featured_image.id == cyo_feat_image_id
                  assign cyo_featured_colour = cyo_v_colour
                endif
              endif
            endfor

            if cyo_avail_colours contains cyo_priority_colour
              assign cyo_colour = cyo_priority_colour
            elsif cyo_avail_colours contains cyo_featured_colour
              assign cyo_colour = cyo_featured_colour
            else
              for cyo_value in cyo_colour_opt.values
                assign cyo_needle = cyo_value | append: ''
                if cyo_avail_colours contains cyo_needle
                  assign cyo_colour = cyo_needle
                  break
                endif
              endfor
            endif
          endif
        endif

        # DOM id suffix: product id + colour handle ('all' without a colour option); made unique when two colours
        # of one product share a handle (or the handle is empty)
        assign cyo_handle = 'all'
        if cyo_colour_idx >= 0
          assign cyo_handle = cyo_colour | handleize
          if cyo_handle == blank
            assign cyo_handle = 'c' | append: forloop.index
          endif
        endif
        assign cyo_uid = block.id | append: '-' | append: cyo_rec.id | append: '-' | append: cyo_handle
        assign cyo_needle = cyo_uid | prepend: '|' | append: '|'
        if cyo_seen_uids contains cyo_needle
          assign cyo_uid = cyo_uid | append: '-' | append: forloop.index
        endif
        assign cyo_opts_id = 'cyo-opts-' | append: cyo_uid

        assign cyo_first = nil
        assign cyo_colour_img = nil
        assign cyo_g_count = 0
        assign cyo_g_maxlen = 0
      -%}

      {%- capture cyo_buttons -%}
        {%- for cyo_v in cyo_rec.variants -%}
          {%- liquid
            if cyo_colour_idx >= 0
              assign cyo_v_colour = cyo_v.options[cyo_colour_idx] | append: ''
              if cyo_v_colour != cyo_colour
                continue
              endif
            endif

            # Colour photo: first variant image of the group (sold-out sizes included)
            unless cyo_colour_img
              assign cyo_colour_img = cyo_v.featured_image | default: cyo_v.featured_media.preview_image
            endunless

            # Sold-out sizes get no button: count, columns, label length and price use in-stock ones only
            unless cyo_v.available
              continue
            endunless
            assign cyo_g_count = cyo_g_count | plus: 1
            unless cyo_first
              assign cyo_first = cyo_v
            endunless

            # Label = non-colour option values ("M", "M / Long"); "+ Add" when there are none
            assign cyo_label = ''
            unless cyo_rec.has_only_default_variant
              for cyo_option_value in cyo_v.options
                if forloop.index0 != cyo_colour_idx
                  if cyo_label != ''
                    assign cyo_label = cyo_label | append: ' / '
                  endif
                  assign cyo_label = cyo_label | append: cyo_option_value
                endif
              endfor
            endunless

            # Accessible name "Add {title} – {colour} / {size} to cart" (the colour only with a colour option).
            # Default Title has neither: "Add {title} to cart" (the empty " – " of the translation is dropped).
            assign cyo_aria_size = cyo_label
            if cyo_colour_idx >= 0
              if cyo_label == ''
                assign cyo_aria_size = cyo_colour
              else
                assign cyo_aria_size = cyo_colour | append: ' / ' | append: cyo_label
              endif
            endif
            assign cyo_aria = 'products.complementary.add_to_cart_label' | t: title: cyo_rec.title, size: cyo_aria_size
            if cyo_aria_size == ''
              assign cyo_aria = cyo_aria | replace: ' –  ', ' '
            endif

            assign cyo_add_only = false
            if cyo_label == ''
              assign cyo_label = cyo_add_text
              assign cyo_add_only = true
            endif

            if cyo_label.size > cyo_g_maxlen
              assign cyo_g_maxlen = cyo_label.size
            endif
          -%}
          <button type="button" class="cyo-size" data-variant-id="{{ cyo_v.id }}" aria-label="{{ cyo_aria | escape_once }}"{% if cyo_add_only %} data-add-only{% endif %}><span class="cyo-size__label">{{ cyo_label | escape }}</span></button>
        {%- endfor -%}
      {%- endcapture -%}

      {%- liquid
        # No size of this colour in stock: no card (another colour is never substituted)
        if cyo_g_count == 0
          continue
        endif

        # Same product + colour already shown (a group is identified by its first in-stock variant)
        assign cyo_needle = cyo_first.id | prepend: '|' | append: '|'
        if cyo_seen_groups contains cyo_needle
          continue
        endif
        assign cyo_seen_groups = cyo_seen_groups | append: cyo_first.id | append: '|'
        assign cyo_seen_uids = cyo_seen_uids | append: cyo_uid | append: '|'
        assign cyo_count = cyo_count | plus: 1

        # Balanced grid columns, computed here so the layout never depends on JS: the longest label sets the
        # column limit, rows are then balanced (7 sizes -> 4+3, 9 -> 5+4, 10 -> 5+5, 6 -> 6, 3 -> 3, 1 -> 1).
        # Three tiers: default, compact (card body < 300px) and narrow (card body < 180px: iPad portrait, 320px phones).
        # Integer divided_by floors: ceil(a/b) = (a+b-1)/b
        if cyo_g_maxlen <= 4
          assign cyo_max_cols = 6
        elsif cyo_g_maxlen <= 7
          assign cyo_max_cols = 5
        elsif cyo_g_maxlen <= 12
          assign cyo_max_cols = 3
        else
          assign cyo_max_cols = 2
        endif
        if cyo_g_maxlen <= 3
          assign cyo_max_cols_c = 6
        elsif cyo_g_maxlen == 4
          assign cyo_max_cols_c = 5
        elsif cyo_g_maxlen <= 6
          assign cyo_max_cols_c = 4
        elsif cyo_g_maxlen == 7
          assign cyo_max_cols_c = 3
        else
          assign cyo_max_cols_c = 2
        endif
        if cyo_g_maxlen <= 4
          assign cyo_max_cols_n = 3
        elsif cyo_g_maxlen <= 7
          assign cyo_max_cols_n = 2
        else
          assign cyo_max_cols_n = 1
        endif
        assign cyo_rows = cyo_g_count | plus: cyo_max_cols | minus: 1 | divided_by: cyo_max_cols
        assign cyo_cols = cyo_g_count | plus: cyo_rows | minus: 1 | divided_by: cyo_rows
        assign cyo_rows_c = cyo_g_count | plus: cyo_max_cols_c | minus: 1 | divided_by: cyo_max_cols_c
        assign cyo_cols_c = cyo_g_count | plus: cyo_rows_c | minus: 1 | divided_by: cyo_rows_c
        assign cyo_rows_n = cyo_g_count | plus: cyo_max_cols_n | minus: 1 | divided_by: cyo_max_cols_n
        assign cyo_cols_n = cyo_g_count | plus: cyo_rows_n | minus: 1 | divided_by: cyo_rows_n

        # Price of the group's first in-stock variant (theme money convention)
        if settings.product_currency_code_enabled
          assign cyo_price = cyo_first.price | money_with_currency
        else
          assign cyo_price = cyo_first.price | money
        endif
        assign cyo_compare = ''
        if cyo_first.compare_at_price > cyo_first.price
          assign cyo_compare = cyo_first.compare_at_price | money
        endif

        # Photo: variant reference -> its own image; product reference -> the featured image when it shows the
        # card's colour (or there is no colour option). Then the colour's image, the featured image, a placeholder.
        assign cyo_card_img = nil
        if cyo_source_key == 'variants'
          assign cyo_card_img = cyo_ref_variant.featured_image | default: cyo_ref_variant.featured_media.preview_image
        elsif cyo_colour_idx == -1 or cyo_colour == cyo_featured_colour
          assign cyo_card_img = cyo_rec.featured_media.preview_image | default: cyo_rec.featured_image
        endif
        unless cyo_card_img
          assign cyo_card_img = cyo_colour_img
        endunless
        unless cyo_card_img
          assign cyo_card_img = cyo_rec.featured_media.preview_image | default: cyo_rec.featured_image
        endunless
      -%}

      {%- capture cyo_media_html -%}
        {%- if cyo_card_img -%}
          {%- liquid
            assign cyo_ar = cyo_card_img.aspect_ratio | default: 0.8 | at_least: 0.1
            assign cyo_img_height = 300 | divided_by: cyo_ar | round
            assign cyo_img_alt = cyo_card_img.alt | default: cyo_rec.title
          -%}
          <img class="cyo-card__img" src="{{ cyo_card_img | image_url: width: 200 | escape }}" srcset="{{ cyo_card_img | image_url: width: 100 | escape }} 100w, {{ cyo_card_img | image_url: width: 200 | escape }} 200w, {{ cyo_card_img | image_url: width: 300 | escape }} 300w" sizes="100px" width="300" height="{{ cyo_img_height }}" alt="{{ cyo_img_alt | escape }}" loading="lazy">
        {%- else -%}
          {{- 'product-1' | placeholder_svg_tag: 'cyo-card__img' -}}
        {%- endif -%}
      {%- endcapture -%}

      <li class="cyo__item">
        <div class="cyo-card" data-product-id="{{ cyo_rec.id }}" data-variant-id="{{ cyo_first.id }}" data-product-title="{{ cyo_rec.title | escape }}">
          <div class="cyo-card__media">
            {%- if cyo_image_click == 'link' -%}
              <a class="cyo-card__media-link" href="{{ cyo_first.url }}" tabindex="-1">{{ cyo_media_html }}</a>
            {%- else -%}
              <button type="button" class="cyo-card__media-btn" aria-controls="{{ cyo_opts_id }}" aria-expanded="false" aria-label="{{ 'products.complementary.choose_size' | t: title: cyo_rec.title | escape_once }}">{{ cyo_media_html }}</button>
            {%- endif -%}
          </div>
          <div class="cyo-card__body">
            <h3 class="cyo-card__heading"><a class="cyo-card__title" href="{{ cyo_first.url }}">{{ cyo_rec.title | escape }}</a></h3>
            <div class="cyo-card__price">
              {%- if cyo_compare != '' -%}
                <span class="cyo-card__price-current is-sale">{{ cyo_price }}</span><s class="cyo-card__price-compare">{{ cyo_compare }}</s>
              {%- else -%}
                <span class="cyo-card__price-current">{{ cyo_price }}</span>
              {%- endif -%}
            </div>
            <div class="cyo-card__options" id="{{ cyo_opts_id }}">
              <div class="cyo-sizes" role="group" aria-label="{{ cyo_rest_names | escape }}" style="--cyo-cols:{{ cyo_cols }};--cyo-cols-compact:{{ cyo_cols_c }};--cyo-cols-narrow:{{ cyo_cols_n }};">
                {{- cyo_buttons -}}
              </div>
            </div>
            <p class="cyo-card__error" role="alert" hidden></p>
          </div>
        </div>
      </li>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cyo_count > 0 or request.design_mode -%}
  <link rel="stylesheet" href="{{ 'complementary-outfit.css' | asset_url }}">
  <script src="{{ 'complementary-outfit.js' | asset_url }}" defer></script>
  <complementary-outfit
    class="cyo{% if block.settings.zoom_on_hover %} cyo--zoom{% endif %}"
    data-image-click="{{ cyo_image_click }}"
    data-added-text="{{ 'products.complementary.added' | t: title: '[title]', size: '[size]' | escape_once }}"
    data-error-text="{{ 'products.complementary.error' | t | escape_once }}"
    {{ block.shopify_attributes }}
  >
    <div class="cyo__header">
      <svg class="cyo__icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false"><path d="M18.3373 20.1673H3.67057C3.16432 20.1673 2.75391 19.7569 2.75391 19.2507V2.75065C2.75391 2.24439 3.16432 1.83398 3.67057 1.83398H18.3373C18.8435 1.83398 19.2539 2.24439 19.2539 2.75065V19.2507C19.2539 19.7569 18.8435 20.1673 18.3373 20.1673ZM17.4206 18.334V3.66732H4.58724V18.334H17.4206ZM8.25391 5.50065V7.33398C8.25391 8.85276 9.4851 10.084 11.0039 10.084C12.5227 10.084 13.7539 8.85276 13.7539 7.33398V5.50065H15.5873V7.33398C15.5873 9.86527 13.5352 11.9173 11.0039 11.9173C8.47261 11.9173 6.42057 9.86527 6.42057 7.33398V5.50065H8.25391Z" fill="currentColor"/></svg>
      <h2 class="cyo__title">
        {%- if block.settings.heading != blank -%}
          {{- block.settings.heading | escape -}}
        {%- else -%}
          {{- 'products.complementary.title' | t -}}
        {%- endif -%}
      </h2>
    </div>
    {%- if cyo_count > 0 -%}
      <ul class="cyo__list" role="list">
        {{- cyo_items -}}
      </ul>
      <p class="cyo__status visually-hidden" aria-live="polite"></p>
    {%- else -%}
      <div class="cyo__placeholder">{{ 'products.complementary.editor_placeholder' | t }}</div>
    {%- endif -%}
  </complementary-outfit>
{%- endif -%}
