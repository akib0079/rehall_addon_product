{%- comment -%}Do not edit this file{%- endcomment -%}
{% raw %}
  {%- assign swatch_options = 'Colour~~Color' | downcase | split: "~~" | uniq -%}
  {%- assign image_options  = '' | downcase | split: "~~" | uniq -%}
  {%- assign text_options   = 'Size' | downcase | split: "~~" | uniq  -%}

  {%- assign image_size     = '720x1008' -%}
  {%- assign no_image = 'https://cdn.shopify.com/s/images/themes/product-1.png' -%}

  {%- assign featured_image            = product.featured_image -%}
  {%- assign product_price             = product.price -%}
  {%- assign product_compare_at_price  = product.compare_at_price -%}
  {%- assign selected_or_first_available_variant = product.selected_or_first_available_variant -%}
  {%- assign variant_url = '' -%}
    {%- if product.selected_or_first_available_variant -%}
    {%- assign variant_url = '?variant=' | append: product.selected_or_first_available_variant.id -%}
  {%- endif -%}
      {% if product.selected_variant %}
    {% assign selected_or_first_available_variant = product.selected_variant %}
    {% assign product_price             = selected_or_first_available_variant.price %}
    {% assign product_compare_at_price  = selected_or_first_available_variant.compare_at_price %}
    {% if selected_or_first_available_variant.image %}
      {% assign featured_image = selected_or_first_available_variant.image %}
    {% endif %}
  {% endif %}
                            {%- assign images_count = product.images | size -%}
  
{%- liquid
  if collection and settings.prod_thumb_url_within_coll and product.collections contains collection
    assign product_url = product.url | within: collection
  else
    assign product_url = product.url | within: collection
    endif
    assign product_url = product_url | append: variant_url

  assign product_images = product.image
  if settings.prod_thumb_hover_image and product_images.size > 1
    assign show_hover_image = true
  else
    assign show_hover_image = false
  endif

  assign cheapest_variant = product.variants | sort: 'price' | first

  if product.metafields.theme.card_bg != blank
    assign initial_card_bg = product.metafields.theme.card_bg
  endif
  for variant in product.variants
    if forloop.first and variant.metafields.theme.card_bg
      assign initial_card_bg = variant.metafields.theme.card_bg
    elsif variant.featured_media and variant.featured_media.id == product.featured_media.id and variant.metafields.theme.card_bg
      assign initial_card_bg = variant.metafields.theme.card_bg
    endif
  endfor
-%}

<div {% if showPageData %} data-page="{{page}}"{% endif %} class="product-grid__item spf-col-xl-12 spf-col-lg-12 spf-col-md-12 spf-col-sm-12 spf-col-12">
  <div class="spf-product-card spf-product-card__left spf-product-card__template-1{% unless product.available %} spf-soldout{% endunless %}">
    <product-block {% if manual_load %}manual-load{% endif %} {% unless no_swiping %}enable-swipe{% endunless %} data-product-id="{{ product.id }}" class="product-block custom" {% if animate %}data-cc-animate{% endif %}>
  <div class="block-inner"{% if initial_card_bg %} style="--bg:{{ initial_card_bg }}"{% endif %}>
    <div class="block-inner-inner">
      {% if images_count > 0 %}
        <div class="image-cont card-scheme card-scheme--{{ settings.product_card_color_scheme }} {% if settings.product_card_color_scheme == 'none' %}card-br-oh{% endif %}{% if show_hover_image %} image-cont--with-secondary-image{% endif %}">
          <a class="product-link" href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
            <div class="image-label-wrap">
              <div class="image-label-wrap__images">
                {%- comment -%} DEED: hover-afbeelding = de eerstvolgende foto na de hoofdfoto met dezelfde alt-tekst (zelfde kleur), zodat een kleurkaart bij hover nooit een foto van een andere kleur toont {%- endcomment -%}
                {%- liquid
                  assign hover_image_id = false
                  assign featured_image_found = false
                  assign featured_image_alt = ''
                  for image in product.images
                    if featured_image_found
                      if image.alt == featured_image_alt
                        assign hover_image_id = image.id
                      endif
                      break
                    endif
                    if image.id == featured_image.id
                      assign featured_image_found = true
                      assign featured_image_alt = image.alt
                    endif
                  endfor
                -%}
                {%- for image in product.images -%}
                    {% if featured_image.id == image.id or image.id == hover_image_id %}
                      <img
                        data-variants="{% if image.variant_ids %}{{image.variant_ids | join: ','}}{% endif %}"
                        class="product-block__image spf-product-card__image spf-product-card__image-{% if featured_image.id == image.id %}main{% else %}secondary{% endif %}"
                        src="{{image.src | img_url: image_size}}"
                        data-sizes="auto"
                        data-aspectratio="{{image.aspect_ratio}}"
                        data-parent-fit="contain"
                        alt="{{image.alt | escape}}"
                      />
                      
                    {% endif %}
                  {%- endfor -%}
                
              </div>
              {% comment %} {% assign notbf = true %}
              {%- for collection in product.collections %}
                {% if collection.title == 'Black Friday' %}
                {% assign notbf = false %}
                <div class="product-label product-label--black-friday">
                  <span>{{ settings.product_card_bf }}</span>
                </div>
                {% break %}
                {% endif %}
              {%- endfor -%} {% endcomment %}
              {% if notbf and settings.prod_reduction_show and product.compare_at_price > product.price %}
                  <div class="product-label product-label--sale">
                    <span>Sale</span>
                  </div>
                
              {% endif %}
              {%# render 'product-label', product: product, cheapest_variant: cheapest_variant %}
            </div>
          </a>
        
         
          {%- if true -%}
           {%- assign secondary_option_name = 'Size, size, maat, Maat' | downcase %}
          <div class="product__floating-bar desktop-only">
            {%- for product_option in product.options -%}
             {%- assign product_option_name = product_option.name | downcase %}
              {%- if secondary_option_name contains product_option_name -%}
                <div class="product-block-options js-only" data-option-name="{{ product_option.name | escape }}">
                  {%- assign product_option_position_0index = product_option.position | minus: 1 -%}
                    {%- for product_option_value in product_option.values -%}
                      {%- liquid
                        assign option_value_variant = false
                        for variant in product.variants
                          if variant.options[product_option_position_0index] == product_option_value
                            assign option_value_variant = variant
                            break
                          endif
                        endfor

                      -%}
                      <span class="product-block-options__item"
                        data-option-item="{{ product_option_value | escape }}"
                        {%- if option_value_variant.metafields.theme.card_bg != blank %} data-card-bg="{{ option_value_variant.metafields.theme.card_bg }}"{% endif %}>
                        <span class="product-block-options__item__visible">{{ product_option_value | escape }}</span>
                        <span class="product-block-options__item__text">{{ product_option_value }}</span>
                      </span>
                    
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
            <div class="product__floating-buttons">
              <a class="quick-action-button quick-action-button--visibility-{{ settings.quickbuy_visibility }} quick-add quick-add-toggle tap-target" href="{{ product_url }}" data-variant-id="{{ product.variants.first.id }}" aria-label="{{ 'products.grid.add_to_cart' | t }}">
                <span class="product__icon-cart">
                  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" fill-rule="evenodd" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.00014 14H18.1359C19.1487 14 19.6551 14 20.0582 13.8112C20.4134 13.6448 20.7118 13.3777 20.9163 13.0432C21.1485 12.6633 21.2044 12.16 21.3163 11.1534L21.9013 5.88835C21.9355 5.58088 21.9525 5.42715 21.9031 5.30816C21.8597 5.20366 21.7821 5.11697 21.683 5.06228C21.5702 5 21.4155 5 21.1062 5H4.50014M2 2H3.24844C3.51306 2 3.64537 2 3.74889 2.05032C3.84002 2.09463 3.91554 2.16557 3.96544 2.25376C4.02212 2.35394 4.03037 2.48599 4.04688 2.7501L4.95312 17.2499C4.96963 17.514 4.97788 17.6461 5.03456 17.7462C5.08446 17.8344 5.15998 17.9054 5.25111 17.9497C5.35463 18 5.48694 18 5.75156 18H19M7.5 21.5H7.51M16.5 21.5H16.51M8 21.5C8 21.7761 7.77614 22 7.5 22C7.22386 22 7 21.7761 7 21.5C7 21.2239 7.22386 21 7.5 21C7.77614 21 8 21.2239 8 21.5ZM17 21.5C17 21.7761 16.7761 22 16.5 22C16.2239 22 16 21.7761 16 21.5C16 21.2239 16.2239 21 16.5 21C16.7761 21 17 21.2239 17 21.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="product__icon-check">
                  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 26 26" fill="none">
                    <path d="M20.9858 6.7832L9.82637 17.9426L4.75391 12.8702" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                

                <div class="product__var_ids">
                  {%- for variant in product.variants -%}
                    <input type="hidden" class="product__var_id" data-option-item="{{ variant.title | escape }}" data-available="{{ variant.available }}" value="{{ variant.id }}">
                  {%- endfor -%}
                </div>
              </a>
            </div>
          </div>
          {%- endif -%}
        </div>
      {% else %}
        <div class="image-cont">
          <div class="placeholder-image">{{ 'product-1' | placeholder_svg_tag }}</div>
        </div>
      {% endif %}

      <div class="product-info info_alt{% if settings.swatch_enabled and settings.prod_thumb_swatches_layout != blank %} grid{% endif %}">
        <a class="product-link" href="{{ product_url }}">
          

          <div class="product-block__title">{{ product.title }}</div>

        </a>

        {%- assign swatch_option_name = settings.swatch_option_name | downcase %}
       {%- if true -%}
          {%- assign options_to_show = swatch_option_name | replace: ', ', ',' | split: ',' -%}
          {%- for product_option in product.options -%}
           {%- assign product_option_name = product_option.name | downcase %}
           <p style="display: none">
           {{ product_option.name  }}
           {{ swatch_option_name  }}
           {{ options_to_show contains product_option_name  }}
           </p>
            {%- capture options_row_html -%}
              {%- if options_to_show contains product_option_name -%}
                <div class="product-block-options swatch product-block-options--method-{{ settings.swatch_method }} js-only" data-option-name="{{ product_option.name | escape }}">
                  <cc-carousel class="cc-carousel" set-item-classes loop>
                    <div class="cc-carousel__scroll-outer">
                      <div class="cc-carousel__scroll-area product-block-options__inner">
                      <!-- <div class=" product-block-options__inner"> -->
                        {%- if product.options.size == 1 -%}
                          {%- for variant in product.variants limit:4 -%}
                            {% comment %} {%- liquid
                              if settings.swatch_method == 'image' and variant.featured_media == blank
                                continue
                              endif
                            -%} {% endcomment %}
                            <span class="product-block-options__item
                                {% comment %} {%- unless settings.prod_thumb_options_disable_unavailable == false or variant.available %} product-block-options__item--unavailable{% endunless %} {% endcomment %}
                                {%- if settings.swatch_method == 'image' and variant.featured_media.preview_image %} background-image{% endif %}"
                              data-option-item="{{ variant.title | escape }}"
                              {%- if variant.featured_media %} data-media="{{ variant.featured_media.id }}"{% endif %}
                              {%- if settings.swatch_method == 'standard' %} data-swatch="{{ variant.title | replace: '"', '' | downcase }}"{% endif %}
                              {%- if variant.metafields.theme.card_bg != blank %} data-card-bg="{{ variant.metafields.theme.card_bg }}"{% endif %}>
                              {%- if settings.swatch_method == 'image' and variant.featured_media.preview_image -%}
                                {{ variant.featured_media.preview_image | image_url: width: 68, height: 68, crop: settings.swatch_crop_align | image_tag: class: 'background-image__image', loading: 'lazy' | replace: ' src="', ' src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" data-msrc="' }}
                              {%- endif -%}
                              <span class="product-block-options__item__text">{{ variant.title }}</span></span>
                          {%- endfor -%}
                        {%- else -%}
                          {%- assign product_option_position_0index = product_option.position | minus: 1 -%}
                          {%- assign first = true -%}
                          {%- for product_option_value in product_option.values limit:4 -%}
                            {%- liquid
                              assign option_value_variant = false
                              for variant in product.variants
                                if variant.options[product_option_position_0index] == product_option_value
                                  assign option_value_variant = variant
                                  break
                                endif
                              endfor

                              if settings.prod_thumb_options_disable_unavailable
                                assign is_unavailable = true
                                for variant in product.variants
                                  if variant.available and variant.options[product_option_position_0index] == product_option_value
                                    assign is_unavailable = false
                                    break
                                  endif
                                endfor
                              else
                                assign is_unavailable = false
                              endif


                            -%}
                            <span class="product-block-options__item
                                {% comment %} {%- if is_unavailable %} product-block-options__item--unavailable{% endif %} {% endcomment %}
                                {%- if settings.swatch_method == 'image' and option_value_variant.featured_media %} background-image{% endif %}{% if first and is_unavailable != true %} active{% endif %}"
                              data-option-item="{{ product_option_value | escape }}"
                              {%  if option_value_variant.featured_media %} data-media="{{ option_value_variant.featured_media.id }}"{% endif %}
                              {%- if settings.swatch_method == 'standard' %} data-swatch="{{ product_option_value | replace: '"', '' | downcase }}"{% endif %}
                              {%- if option_value_variant.metafields.theme.card_bg != blank %} data-card-bg="{{ option_value_variant.metafields.theme.card_bg }}"{% endif %}>
                              {%- if settings.swatch_method == 'image' and option_value_variant.featured_media -%}
                                {{ option_value_variant.featured_media.preview_image | image_url: width: 68, height: 68, crop: settings.swatch_crop_align | image_tag: class: 'background-image__image', loading: 'lazy' | replace: ' src="', ' src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" data-msrc="' }}
                              {%- endif -%}
                              <span class="product-block-options__item__text">{{ product_option_value }}</span>
                            </span>
                            {% if is_unavailable != true %}
                            {%- assign first = false -%}
                            {%  endif %}
                          {%- endfor -%}
                        {%- endif -%}
                      </div>
                    </div>
                    <!-- <button class="cc-carousel-button cc-carousel-button--no-bg cc-carousel-button--next tap-target" aria-label="{{ 'general.accessibility_labels.next' | t }}"><span class="icon--small ltr-icon">{% render 'svg-chevron-right' %}</span></button> -->
                  </cc-carousel>
                </div>
              {%- endif -%}
            {%- endcapture -%}
            {%- liquid
              #if options_row_html contains '__item'
                echo options_row_html
                break
              #endif
            -%}
          {%- endfor -%}
        {%- endif -%}

        {%- capture product_block_price -%}
          <div class="product-price">
            {% comment %}
            {% if product.price_varies %}
              <span class="product-price__item product-price__from">{{ 'products.listing.from' | t }}</span>
            {% endif %}
            {% endcomment %}
            <span class="product-price__item product-price__amount {% if cheapest_variant.compare_at_price > cheapest_variant.price %}product-price__amount--on-sale{% endif %} theme-money">
              {%- if settings.product_currency_code_enabled -%}
                {{ cheapest_variant.price | money_with_currency }}
              {%- else -%}
                {{ cheapest_variant.price | money }}
              {%- endif -%}
            </span>
            {% if cheapest_variant.compare_at_price > cheapest_variant.price %}
              <span class="product-price__item product-price__compare theme-money">{{ cheapest_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          {% #render 'unit-price', variant: cheapest_variant %}
        {%- endcapture -%}

        <div class="product-block__price-row">
          <div class="product-block__price">{{ product_block_price }}</div>          
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" class="rebuy-prod-data">
      {{product | json}}
  </script>
</product-block>
  </div>
</div>



{% endraw %}
