
<nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
<a class="link home-link" href="{{ routes.root_url  }}">{{ 'general.breadcrumbs.home' | t }}</a>
{%- if collection -%}
    <span class="separate" aria-hidden="true">
        /
    </span>
    {%- if collection.handle -%}
        {%- if product -%}
        <span>{{ collection.title | split: '|' | first | link_to: collection.url }}</span>
        {%else %}
            <span>{{ collection.title | split: '|' | first }}</span>
        {%- endif -%}
    {%- endif -%}
{%- endif -%}
{%- if product -%}
    <span class="separate" aria-hidden="true">
        /
    </span>
        <span class="product-title">{{ product.title | split: '|' | first }}</span>
{%- endif -%}
</nav>
{% style %}
    .breadcrumb{
        color: #6D6D6D;
        font-size: 12px;
        font-weight: 400;
        line-height: 200%; 
        margin-bottom: 8px;
        .product-form &{
            margin-bottom: 12px;
        }
        .separate{
            margin-inline: 3px;
        }
        a{
            color: inherit;
            transition: color 0.3s ease-out;
            &:hover{
                color: #202020;
            }
        }
        .product-title{
            text-transform: uppercase;
        }
    }
{% endstyle %}