{%- liquid
  assign zoom_size = 'master'
  assign min_aspect_ratio = 0.6
  assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id
  assign product_form_installments_id = product_form_id | append: '-installments'
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media

  if product.template_suffix contains 'preorder'
    assign is_preorder_product = true
  else
    assign is_preorder_product = false
  endif

  for block in section.blocks
    if block.type == 'variant_picker' and block.settings.select_first_variant == false
      assign current_variant = product.selected_variant | default: false
      assign featured_media = product.featured_media
    endif
  endfor

  assign show_preorder_label = false
  if settings.prod_pre_order_label_show and is_preorder_product
    assign show_preorder_label = true
  endif

  if section.settings.enable_var_img_grouping
    assign variant_image_grouping_option_index = ''
    assign grouping_options = section.settings.var_img_grouping_option | downcase | replace: ', ', ',' | split: ','
    for option in product.options
      assign option_downcase = option | downcase
      if grouping_options contains option_downcase
        assign variant_image_grouping_option_index = forloop.index0
        break
      endif
    endfor
  endif
-%}

<div data-section-type="main-product" data-components="accordion,custom-select,modal">
  <div class="product-detail quickbuy-content section-id-{{ section.id }}">
    <div class="gallery gallery--layout-{{ section.settings.gallery_layout }} gallery--size-{{ section.settings.gallery_size }} gallery--cards-{{ section.settings.image_cards }} card-scheme-vars--{{ settings.product_card_color_scheme }} product-column-left {% if product.media.size > 1 %}has-thumbnails{% endif %}"
      {% if product.metafields.theme.card_bg != blank %}style="--bg:{{ product.metafields.theme.card_bg }}"{% endif %}
      data-cc-animate
      data-cc-animate-delay="0.2s"
      data-variant-image-grouping="{{ section.settings.enable_var_img_grouping }}"
      data-variant-image-grouping-option="{{ section.settings.var_img_grouping_option | escape }}"
      data-variant-image-grouping-option-index="{{ variant_image_grouping_option_index }}">
      <div class="gallery__inner{% if section.settings.enable_sticky_columns %} sticky-content-container{% endif %}"> 
        {%- if product.tags contains 'Black Friday'-%}
          <div class="product-label product-label--black-friday">
            <span>{{ collections['black-friday'].title }}</span>
          </div>
        {%- endif -%}
          {% comment %}
          <div class="main-image">
            {%- liquid
              for media in product.media
                if media.id == featured_media.id
                  assign initial_slide = forloop.index0
                  break
                endif
              endfor
            -%}

            <div class="slideshow product-slideshow slideshow--custom-initial" data-slick='{"adaptiveHeight":true,"initialSlide":{{initial_slide}}}'>
              {%- for media in product.media -%}
                {%- liquid
                  if forloop.index0 == initial_slide
                    assign current_is_initial = true
                  else
                    assign current_is_initial = false
                  endif
                -%}
                <div class="slide{% if current_is_initial %} slide--custom-initial{% endif %}" data-media-id="{{ media.id }}">
                  {%- if media.media_type == 'image' and section.settings.enable_zoom -%}<a class="show-gallery focus-inset" href="{{ media.preview_image | img_url: zoom_size }}">{%- endif -%}
                    {%- render 'media', media: media, min_aspect_ratio: min_aspect_ratio, eager: current_is_initial, class: 'card-br-oh' -%}
                  {%- if media.media_type == 'image' and section.settings.enable_zoom -%}</a>{%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            <div class="slideshow-controls">
              <div class="slideshow-controls__arrows"></div>
            </div>

            {%- assign models = product.media | where: 'media_type', 'model' -%}
            {% if models.size > 0 %}
              <script type="application/json" class="model-json">
                {{- product.media | where: 'media_type', 'model' | json -}}
              </script>
              <button
                class="view-in-space"
                data-shopify-xr
                data-shopify-model3d-id="{{ models.first.id }}"
                data-shopify-title="{{ product.title | escape }}"
                data-shopify-xr-hidden>
                {%- render 'icon-3d-badge-full-color' -%}
                <span class="view-in-space__text">{{ 'products.product.view_in_space' | t }}</span>
              </button>
            {% endif %}

            {% render 'product-label-detail', product: product, current_variant: current_variant %}
          </div>

          {% if product.media.size > 1 %}
            <cc-carousel class="cc-carousel{% unless section.settings.gallery_layout contains 'carousel' %} mobile-only{% endunless %}" allow-mouse-drag set-item-classes rebuild-on-resize>
              <div class="cc-carousel__scroll-outer">
                <div class="thumbnails cc-carousel__scroll-area">
                  {% for media in product.media %}
                    <a class="thumbnail thumbnail--media-{{ media.media_type }}" href="{% if section.settings.enable_zoom %}{{ media.preview_image | img_url: zoom_size }}{% else %}#{% endif %}" data-media-id="{{ media.id }}">
                      <div class="thumbnail__media card-br-oh-less">
                        {% render 'responsive-image', image: media.preview_image, min_aspect_ratio: min_aspect_ratio %}
                      </div>
                      {%- if media.media_type == 'video' or media.media_type =='external_video' -%}
                        <div class="thumbnail__badge">
                          {% render 'icon-video-badge-full-color' %}
                        </div>
                      {%- endif -%}
                      {%- if media.media_type == 'model' -%}
                        <div class="thumbnail__badge">
                          {% render 'icon-3d-badge-full-color' %}
                        </div>
                      {%- endif -%}
                    </a>
                  {% endfor %}
                </div>
              </div>
            </cc-carousel>
          {% endif %}
          {% endcomment %}
          <div class="prodcut__images-con">
            <div class="main-image main-product-swiper swiper">
              <div class="swiper-wrapper">
                {%- for media in product.media -%}
                  
                  <div class="swiper-slide" data-media-id="{{ media.id }}">
                    {%- if media.media_type == 'image' and section.settings.enable_zoom -%}<a class="gallery-link focus-inset" href="{{ media.preview_image | image_url: width: nil }}">{%- endif -%}
                      {{ media | image_url: width: nil | image_tag: class: 'product__image' }}
                      <div class="product__badge_zoom">{% render 'svg-zoom' %}</div>
                    {%- if media.media_type == 'image' and section.settings.enable_zoom -%}</a>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
              <div class="product-slider__nav-wrap">
                <div class="product-slider__nav prev">
                  {% render 'svg-slider-arrow' %}
                </div>
                <div class="product-slider__nav next">
                  {% render 'svg-slider-arrow' %}
                </div>
              </div>
              <div class="swiper-pagination"></div>
            </div>
            {% if product.metafields.custom.fit_type != blank %}
              <div class="product__badge_fit-type">{{ product.metafields.custom.fit_type }}</div>
            {% endif %}
            {% for block in section.blocks %}
              {% if block.type == 'model_size' %}
                {%- comment -%}
                  Model size per variant: the badge shows the value of the chosen
                  variant (custom.model_size on the variant) and falls back to the
                  value of the block setting (the product field).
                {%- endcomment -%}
                {%- liquid
                  assign model_size_per_variant = false
                  for variant in product.variants
                    if variant.metafields.custom.model_size.value != blank
                      assign model_size_per_variant = true
                      break
                    endif
                  endfor
                  assign model_size_current = current_variant.metafields.custom.model_size.value
                -%}
                {% if block.settings.conditional_render != blank or model_size_per_variant %}
                  <div class="product__badge_model-size" {{ block.shopify_attributes }} data-label="{{ block.settings.label }}" data-product-value="{{ block.settings.value }}" data-value="{% if model_size_current != blank %}{{ model_size_current | escape }}{% else %}{{ block.settings.value }}{% endif %}"{% if model_size_current == blank and block.settings.conditional_render == blank %} style="display:none"{% endif %}>
                    {%- if model_size_per_variant -%}
                      <script type="application/json" class="product__badge_model-size_variants">
                        { {%- for variant in product.variants -%}"{{ variant.id }}": {{ variant.metafields.custom.model_size.value | default: '' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }
                      </script>
                    {%- endif -%}
                    <svg class="product__badge_model-size_img" width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <!-- Horizontal bar -->
                      <path class="plus-h" d="M3.95898 8.70703H15.0423V10.2904H3.95898V8.70703Z" fill="currentColor"/>
                      <!-- Vertical bar -->
                      <path class="plus-v" d="M8.70898 3.95703H10.2923V15.0404H8.70898V3.95703Z" fill="currentColor"/>
                    </svg>

                    <span>{{ block.settings.label }}</span>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
            
          <div style="display:none">
            {% for variant in product.variants %}
                {% for hotspot in variant.metafields.custom.hotspots.value %}
                  {% assign prod = hotspot.variant.value %}
                  <div>{{  prod | json }}</div>
                  {% capture variables %}
                    --posX:{{ hotspot.horizontal_position | default: '50' }}%;
                    --posY:{{ hotspot.vertical_position | default: '91' }}%;
                    --dist: {{ hotspot.distance | default: '-37' }}px;
                    --angle: {{ hotspot.angle | default: '91' }};
                    {%- if hotspot.enable_mobile_repositioning %}
                      --posX-mobile:{{ hotspot.horizontal_position_mobile | default: hotspot.horizontal_position | default: '50' }}%;
                      --posY-mobile:{{ hotspot.vertical_position_mobile | default: hotspot.vertical_position | default: '91' }}%;
                      --dist-mobile: {{ hotspot.distance_mobile | default: hotspot.distance | default: '-37' }}px;
                      --angle-mobile: {{ hotspot.angle_mobile | default: hotspot.angle | default: '91' }};
                    {%- endif -%}
                    {%- if block.settings.repos_wide %}
                      --posX-wide:{{ block.settings.h_pos_wide | default: '44' }}%;
                      --posY-wide:{{ block.settings.v_pos_wide | default: '84' }}%;
                      --dist-wide: {{ block.settings.dist_wide | default: '-26' }}px;
                      --angle-wide: {{ block.settings.angle_wide | default: '91' }};
                    {%- endif -%}
                  {% endcapture %}
                  <div class="w2024-adjustable__hotspot{% if hotspot.enable_mobile_repositioning %} mobile-repos{% endif %}{% if block.settings.repos_wide %} wide-repos{% endif %}" data-variant="{{ variant.option1 }}" data-index="{{ hotspot.slide_number | default: 3 }}" style="{{ variables }}" tabindex="-1" {{ block.shopify_attributes }}>
                    <div class="w2024-adjustable__hotspot_anchor"></div>
                    <div class="w2024-adjustable__hotspot_angle">
                      <a class="w2024-adjustable__hotspot_wrap" href="{{ prod.url }}">
                        <div class="w2024-adjustable__hotspot_img-wrap">
                          {% if prod.featured_image != blank %}
                            {{ prod.featured_image | image_url: width: 100 | image_tag: class: 'w2024-adjustable__hotspot_img' }}
                          {% else %}
                            {{ 'image' | placeholder_svg_tag: 'w2024-adjustable__hotspot_img placeholder' }}
                          {% endif %}
                        </div>
                        <div class="w2024-adjustable__hotspot_text-wrap">
                          <h4 class="w2024-adjustable__hotspot_title">{{ prod.product.title }}</h4>
                          <div class="w2024-adjustable__hotspot_text_variant">
                            <span>{{ prod.product.options.first }}:</span>
                            <span class="w2024-adjustable__hotspot_text_variant-value">{{ prod.option1 }}</span>
                          </div>
                          <p class="w2024-adjustable__hotspot_price">{{ prod.price | money }}</p>
                        </div>
                      </a>
                    </div>
                  </div>
              {% endfor %}
            {% endfor %}
          </div>
          </div>
          {% #comment %}
