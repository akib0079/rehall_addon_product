    <div class="product__zoom-gallery__controls">
    <button class="product__zoom__button--zoom" type="button" title="Zoom" aria-label="Zoom"><svg aria-hidden="true" class="pswp__icn" viewBox="0 0 32 32" width="32" height="32"><use class="pswp__icn-shadow" xlink:href="#pswp__icn-zoom"></use><path d="M17.426 19.926a6 6 0 1 1 1.5-1.5L23 22.5 21.5 24l-4.074-4.074z" id="pswp__icn-zoom"></path><path fill="currentColor" class="pswp__zoom-icn-bar-h" d="M11 16v-2h6v2z"></path><path fill="currentColor" class="pswp__zoom-icn-bar-v" d="M13 12h2v6h-2z"></path></svg></button>
    <a class="product__zoom-gallery__close" href="#">
      <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32" fill="currentColor">
        <path d="M24 10l-2-2-6 6-6-6-2 2 6 6-6 6 2 2 6-6 6 6 2-2-6-6z"></path>
      </svg>
    </a>
    </div>
  </div>
     <script type="text/javascript">
      document.addEventListener('DOMContentLoaded', () => {
        const images = [
          {%- for media in product.media -%}
          { id: 1, src: '{{ media.preview_image | image_url: width: nil }}', width: {{media.width}}, height: {{media.height}}, alt: "{{ media.alt }}" },
          {%- endfor -%}
        ];
        
        const options = document.querySelectorAll('.option-selector.option-selector--swatch .opt-btn');
        
        if (options.length) {
          const lightboxes = {};
          const matchedImages = new Set();

          // 1. Map options to get their clean, original text and lowercase names
          const colorSwatches = Array.from(options).map(swatch => {
            const label = document.querySelector(`.opt-label[for="${swatch.id}"]`);
            const originalName = label ? label.innerText.trim() : '';
            return {
              originalName: originalName,
              lowerName: originalName.toLowerCase()
            };
          });

          // 2. Sort descending by length (longest color name matches first)
          colorSwatches.sort((a, b) => b.lowerName.length - a.lowerName.length);

          // 3. Process each color option in sorted order
          colorSwatches.forEach(({ originalName, lowerName }) => {
            if (!lowerName) return;

            // Filter images based on case-insensitive "ends with" match and uniqueness
            const varImages = images.filter(img => {
              if (!img.alt) return false;
              
              const altText = img.alt.trim().toLowerCase();
              const matchesColor = altText.endsWith(lowerName);
              const isUnclaimed = !matchedImages.has(img);

              if (matchesColor && isUnclaimed) {
                matchedImages.add(img);
                return true;
              }
              return false;
            });

            // Initialize PhotoSwipe for this specific swatch variation
            lightboxes[originalName] = new PhotoSwipeLightbox({
              dataSource: varImages,
              showHideAnimationType: 'fade',
              pswpModule: PhotoSwipe 
            });
            lightboxes[originalName].init();

            // Bind click events using attribute ends-with (\$=) case-insensitively
            // Escapes double quotes if the color name contains any
            const escapedName = originalName.replace(/"/g, '\\"');
            const querySelectorStr = `.main-product-swiper[data-swatch-anchor$="${escapedName}" i] .swiper-slide .gallery-link`;
            
            document.querySelectorAll(querySelectorStr).forEach((slide, i) => {
              slide.addEventListener('click', e => {
                e.preventDefault();
                lightboxes[originalName].loadAndOpen(i); 
              });
            });
          });

        } else {
          // Fallback when no swatch choices exist
          const lightbox = new PhotoSwipeLightbox({
            dataSource: images,
            showHideAnimationType: 'fade',
            pswpModule: PhotoSwipe 
          });
          lightbox.init();

          document.querySelectorAll('.main-product-swiper .swiper-slide .gallery-link').forEach((slide, i) => {
            slide.addEventListener('click', e => {
              e.preventDefault();
              lightbox.loadAndOpen(i); 
            });
          });
        }
      });

    </script>
