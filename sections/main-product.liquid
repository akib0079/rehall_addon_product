                    navigation: {
                      nextEl: swiperEle.querySelector('.product-slider__nav.next'),
                      prevEl: swiperEle.querySelector('.product-slider__nav.prev'),
                    },
                    pagination: {
                      el: swiperEle.querySelector('.swiper-pagination'),
                      clickable: true,
                      dynamicBullets: true,
                      dynamicMainBullets: 3
                    },
                    breakpoints: {
                      768: {
                        slidesPerGroup: 2,
                        pagination: {
                          dynamicBullets: false,
                          el: swiperEle.querySelector('.swiper-pagination'),
                          clickable: true,
                          // dynamicMainBullets: 5
                        },
                        // slidesPerGroupSkip: 2,
                      },
                    },
                  });
                } 
              }
            })
            window.addEventListener('resize', () => {
              document.querySelector('.prodcut__images-con').style.setProperty('--height', container.querySelector('.main-product-swiper.active').scrollHeight + 'px')
            });
