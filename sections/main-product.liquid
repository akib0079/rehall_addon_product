            const container = document.querySelector('.prodcut__images-con');
            const mainSwiper = container.querySelector('.main-product-swiper')
            var gallerySwiper = null
            const options = document.querySelectorAll('.option-selector.option-selector--swatch .opt-btn');
            if(options.length == 0){
              mainSwiper.classList.add('active')
              document.querySelector('.prodcut__images-con').style.setProperty('--height', mainSwiper.scrollHeight + 'px')
