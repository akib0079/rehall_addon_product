      </div>
    
      <div class="product-main__tabs-wrap">
      <div class="product-main__tabs-header swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'tab_description'
              or block.type == 'tab_properties' 
              or block.type == 'tab_reviews' %}
              <div class="swiper-slide">
                <a class="product-main__tabs-hedader-link" href="#" data-id="{{ block.id }}">
                  {{ block.settings.label }}
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% capture arrow %}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8.83333 12.375L13 8L8.83333 3.625M13 8L3 8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {% endcapture %}
        {% for block in section.blocks %}
          {% if block.type == 'tab_description' %}
            <div class="product-main__tab tab-desc{% if block.settings.inject %} arrow-injected{% endif %}" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.label }}</h4>
              <div class="product-main__tab-desc-text">
                {%liquid
                  assign desc = block.settings.desc
                  if block.settings.inject
                    assign appendedArrow = arrow | prepend: '<li>' | append: '<span>'
                    assign desc = desc | replace: '<li>', appendedArrow | replace: '</li>','</span></li>'
                  endif
                %}
                {{ desc }}
              </div>
            </div>
          {% elsif block.type == 'tab_properties' %}
              {% capture items %}
                {%- liquid
                  # Warmte (DEED, sept 2026)
                  # Vullingsgewicht gevuld: altijd tonen (balk via snippet warmth-bar-grams).
                  # Vullingsgewicht leeg: tonen met standaardwaarde (20 gram uit de snippet),
                  # behalve bij producten in de collecties uit "Warmte verbergen bij collecties".
                  assign curr_value = block.settings.warmth | downcase
                  assign warmth_grams = product.metafields.custom.specifications_padding_weight.value
                  if warmth_grams == blank
                    assign curr_value = 'warm'
                    for hide_col in block.settings.warmth_hide_collections
                      for product_col in product.collections
                        if product_col.id == hide_col.id
                          assign curr_value = ''
                          break
                        endif
                      endfor
                      if curr_value == blank
                        break
                      endif
                    endfor
                  endif
                -%}
                {% if curr_value != blank %}
                  <div class="product-main__tab-prop">
                    <div class="product-main__tab-prop-heading">
                      {% if block.settings.warmth_logo != blank %}
                        {{ block.settings.warmth_logo | image_url: width: nil | image_tag: class: 'product-main__tab-prop-img' }}
                      {% endif %}
                      <span>{{ block.settings.warmth_label }}</span>
                    </div>
                    {% assign values = block.settings.warmth_values | downcase | split: '|' %}
                    {% assign value_size = values | size | plus: 0.0 %}
                    {% assign active_index = 0  %}
                    {% assign active_index = values | find_index: curr_value | plus: 1.0 %}
                    <div class="product-main__tab-prop-value-wrap" data-value="{{curr_value }}">
                      <div class="product-main__tab-prop-value" role="progressbar" aria-label="{{curr_value}}" style="--width: {{ active_index | divided_by: value_size | times: 100 | round: 2 }}%">
                      </div>
                    </div>
                    <div class="product-main__tab-prop-label-wrap">
                        {% for value in values %}
                          <div class="product-main__tab-prop-label">
                            {{ value }}
                          </div>
                        {% endfor %}
                    </div>
                  </div>
                {% endif %}
                  {% assign curr_value = block.settings.breathability | downcase  %}
                  {% if curr_value != blank or request.design_mode %}
                  <div class="product-main__tab-prop">
                    <div class="product-main__tab-prop-heading">
                      {% if block.settings.breathability_logo != blank %}
                        {{ block.settings.breathability_logo | image_url: width: nil | image_tag: class: 'product-main__tab-prop-img' }}
                      {% endif %}
                      <span>{{ block.settings.breathability_label }}</span>
                    </div>
                    {% assign values = block.settings.breathability_values | downcase | split: '|' %}
                    {% assign cap = block.settings.breathability_value_cap | plus: 0.0  %}
                    {% assign value = block.settings.breathability | plus: 0.0  %}
                    <div class="product-main__tab-prop-value-wrap">
                      <div class="product-main__tab-prop-value" role="progressbar" aria-label="{{curr_value}}" style="--width: {{ value | at_most: cap | divided_by: cap | times: 100 | round: 2 }}%">
                      </div>
                    </div>
                    <div class="product-main__tab-prop-label-wrap">
                      {% for value in values %}
                        <div class="product-main__tab-prop-label">
                          {{ value }}
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                  {% endif %}
                    {% assign curr_value = block.settings.waterproofing | downcase %}
                  {% if curr_value != blank or request.design_mode %}
                    <div class="product-main__tab-prop">
                      <div class="product-main__tab-prop-heading">
                        {% if block.settings.waterproofing_logo != blank %}
                          {{ block.settings.waterproofing_logo | image_url: width: nil | image_tag: class: 'product-main__tab-prop-img' }}
                        {% endif %}
                        <span>{{ block.settings.waterproofing_label }}</span>
                      </div>
                      {% assign values = block.settings.waterproofing_values | downcase | split: '|' %}
                      {% assign cap = block.settings.waterproofing_value_cap | plus: 0.0  %}
                      {% assign value = block.settings.waterproofing | plus: 0.0  %}
                      <div class="product-main__tab-prop-value-wrap">
                        <div class="product-main__tab-prop-value" role="progressbar" aria-label="{{curr_value}}" style="--width: {{ value | at_most: cap | divided_by: cap | times: 100 | round: 2 }}%">
                        </div>
                      </div>
                      <div class="product-main__tab-prop-label-wrap">
                        {% for value in values %}
                          <div class="product-main__tab-prop-label">
                            {{ value }}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                    {% endif %}
              {% endcapture %}
              {% if items contains 'product-main__tab-prop' %}
                <div class="product-main__tab tab-props" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.label }}</h4>
                  <div class="product-main__tab-props-wrap">
                    {{ items }}
                  </div>
                </div>
              {% endif %}
          {% elsif block.type == 'tab_details' %}
            {% capture details_html %}
            <div class="product-main__tab tab-details" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.label }}</h4>
              <div class="product-main__tab-details-text">
                {% liquid
                  assign desc = block.settings.details
                  assign items = desc | split: '<li' 
                  for item in items
                      if item contains '|'
                          assign first_char = item | strip | slice: 0, 1
                          if first_char == '>'
                            assign content = item | remove_first: '>' | split: '</li>' | first
                          else 
                              assign content = item | split: '">' | last | split: '</li>' | first 
                          endif
                          assign parts = content | split: '|'
                          assign value = parts[1] | strip
                          if value contains '[['
                          capture value
                          render 'details-metafield-value', product: product, token: value
                          endcapture
                          assign value = value | strip
                          endif
                          if value == blank
                            assign r_item = item | prepend: '<li' | split: '</li>' | first | append: '</li>'
                            assign desc = desc | remove_first: r_item
                            #echo r_item | escape | prepend: "<pre>" | append: "</pre>"
                          else
                            assign value = value | prepend: '<span class="text">' | append: '</span>'
                            assign new_content = parts[0] | strip | prepend: '<span class="heading">' | append: '</span>' | append: value
                            assign new_item = item | replace: content, new_content
                            #echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                            #if parts[1] == blank 
                            #echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                            assign desc = desc | replace: item, new_item
                          endif
                      endif 
                  endfor
                %}
                {{ desc }}
              </div>
                <div class="product-main__details-more-wrap">
                  <a href="#" class="product-main__details-more">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 4L8 12M12 8L4 8" stroke="black" stroke-linecap="round"/>
                    </svg>
                    <span>{{ block.settings.more }}</span>
                  </a>
                </div>
            </div>
            <script>
              document.querySelectorAll('.product-main__tab.tab-details').forEach(details => {
                const link = details.querySelector('.product-main__details-more');
                const limiter = details.querySelector('li:nth-child(11)')
                if(link && limiter){
                  const distance = details.querySelector('li:nth-child(5)').getBoundingClientRect().top - details.querySelector('.product-main__tab-details-text').getBoundingClientRect().top;
                  details.style.setProperty('--height', distance+'px')
                  link.addEventListener('click', e => {
                    e.preventDefault();
                    details.classList.add('expanded');
                  })
                } else {
                  link?.remove();
                }
              })
            </script>
            {% endcapture %}
            {% liquid
              assign details_check = desc | strip_html | strip
              if desc contains '<li' and details_check != blank
                echo details_html
              endif
            %}
          {% elsif block.type == 'tab_reviews' %}
            <div class="product-main__tab tab-reviews" data-id="{{ block.id }}" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.label }}</h4>
              <div class="product-main__tab_review-heading">
                <span class="product-main__tab_review-main">4.5</span>
                <span class="product-main__tab_review-stars"></span>
                <span class="product-main__tab_review-text">{{ block.settings.review_text | highlight: '$' }}</span>
              </div>
              <div class="product-main__tab_review-items">
              </div>
              <a href="#" class="product-main__tab_review-button">
                <span class="product-main__tab_review-button-text">
                  <span>{{ block.settings.button_more_text }}</span>
                  <span>{{ block.settings.button_less_text }}</span>
                </span>
              </a>
            </div>
            <script>
              const id = {{product.id}};
              {% comment %} alert("data") {% endcomment %}
              const review_url = `https://api.judge.me/api/v1/widgets/product_review?api_token=S8ACeVY_MYKAi3auL-smrgiJ8sE&shop_domain=rehallcom.myshopify.com&page=1&per_page=20&external_id=${id}`;
              const wrap = document.querySelector('.product-main__tab.tab-reviews');
              fetch(review_url)
              .then((res) => {
                return res.json();
              })
              .then(data => {
                
                const parser = new DOMParser();
                const doc = parser.parseFromString(data.widget, 'text/html');
                const widget = doc.querySelector('.jdgm-rev-widg');
                if(parseFloat(widget.dataset.averageRating) < 3.00){
                  wrap.remove();
                  document.querySelector(".product-detail")?.classList.add('hide-reviews');
                  const header = document.querySelector(`.product-main__tabs-hedader-link[data-id=${wrap.dataset.id}]`);
                  if(header){
                    header.closest('.swiper-slide').remove();
                    if(window.headerSlider){
                      window.headerSlider.update();
                    }
                    return;
                  }
                }
                wrap.querySelector('.product-main__tab_review-main').innerText = parseFloat(widget.dataset.averageRating).toFixed(1);
                wrap.querySelector('.product-main__tab_review-stars').innerHTML = widget.querySelector('.jdgm-rev-widg__summary-stars').innerHTML;
                wrap.querySelector('.product-main__tab_review-text').innerText = widget.querySelector('.jdgm-rev-widg__summary-text').innerText
                {% comment %} wrap.querySelector('.product-main__tab_review-items').innerHTML = data.widget; {% endcomment %}
                let html = '';
                widget.querySelectorAll('.jdgm-rev').forEach(rev => {
                  const utcString = rev.querySelector('.jdgm-rev__timestamp').dataset.content;

                  // Format string to ISO 8601: "2025-12-15T13:28:34Z"
                  const isoString = utcString.replace(" ", "T").replace(" UTC", "Z");
                  const date = new Date(isoString);

                  // Extract UTC parts safely
                  const day = String(date.getUTCDate()).padStart(2, '0');
                  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
                  const year = date.getUTCFullYear();

                  const formattedDate = `${day}/${month}/${year}`;

                  html+=`<div class="product-main__tab_review-single">
                  ${rev.querySelector('.jdgm-rev__rating').outerHTML}
                  <div class="jdgm-rev__body-wrap">
                    ${rev.querySelector('.jdgm-rev__body').outerHTML}
                  </div>
                  ${rev.querySelector('.jdgm-rev__pic-link') ? rev.querySelector('.jdgm-rev__pic-link').outerHTML  : ''}
                  <div class="product-main__tab_review-single_footer">
                    ${rev.querySelector('.jdgm-rev__author-wrapper')?.outerHTML}
                      <div class="jdgm-rev__date">${formattedDate}</div>
                  </div>
                  </div>`
                })
                wrap.querySelector('.product-main__tab_review-items').innerHTML = html;
                wrap.querySelectorAll('.jdgm-rev__pic-link').forEach(ele => {
                  ele.classList.remove('jdgm--loading')
                  const img = ele.querySelector('.jdgm-rev__pic-img');
                  img.src= img.dataset.src;
                })
                wrap.querySelectorAll('.jdgm-rev__body-wrap').forEach(ele => {
                  const eleBody = ele.querySelector('.jdgm-rev__body');
                  const maxHeight = parseFloat(window.getComputedStyle(eleBody).lineHeight) * 8;
                  if(maxHeight < ele.scrollHeight){
                    ele.classList.add('expandible');
                    ele.insertAdjacentHTML('beforeend', '<a href="#" class="jdgm-rev__body-expander">{{ block.settings.item_more_text }}</a>');
                    ele.querySelector('.jdgm-rev__body-expander').addEventListener('click', e => {
                      e.preventDefault();
                      ele.classList.toggle('expanded')
                    })
                  }
                  ele.style.setProperty('--max-height',maxHeight + 'px');
                })
                let limiter = 3;
                if (window.matchMedia("(max-width: 767px)").matches) limiter = 2
                if(wrap.querySelector(`.product-main__tab_review-items .product-main__tab_review-single:nth-child(${limiter})`)){
                  wrap.querySelector('.product-main__tab_review-items').style.setProperty('--item-height', wrap.querySelector('.product-main__tab_review-single').scrollHeight + 'px');
                  wrap.querySelector('.product-main__tab_review-button').addEventListener('click', e => {
                    e.preventDefault();
                    wrap.classList.toggle('expanded')
                  })
                } else {
                  wrap.querySelector('.product-main__tab_review-button').remove();
                }
              })
            </script>
          {% endif %}
        {% endfor %}
      </div>
      <script>
          {% comment %} const id = {{product.id}}; {% endcomment %}
          const wizurl = `https://api.judge.me/api/v1/widgets/preview_badge?api_token=S8ACeVY_MYKAi3auL-smrgiJ8sE&shop_domain=rehallcom.myshopify.com&external_id=${id}`;
          fetch(wizurl)
          .then((res) => {
            return res.json();
          })
          .then(data => {
            const parser = new DOMParser();

            // 2. Parse the string into an HTML document
            const doc = parser.parseFromString(data.badge, 'text/html');
            const badge = doc.querySelector('.jdgm-prev-badge')
            if(badge.dataset.averageRating && badge.dataset.averageRating != '0.00'){
              document.querySelector('.product-column-right .title-row').after(badge)
            }
          })
      </script>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const mobile = window.matchMedia('(max-width: 767px)');
          document.querySelectorAll('.product-main__tabs-hedader-link').forEach(link => {
            const block = document.querySelector(`.product-main__tab[data-id=${link.dataset.id}]`);
            if(!block){
              link.closest('.swiper-slide').remove();
              return;
            }
          })
          window.headerSlider = new Swiper('.product-main__tabs-header', {
            slidesPerView: 'auto'
          })

          gsap.registerPlugin(ScrollToPlugin, ScrollTrigger) ;
          ScrollTrigger.config({ ignoreMobileResize: true }) 
          document.querySelectorAll('.product-main__tabs-hedader-link').forEach(link => {
            const block = document.querySelector(`.product-main__tab[data-id=${link.dataset.id}]`);
            const slideEl = link.closest('.swiper-slide');
            const slideIndex = window.headerSlider.slides.indexOf(slideEl) - 1;
            if(!block){
              link.closest('.swiper-slide').remove();
              return;
            }
            ScrollTrigger.create({
              trigger: block,
              start: "top center",
              end: "bottom center",
              onEnter: (self) => {
                document.querySelector('.product-main__tabs-hedader-link.active')?.classList.remove('active');
                link.classList.add('active');
                if(slideIndex){
                  window.headerSlider.slideTo(slideIndex);
                }
              },
              onEnterBack: (self) => {
                document.querySelector('.product-main__tabs-hedader-link.active')?.classList.remove('active');
                link.classList.add('active');
                if(slideIndex){
                  window.headerSlider.slideTo(slideIndex);
                }
              },
            });
            link.addEventListener('click', e => {
              e.preventDefault();
              gsap.to(window, {
                scrollTo: { y: block, offsetY: (mobile.matches ? 205 :162), autoKill: false },
              });
              
            })
          })
          const reviewTab = document.querySelector('.product-main__tab.tab-reviews');
          if(reviewTab)
          document.querySelectorAll('.jdgm-prev-badge').forEach(badge => {
            badge.addEventListener('click', e => {
              e.preventDefault();
              gsap.to(window, {
                scrollTo: { y: reviewTab, offsetY: (mobile.matches ? 205 :162), autoKill: false },
              });
              
            })
          })
        })
      </script>
    </div>

    <div class="detail product-column-right" data-cc-animate data-cc-animate-delay="0.2s">
      <div class="product-form off-card-container{% if section.settings.enable_sticky_columns %} sticky-content-container{% endif %}" data-ajax-add-to-cart="true" data-product-id="{{ product.id }}" data-enable-history-state="true">
        {%- assign product_form_present = false -%}
        {%- capture original_select -%}
          <select name="id" class="original-selector{% if product.variants.size == 1 %} hidden{% endif %}" aria-label="{{ 'products.product.selector_label' | t | escape }}">
            {% if product.variants.size > 1 %}<option value="">{{ 'products.product.no_selection' | t }}</option>{% endif %}
            {% for variant in product.variants %}
            <option value="{{ variant.id }}"
              {% if variant == current_variant %} selected="selected"{% endif %}
              {% if section.settings.inventory_transfers_enable and variant.incoming %}
                {%- if variant.next_incoming_date -%}
                  {%- assign date = variant.next_incoming_date | date: format: 'date' -%}
                  {%- if variant.available -%}
                    data-inventory-transfer="{{ 'products.transfers.will_not_ship_until' | t: date: date | escape }}"
                  {%- else -%}
                    data-inventory-transfer="{{ 'products.transfers.will_be_in_stock_after' | t: date: date | escape }}"
                  {%- endif -%}
                {%- else -%}
                  data-inventory-transfer="{{ 'products.transfers.waiting_for_stock' | t | escape }}"
                {%- endif -%}
              {% endif %}
              {% if variant.metafields.theme.card_bg != blank %} data-card-bg="{{ variant.metafields.theme.card_bg }}"{% endif %}
              data-stock="{% if variant.inventory_management != blank and variant.inventory_quantity <= 0 %}out{% endif %}">{{ variant.title | escape }}</option>
            {% endfor %}
          </select>
        {%- endcapture -%}

        {% render 'breadcrumbs' %}

        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              <div class="{% unless settings.qb_show_app_blocks %}not-in-quickbuy{% endunless %}">
                {% render block %}
              </div>

            {% when 'title' %}
              <div class="title-row" {{ block.shopify_attributes }}>
                <h1 class="title">{{ product.title }}</h1>
              </div>
            {% when 'fit_type' %}
              {% if block.settings.text != blank or block.settings.default != blank %}
              <div class="product__fit-type" {{ block.shopify_attributes }}>
                <p class="product__fit-type_notice"><span class="product__fit-type_prefix">{{block.settings.prefix}}</span> {{ block.settings.text | default: block.settings.default }}</p>
              </div>
              {% endif %}
            {%  when 'usp_list' %}
              <div class="product-alt__usp-list" {{ block.shopify_attributes }}>
                {% capture icon %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="17" viewBox="0 0 16 17" fill="none">
                    <path d="M2.66536 8.50033C2.66536 5.37071 5.05318 2.83366 7.9987 2.83366C10.9442 2.83366 13.332 5.37071 13.332 8.50033C13.332 11.63 10.9442 14.167 7.9987 14.167C5.05318 14.167 2.66536 11.63 2.66536 8.50033ZM7.9987 1.41699C4.3168 1.41699 1.33203 4.58831 1.33203 8.50033C1.33203 12.4123 4.3168 15.5837 7.9987 15.5837C11.6806 15.5837 14.6654 12.4123 14.6654 8.50033C14.6654 4.58831 11.6806 1.41699 7.9987 1.41699ZM11.6368 6.69911L10.694 5.69737L7.33203 9.26943L5.47011 7.29113L4.52729 8.29285L7.33203 11.2729L11.6368 6.69911Z" fill="#4A4A4A"/>
                  </svg>
                {% endcapture %}
                {%liquid
                  if block.settings.list != blank
                    assign list = block.settings.list
                    assign iconText = icon | prepend: '<li>' | append: '<span>'
                    echo list | replace: '<li>', iconText | replace: '</li>', '</span></li>'
                  endif
                %}
              </div>
            {%  when 'fitting' %}
              <div class="product-alt__fitting-block{% if request.design_mode %} active{% endif %}" {{ block.shopify_attributes }}>
                <div class="product-alt__fitting_size-wrap">
                  {% if block.settings.size_logo != blank %}
                    {{ block.settings.size_logo | image_url: width: nil | image_tag: class: "product-alt__fitting_size-img" }}
                  {% endif %}
                  <div class="product-alt__fitting_size-text">
                    {{ block.settings.size_text }}
                  </div>
                </div>
              </div>
            {% when 'popup_info' %}
              {% if block.settings.desc != blank or request.design_mode %}
                <div class="product-alt__desc-wrap product-alt__popup" {{ block.shopify_attributes }}>
                    {% if block.settings.title != blank %}
                        <a href="#" class="product-alt__desc-title product-alt__popup-anchor" data-id="{{ block.id }}">
                            <span>{{ block.settings.title }}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9.99997 4C9.99997 4 6 6.94593 6 8C6 9.05413 10 12 10 12" stroke="currentColor" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                    {% endif %}
                  </div>
                {% endif %}
            {% when 'price' %}
              <div class="price-container" {{ block.shopify_attributes }}>
                <div class="variant-visibility-area">
                  {%- for variant in product.variants -%}
                    <script type="text/template" data-variant-id="{{ variant.id }}">
                      {%- capture price_html -%}
                        <div class="price-area">
                          <div class="price h4-style {% if variant.compare_at_price > variant.price %}on-sale{% endif %}">
                            <span class="current-price theme-money">
                              {%- if settings.product_currency_code_enabled -%}
                                {{- variant.price | money_with_currency -}}
                              {%- else -%}
                                {{- variant.price | money -}}
                              {%- endif -%}
                            </span>
                            {% if variant.compare_at_price > variant.price %}
                            <span class="was-price theme-money">{{ variant.compare_at_price | money }}</span>
                            {% endif %}
                          </div>

                          {% render 'unit-price', variant: variant %}
                        </div>
                      {%- endcapture -%}
                      {{- price_html -}}
                    </script>
                    {%- if current_variant and current_variant.id == variant.id -%}{{ price_html }}{%- endif -%}
                  {%- endfor -%}

                  <script type="text/template" data-variant-id="">
                    {%- capture price_html -%}
                      <div class="price-area">
                        {%- assign cheapest_variant = product.variants | sort: 'price' | first -%}
                        <div class="price h4-style {% if cheapest_variant.compare_at_price > cheapest_variant.price %}on-sale{% endif %}">
                          {% if product.price_varies %}
                            <span class="price__from">{{ 'products.listing.from' | t }}</span>
                          {% endif %}
                          <span class="current-price theme-money">
                            {%- if settings.product_currency_code_enabled -%}
                              {{ cheapest_variant.price | money_with_currency }}
                            {%- else -%}
                              {{ cheapest_variant.price | money }}
                            {%- endif -%}
                          </span>
                          {% if cheapest_variant.compare_at_price > cheapest_variant.price %}
                            <span class="was-price theme-money">{{ cheapest_variant.compare_at_price | money }}</span>
                          {% endif %}

                          {% render 'unit-price', variant: cheapest_variant %}
                        </div>
                      </div>
                    {%- endcapture -%}
                    {{- price_html -}}
                  </script>

                  {% if current_variant == false %}
                    {{- price_html -}}
                  {% endif %}
                </div>

                <div class="price-descriptors">
                  {%- form 'product', product, id: product_form_installments_id -%}
                    <input type="hidden" name="id" value="{% if current_variant %}{{ current_variant.id }}{% endif %}">
                    {{ form | payment_terms }}
                  {%- endform -%}

                  {%- if block.settings.show_tax_and_shipping -%}
                    {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                      <div class="product-policies">
                        {%- if cart.taxes_included -%}
                          {{ 'products.product.include_taxes' | t }}
                        {%- endif -%}
                        {%- if shop.shipping_policy.body != blank -%}
                          {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                  {% if section.settings.inventory_transfers_enable %}
                    <div class="product-inventory-transfer {% unless current_variant.incoming %}product-inventory-transfer--none{% endunless %}">
                      {%- if current_variant.incoming -%}
                        {%- if current_variant.next_incoming_date -%}
                          {%- assign date = current_variant.next_incoming_date | date: format: 'date' -%}
                          {%- if current_variant.available -%}
                            {{ 'products.transfers.will_not_ship_until' | t: date: date }}
                          {%- else -%}
                            {{ 'products.transfers.will_be_in_stock_after' | t: date: date }}
                          {%- endif -%}
                        {%- else -%}
                          {{ 'products.transfers.waiting_for_stock' | t }}
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  {% endif %}
                </div>
              
                
                {% comment %}
                {%- if block.settings.enable_product_reviews_by_price and product.metafields.reviews.rating_count != blank -%}
                  {%- assign rating_count = product.metafields.reviews.rating_count | plus: 0 -%}
                  {%- if rating_count > 0 -%}
                    <div class="theme-product-reviews">
                      {% render 'rating', rating_value: product.metafields.reviews.rating.value %}
                      <span class="cc-rating-custom-caption">
                        {{ rating_count }} {{ 'products.product.reviews_link' | t: count: rating_count }}
                      </span>
                    </div>
                  {%- endif -%}
                {%- endif -%}
                {% endcomment %}
              </div>

            {% when 'description' %}
              <div class="{% unless block.settings.show_in_quickbuy %}not-in-quickbuy{% endunless %}{% if block.settings.show_in_tab %} detail-accordion{% endif %}">
                {% if block.settings.show_in_tab %}
                  {% comment %}
                  {%- capture accordion_title -%}
                    {%- if block.settings.icon == blank -%}
                      {{- 'products.product.description' | t | escape -}}
                    {%- else -%}
                      <div class="with-icon">
                        {% render 'icon', icon: block.settings.icon, size: 'small' %}
                        <span class="with-icon__beside">{{ 'products.product.description' | t | escape }}</span>
                      </div>
                    {%- endif -%}
                  {%- endcapture -%}
                  {% endcomment %}
                {% capture accordion_content %}
                  {%- for block in section.blocks -%}
                    {% if block.type == 'description' %}
                      <div class="collapsible-tabs__block" {{ block.shopify_attributes }}>
                      {%- capture accordion_title -%}
                          {%- if block.settings.icon == blank -%}
                            {{- 'products.product.description' | t | escape -}}
                          {%- else -%}
                            <div class="with-icon">
                              {% render 'icon', icon: block.settings.icon, size: 'small' %}
                              <span class="with-icon__beside">{{ 'products.product.description' | t | escape }}</span>
                            </div>
                          {%- endif -%}
                        {%- endcapture -%}
            
                          <div class="collapsible-tabs__tab">
                            {% render 'accordion-item',
                                title: accordion_title,
                                escape_title: true,
                                content: product.description,
                                add_content_class: 'rte',
                                item_open: true
                            %}
                          </div>
                      </div>
                    {%- endif -%}
                    {% if block.type == 'accordion' %}
                      {%- liquid
                          assign content = block.settings.content
                          if block.settings.page != blank
                            assign content = pages[block.settings.page].content
                          endif
                        -%}
                      {%- if content != blank -%}
                      <div class="collapsible-tabs__block" {{ block.shopify_attributes }}>
                      {%- capture accordion_title -%}
                          {%- if block.settings.icon == blank -%}
                            {{- block.settings.title | escape -}}
                          {%- else -%}
                            <div class="with-icon">
                              {% render 'icon', icon: block.settings.icon, size: 'small' %}
                              <span class="with-icon__beside">{{ block.settings.title | escape }}</span>
                            </div>
                          {%- endif -%}
                        {%- endcapture -%}
            
                          <div class="collapsible-tabs__tab">
                            {% render 'accordion-item',
                                title: accordion_title,
                                escape_title: true,
                                content: content,
                                add_content_class: 'rte'
                            %}
                          </div>
                      </div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {% endcapture %}
                {%
                  render "accordion",
                    allow_multi_open: false,
                    content: accordion_content
                %}
                {% else %}
                  <div class="product-description spaced-text-row rte cf">
                    {%- if block.settings.icon == blank -%}
                      {{- product.description -}}
                    {%- else -%}
                      <div class="with-icon">
                        {% render 'icon', icon: block.settings.icon, size: 'small' %}
                        <span class="with-icon__beside">{{ product.description }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                {% endif %}
              </div>

            {% when 'vendor' %}
              {%- liquid
                assign product_vendor_handle = product.vendor | handle
                if collections[product_vendor_handle].handle == product_vendor_handle
                  assign vendor_url = collections[product_vendor_handle].url
                else
                  assign vendor_url = product.vendor | url_for_vendor
                endif
              -%}
              <div class="vendor lightly-spaced-row" {{ block.shopify_attributes }}>
                <span class="product-detail-label">{{ 'products.product.vendor' | t }}</span> {{ product.vendor | link_to: vendor_url, class: 'underline' }}
              </div>

            {% when 'sku' %}
              <div class="sku {% if current_variant and current_variant.sku == blank %}sku--no-sku{% endif %}" {{ block.shopify_attributes }}>
                <span class="product-detail-label">{{ 'products.product.sku' | t }}</span> <span class="sku__value">{% if current_variant %}{{ current_variant.sku }}{% endif %}</span>
              </div>

            {% when 'variant_picker' %}
              <div class="input-row" {{ block.shopify_attributes }}>
                {% render 'variant-picker', section: section, product: product, block: block %}
              </div>

            {% when 'buy_buttons' %}
              {%- assign product_form_present = true -%}
              <div class="buy-buttons-row" {{ block.shopify_attributes }}>
                
                {% form 'product', product, id: product_form_id, class: 'form product-purchase-form', data-product-id: product.id %}
                  {{- original_select -}}
                  {%# if product.metafields.custom.available_world_of_alps == blank %}
                    {% if block.settings.show_custom_link %}
                      <a href="{{ block.settings.custom_link_url | default: '#' }}">
                      <button class="button button--large">
                        {{- block.settings.custom_link_text -}}
                      </button>
                      </a>
                    {% else %}
                      {% if true or product.available %}
    
                        {%- liquid
                          assign gift_card_recipient_feature_active = false
                          if block.settings.show_gift_card_recipient and product.gift_card?
                            assign gift_card_recipient_feature_active = true
                          endif
    
                          assign enable_dynamic_payment_button = false
                          if block.settings.enable_payment_button and product.selling_plan_groups == empty and is_preorder_product == false and gift_card_recipient_feature_active == false
                            assign enable_dynamic_payment_button = true
                          endif
                        -%}
    
                        <div class="quantity-submit-row input-row {% if enable_dynamic_payment_button %}has-spb{% endif %}">
                          {% if block.settings.show_quantity_selector %}
                            <label class="label" for="quantity">{{ 'products.product.quantity' | t }}</label>
                            <div class="quantity-wrapper">
                              <a href="#" data-quantity="down">{% render 'svg-minus' %}</a>
                              <input aria-label="{{ 'products.product.quantity' | t }}" type="number" id="quantity" name="quantity" value="1" />
                              <a href="#" data-quantity="up">{% render 'svg-plus' %}</a>
                            </div>
                          {% endif %}
    
                          {% if gift_card_recipient_feature_active %}
                            {% render 'gift-card-recipient', product: product, form: form, checkbox_class: 'checkbox' %}
                          {% endif %}
    
                          <div class="quantity-submit-row__submit input-row">
                            {%- capture add_to_cart_text -%}
                              {%- if is_preorder_product -%}
                                {{- 'products.product.preorder' | t -}}
                              {%- else -%}
                                {{- 'products.product.add_to_cart' | t -}}
                              {%- endif -%}
                            {%- endcapture -%}
                            <button class="button button--large" type="submit" data-add-to-cart-text="{{ add_to_cart_text | escape }}">
                              {{- add_to_cart_text -}}
                            </button>
                          </div>
    
                          {% if enable_dynamic_payment_button %}
                            <script class="dynamic-payment-button-template" type="text/template">
                              {{ form | payment_button }}
                            </script>
                          {% endif %}
    
                          {% if block.settings.show_backorder_text == true %}
                            {% render 'backorder', product: product, variant: current_variant, location: 'product' %}
                          {% endif %}
                        </div>
    
                        {%- unless block.settings.show_pickup_availability == false -%}
                          {% render 'store-availability', product: product, current_variant: current_variant %}
                        {%- endunless -%}
    
                      {% else %}
                        <div class="product-unavailable">{{ 'products.product.product_unavailable' | t }}</div>
                      {% endif %}
                    {% endif %}
                    {% comment %}
                    <a class="button button--large redirect__woa-404" href="https://worldofalps.com/404" target="_blank">
                      {{- block.settings.custom_link_text -}}
                    </a>
                  {%# else %}
                    <a class="button button--large redirect__woa-btn" href="https://worldofalps.com/search?q={{ current_variant.sku }}" target="_blank">
                      {{- block.settings.custom_link_text -}}
                    </a>
                    {% endcomment %}
                {% endform %}
                    {% comment %}
                <a class="redirect-text-wrap" href="{{ block.settings.redirect_url | default: "#" }}" target="_blank">
                  {% render 'svg-info-circle' %}
                  <span class="redirect-text">
                    {{ block.settings.redirect_text }}
                  </span>
                </a>
                    {% endcomment %}
              </div>
            {% when 'delivery_check' %}
              <div class="product__delivery-check" style="--bg-color: {{ block.settings.bg_color }};--ic-color: {{ block.settings.ic_color }}" {{ block.shopify_attributes }}>
                <span class="product__delivery-check-icon">
                  {% render 'svg-checked-circle' %}
                </span>
                <div class="product__delivery-check-content">
                  <h5 class="product__delivery-check-title">{{ block.settings.title }}</h5>
                  {% if block.settings.desc != blank %}
                    <p class="product__delivery-check-desc">{{ block.settings.desc }}</p>
                  {% endif %}
                </div>
              </div>
            {% when 'payment_text' %}
              <div class="product__payment-text" {{ block.shopify_attributes }}>
                <span class="product__payment-text-title">
                  {{ block.settings.title }}
                </span>
                {% if block.settings.logo != blank %}
                  {{ block.settings.logo | image_url: width: nil | image_tag: class: 'product__payment-text-logo' }}
                {% endif %}
              </div>

              {% if product.metafields.custom.custom_widget != blank %}
              <div style="margin-top: 30px;">
                {{ product.metafields.custom.custom_widget }}
              </div>
            {% endif %}

            {% when 'inventory_level' %}
              <div class="variant-visibility-area{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                {%- for variant in product.variants -%}
                  {% if variant.inventory_management != blank and variant.inventory_quantity > 0 %}
                    {% if block.settings.show_inventory_notice == 'always' or variant.inventory_quantity <= block.settings.inventory_threshold %}
                      <script type="text/template" data-variant-id="{{ variant.id }}">
                        {%- liquid
                          assign show_inventory_count = false
                          if block.settings.show_inventory_count == 'always'
                            assign show_inventory_count = true
                          endif
                          if block.settings.show_inventory_count == 'low' and variant.inventory_quantity <= block.settings.inventory_threshold
                            assign show_inventory_count = true
                          endif

                          if show_inventory_count
                            if variant.inventory_quantity <= block.settings.inventory_threshold
                              assign notice = 'products.labels.only_x_left' | t: quantity: variant.inventory_quantity
                            else
                              assign notice = 'products.labels.x_units_available' | t: quantity: variant.inventory_quantity
                            endif
                          else
                            if variant.inventory_quantity <= block.settings.inventory_threshold
                              assign notice = 'products.labels.low_stock' | t
                            else
                              assign notice = 'products.labels.in_stock' | t
                            endif
                          endif
                        -%}
                        {%- capture notice_html -%}
                          <div class="lightly-spaced-row">
                            <div class="product-info-block product-inventory-notice {% if block.settings.enable_pulse %}product-inventory-notice--pulse{% endif %} product-inventory-notice--{% if variant.inventory_quantity <= block.settings.inventory_threshold %}low{% else %}ok{% endif %} with-icon{% if block.settings.enable_box %} text-box{% endif %}">
                              <div class="icon-container">
                                {%- if variant.inventory_quantity <= block.settings.inventory_threshold -%}
                                  {%- render 'icon', icon: 'clock', size: 'small' -%}
                                {%- else -%}
                                  {%- render 'icon', icon: 'check_mark_in_circle', size: 'small' -%}
                                {%- endif -%}
                              </div>
                              <span class="with-icon__beside">{{ notice }}</span>
                            </div>
                          </div>
                        {%- endcapture -%}
                        {{- notice_html -}}
                      </script>
                      {%- if variant.id == current_variant.id -%}
                        {{- notice_html -}}
                      {%- endif -%}
                    {% endif %}
                  {% endif %}
                {%- endfor -%}
              </div>
            {% comment %}
            {% when 'accordion' %}
              {%- liquid
                assign content = block.settings.content
                if block.settings.page != blank
                  assign content = pages[block.settings.page].content
                endif
              -%}
              {%- if content != blank -%}
                <div class="detail-accordion{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  {%- capture accordion_title -%}
                    {%- if block.settings.icon == blank -%}
                      {{- block.settings.title | escape -}}
                    {%- else -%}
                      <div class="with-icon">
                        {% render 'icon', icon: block.settings.icon, size: 'small' %}
                        <span class="with-icon__beside">{{ block.settings.title | escape }}</span>
                      </div>
                    {%- endif -%}
                  {%- endcapture -%}
                  {% render 'accordion', allow_multi_open: true, add_content_class: 'rte cf', first_item_open: block.settings.open, item1_title: accordion_title, item1_content: content %}
                </div>
              {%- endif -%}
            {% endcomment %}

            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="lightly-spaced-row{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  {%- liquid
                    if block.settings.enable_box
                      assign box_color_brightness = block.settings.box_color | color_brightness
                      if box_color_brightness > 128
                        assign box_color_saturation = block.settings.box_color | color_extract: 'saturation'
                        if box_color_saturation > 0
                          assign text_col = block.settings.box_color | color_darken: 60 | color_saturate: 30 | color_to_rgb | split: '(' | last | split: ')' | first
                        else
                          assign text_col = block.settings.box_color | color_darken: 60 | color_to_rgb | split: '(' | last | split: ')' | first
                        endif
                      else
                        assign text_col = '255,255,255'
                      endif
                    endif
                  -%}
                  <div class="product-info-block{% if block.settings.icon != blank or block.settings.custom_icon != blank %} with-icon{% endif %}{% if block.settings.enable_box %} text-box{% endif %}" {% if block.settings.enable_box %}style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ text_col }}"{% endif %}>
                    {%- if block.settings.icon == blank and block.settings.custom_icon == blank -%}
                      {{- block.settings.text -}}
                    {%- else -%}
                      {% if block.settings.custom_icon == blank %}
                        {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size %}
                      {% else %}
                        <span class="icon icon--image icon--{{ block.settings.icon_size }}">{% render 'responsive-image', image: block.settings.custom_icon %}</span>
                      {% endif %}
                      <span class="with-icon__beside">{{ block.settings.text }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {% endif %}

            {% when 'richtext' %}
              {% if block.settings.richtext != blank %}
                <div class="lightly-spaced-row{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  {%- liquid
                    if block.settings.enable_box
                      assign box_color_brightness = block.settings.box_color | color_brightness
                      if box_color_brightness > 128
                        assign box_color_saturation = block.settings.box_color | color_extract: 'saturation'
                        if box_color_saturation > 0
                          assign text_col = block.settings.box_color | color_darken: 60 | color_saturate: 30 | color_to_rgb | split: '(' | last | split: ')' | first
                        else
                          assign text_col = block.settings.box_color | color_darken: 60 | color_to_rgb | split: '(' | last | split: ')' | first
                        endif
                      else
                        assign text_col = '255,255,255'
                      endif
                    endif
                  -%}
                  <div class="product-info-block{% if block.settings.icon != blank or block.settings.custom_icon != blank %} with-icon{% endif %}{% if block.settings.enable_box %} text-box{% endif %}" {% if block.settings.enable_box %}style="--box-color: {{ block.settings.box_color }}; --box-text-color: {{ text_col }}"{% endif %}>
                    {%- if block.settings.icon == blank and block.settings.custom_icon == blank -%}
                      <div class="rte cf">{{ block.settings.richtext }}</div>
                    {%- else -%}
                      {% if block.settings.custom_icon == blank %}
                        {% render 'icon', icon: block.settings.icon, size: block.settings.icon_size %}
                      {% else %}
                        <span class="icon icon--image icon--{{ block.settings.icon_size }}">{% render 'responsive-image', image: block.settings.custom_icon %}</span>
                      {% endif %}
                      <div class="with-icon__beside rte cf">{{ block.settings.richtext }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {% endif %}

            {% when 'popup' %}
              {% if block.settings.page != blank %}
                <div class="lightly-spaced-row{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  <a class="{% if block.settings.style != 'link' %}btn btn--{{ block.settings.style }} btn--link{% else %}feature-link{% endif %} cc-modal" href="{{ pages[block.settings.page].url }}" target="_blank" data-cc-modal-contentelement="#block-content-{{ section.id }}-{{ block.id }}"><span class="btn__text">{{ block.settings.text | escape }}</span></a>
                  <div id="block-content-{{ section.id }}-{{ block.id }}" class="hidden">
                    <div class="rte cf">{{ pages[block.settings.page].content }}</div>
                  </div>
                </div>
              {% endif %}

            {% when 'link' %}
              {% if block.settings.text != blank %}
                <div class="lightly-spaced-row{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  <a class="{% if block.settings.style != 'link' %}btn btn--{{ block.settings.style }} btn--link{% else %}feature-link{% endif %}" href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank"{% endif %}><span class="btn__text">{{ block.settings.text | escape }}</span></a>
                </div>
              {% endif %}

            {% when 'image' %}
              {% if block.settings.image != blank %}
                <div class="lightly-spaced-row inline-width-container{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" style="width: {{ block.settings.image_width }}px" {{ block.shopify_attributes }}>
                  {% if block.settings.url != blank %}<a href="{{ block.settings.url }}"{% if block.settings.open_in_new_tab %} target="_blank"{% endif %}>{% endif %}
                    {% render 'responsive-image', image: block.settings.image %}
                  {% if block.settings.url != blank %}</a>{% endif %}
                </div>
              {% endif %}

            {% when 'custom_liquid' %}
              {% if block.settings.custom_liquid != blank %}
                <div class="lightly-spaced-row{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
              {% endif %}

            {% when 'sharing' %}
              <div class="lightly-spaced-row not-in-quickbuy" {{ block.shopify_attributes }}>
                {% render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product %}
              </div>

            {% when 'divider' %}
              <hr {% unless block.settings.show_in_quickbuy %}class="not-in-quickbuy"{% endunless %} {{ block.shopify_attributes }}>

            {% when 'custom_option' %}
              {%- if block.settings.label != blank -%}
                {%- liquid
                  assign custom_option_input_id = product_form_id | append: '-custom-' | append: forloop.index
                  assign custom_input_name = block.settings.label | escape | prepend: 'properties[' | append: ']'
                -%}
                <div class="custom-option" {{ block.shopify_attributes}}>
                  {% case block.settings.type %}
                    {% when 'text' %}
                      <div class="option-selector">
                        <label class="label" for="{{ custom_option_input_id }}">{{ block.settings.label | escape }}</label>
                        <input class="custom-option__text-input" type="text" id="{{ custom_option_input_id }}" form="{{ product_form_id }}" name="{{ custom_input_name }}" {% if block.settings.text_required %}required{% endif %}>
                      </div>

                    {% when 'textarea' %}
                      <div class="option-selector">
                        <label class="label" for="{{ custom_option_input_id }}">{{ block.settings.label | escape }}</label>
                        <textarea class="custom-option__text-input" id="{{ custom_option_input_id }}" form="{{ product_form_id }}" name="{{ custom_input_name }}" {% if block.settings.text_required %}required{% endif %}></textarea>
                      </div>

                    {% when 'checkbox' %}
                      <div class="option-selector">
                        <label class="label">
                          <input type="hidden" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ block.settings.checkbox_unchecked_value | escape }}">
                          <input type="checkbox" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ block.settings.checkbox_checked_value | escape }}">
                          <span class="label__text-beside-input">{{ block.settings.label | escape }}</span>
                        </label>
                      </div>

                    {% when 'multiple' %}
                      {%- assign custom_options = block.settings.multiple_options | newline_to_br | strip_newlines | split: '<br />' -%}

                      {% if block.settings.multiple_style == 'dropdown' %}
                        <div class="option-selector" data-selector-type="dropdown">
                          {% render 'custom-select',
                            id: custom_option_input_id,
                            label: block.settings.label,
                            option_values: custom_options,
                            selected_value: custom_options.first,
                            include_native: true,
                            native_name: custom_input_name,
                            native_form_id: product_form_id
                          %}
                        </div>

                      {% else %}
                        <div class="option-selector" data-selector-type="radio">
                          <fieldset>
                            <legend class="label">{{ block.settings.label }}</legend>
                            {% for option in custom_options %}
                              <label class="label">
                                <input type="radio" form="{{ product_form_id }}" name="{{ custom_input_name }}" value="{{ option | escape }}"{% if forloop.first %} checked{% endif %}>
                                <span class="label__text-beside-input">{{ option | escape }}</span>
                              </label>
                            {% endfor %}
                          </fieldset>
                        </div>
                      {% endif %}

                  {% endcase %}
                </div>
              {%- endif -%}

            {% when 'related_products' %}
              {% if block.settings.product_list != blank %}
                <div class="lightly-spaced-row lightish-spaced-row-above{% unless block.settings.show_in_quickbuy %} not-in-quickbuy{% endunless %}" {{ block.shopify_attributes }}>
                  {%- liquid
                    if settings.prod_thumb_shape == 'portrait-23'
                      assign chosen_aspect_ratio = 0.67
                    elsif settings.prod_thumb_shape == 'portrait-45'
                      assign chosen_aspect_ratio = 0.8
                    elsif settings.prod_thumb_shape == 'square'
                      assign chosen_aspect_ratio = 1.0
                    elsif settings.prod_thumb_shape == 'landscape-54'
                      assign chosen_aspect_ratio = 1.25
                    elsif settings.prod_thumb_shape == 'landscape-32'
                      assign chosen_aspect_ratio = 1.50
                    elsif settings.prod_thumb_shape == 'tallest'
                      assign chosen_aspect_ratio = 99
                      for product in block.settings.product_list
                        if product.featured_media.preview_image.aspect_ratio < chosen_aspect_ratio
                          assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endfor
                    else
                      assign chosen_aspect_ratio = 0
                      for product in block.settings.product_list
                        if product.featured_media.preview_image.aspect_ratio > chosen_aspect_ratio
                          assign chosen_aspect_ratio = product.featured_media.preview_image.aspect_ratio
                        endif
                      endfor
                    endif
                  -%}

