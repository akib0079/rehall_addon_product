            if(!mainSwiper.querySelector('.swiper-wrapper').innerHTML)
              mainSwiper.remove()
            /*else{
              if (window.matchMedia("(max-width: 767px)").matches) {
                var gallerySwiper = new Swiper('.main-product-swiper', {
                  slidesPerView: 1,
