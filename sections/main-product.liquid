                  gallerySwiper = new Swiper(newSwiper, {
                    slidesPerView: 'auto',
                    // slidesPerGroupSkip: 1,
                    navigation: {
                      nextEl: newSwiper.querySelector('.product-slider__nav.next'),
                      prevEl: newSwiper.querySelector('.product-slider__nav.prev'),
                    },
                    pagination: {
                      el: newSwiper.querySelector('.swiper-pagination'),
                      clickable: true,
                      dynamicBullets: true,
                      dynamicMainBullets: 3
                    },
                    breakpoints: {
                      768: {
                        slidesPerGroup: 2,
                        // slidesPerGroupSkip: 2,
                        pagination: {
                          dynamicBullets: false,
                          el: newSwiper.querySelector('.swiper-pagination'),
                          clickable: true,
                          // dynamicMainBullets: 5
                        },
                      },
                    },
                  });
                }
              }
            });
            // options.forEach(swatch => {
            //   const swatchNameEle = document.querySelector(`.opt-label[for="${swatch.id}"]`)
            //   if(container.querySelector(`.product__image[alt="${swatchNameEle.innerText}" i]`)){
