            const sizeSelector = document.querySelector(".option-selector:not(.option-selector--swatch)");
            sizeSelector?.style.setProperty('--height', sizeSelector.scrollHeight + 'px')
            $(this).on('variantChanged', function (evt, variant) {
              const opt = document.querySelector(".option-selector--swatch .opt-btn:checked")
              if (!opt) return;
              const unavailable = document.querySelector(".option-selector--swatch .opt-btn:checked").classList.contains('is-unavailable')
              sizeSelector.classList.toggle('is-unavailable', unavailable)
              let swiperEle = document.querySelector(`.main-product-swiper[data-swatch-anchor="${document.querySelector(".option-selector--swatch .opt-btn:checked").value}" i]`)
              let main = false
              if(!swiperEle){
                swiperEle = container.querySelector('.main-product-swiper')
                main = true
              }
              if(!swiperEle.classList.contains('active')){
                document.querySelector('.main-product-swiper.active')?.classList.remove('active')
