{% for block in section.blocks %}
  {% case block.type %}
    {% when 'popup_info' %}
      {% if block.settings.desc != blank %}
          <div class="product-alt__popup-content" data-id="{{ block.id }}">
              <div class="product-alt__popup-content-inner">
                  <div class="product-alt__popup-content-header">
                      {% if block.settings.title != blank %}
                          <h4>{{ block.settings.title }}</h4>
                          <a class="product-alt__popup-close" href="#" aria-labelledby="popup close">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                  <path d="M18 6L6.00081 17.9992M17.9992 18L6 6.00085" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                          </a>
                      {% endif %}
                  </div>
                  <div class="product-alt__desc desc{% if block.settings.parse %} specifications{% endif %}">
                      {% liquid
                          assign desc = block.settings.desc
                          if block.settings.parse
                          assign items = desc | split: '<li' 
                          for item in items
                              if item contains '|'
                                  assign first_char = item | strip | slice: 0, 1
                                  if first_char == '>'
                                    assign content = item | remove_first: '>' | split: '</li>' | first
                                  else 
                                      assign content = item | split: '">' | last | split: '</li>' | first 
                                  endif
                                  assign parts = content | split: '|'
                                  assign value = parts[1] | strip
                                  if value == blank
                                    assign r_item = item | prepend: '<li' | split: '</li>' | first | append: '</li>'
                                    assign desc = desc | remove_first: r_item
                                    #echo r_item | escape | prepend: "<pre>" | append: "</pre>"
                                  else
                                    assign value = value | prepend: '<span class="text">' | append: '</span>'
                                    assign new_content = parts[0] | strip | prepend: '<span class="heading">' | append: '</span>' | append: value
                                    assign new_item = item | replace: content, new_content
                                    #echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                                    #if parts[1] == blank 
                                    #echo new_item | escape | prepend: "<pre>" | append: "</pre>"
                                    assign desc = desc | replace: item, new_item
                                  endif
                              endif 
                          endfor
                        endif 
                      %}
                      {{ desc }}
                  </div>
              </div>
              <div class="product-alt__popup-bg"></div>
          </div>
      {% endif %}
  {% endcase %}
{% endfor %}
<script>
  
    document.querySelectorAll('.section-id-{{ section.id }} .product-alt__popup-anchor').forEach(anchor => {
        const content = document.querySelector(`.product-alt__popup-content[data-id=${anchor.dataset.id}]`)
        if(content){
          anchor.addEventListener('click', e => {
              e.preventDefault();
              content.classList.add('active');
              document.body.classList.add('popup-active');
          })
          content.querySelector('.product-alt__popup-close').addEventListener('click', e => {
              e.preventDefault();
              content.classList.remove('active');
              document.body.classList.remove('popup-active');
          })
          content.querySelector('.product-alt__popup-bg').addEventListener('click', e => {
              e.preventDefault();
              content.classList.remove('active');
              document.body.classList.remove('popup-active');
          })
          content.querySelectorAll('.specifications').forEach(spec => {
              spec.querySelectorAll('h5,h4').forEach(heading => {
                  if (heading.nextElementSibling.innerHTML.trim() == '' || heading.nextElementSibling?.tagName != 'UL' && heading.nextElementSibling?.tagName != 'P') {
                     heading.remove();
                  }
              })
          })
        }

    })
    
    document.querySelectorAll('.section-id-{{ section.id }} .product__badge_model-size').forEach(block => {
      const textEle = block.querySelector('span');
      const label = block.dataset.label;
      const productValue = block.dataset.productValue || '';
      let value = block.dataset.value;
      // Model size per variant: variant id -> text, rendered by Liquid.
      let byVariant = null;
      const mapEle = block.querySelector('.product__badge_model-size_variants');
      if (mapEle) {
        try { byVariant = JSON.parse(mapEle.textContent); } catch (e) { byVariant = null; }
      }
      const render = () => {
        if (textEle) textEle.innerText = block.classList.contains('active') ? value : label;
        block.style.display = value ? '' : 'none';
      };
      if(textEle)
      block.addEventListener('click', () => {
        block.classList.toggle('active');
        render();
      })
      if (byVariant) {
        // The theme announces a variant switch with the jQuery event
        // 'variantChanged'. jQuery is loaded with defer, so bind once it is there.
        const bind = () => {
          const jq = window.jQuery || window.$;
          if (!jq) return;
          jq(document).on('variantChanged', (evt, variant) => {
            if (!variant || !variant.id) return;
            value = byVariant[variant.id] || productValue;
            render();
          });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
        else bind();
      }
    })
</script>
<script>
  (function () {
    const PRODUCT_FORM_SELECTOR = '.product-form';
    const FITTING_SELECTOR = '.faslet-container  faslet-app';
    const FITTING_INNER_SELECTOR = '.open-button-parent';
    const FITTING_CUSTOM_SELECTOR = '.product-alt__fitting-block';

    function appendCustomBlock(){
      const wrapper = document.querySelector(PRODUCT_FORM_SELECTOR);
      const ftBlock = wrapper.querySelector('.product-alt__fitting-block');
      const varBlock = wrapper.querySelector('.input-row .option-selector--swatch .opposing-items label');
      if(varBlock && ftBlock){
        varBlock.after(ftBlock);
      }
    }
    appendCustomBlock()
    function showCustomFitting(wrapper, fitting, observer) {
          const custom = wrapper.querySelector(FITTING_CUSTOM_SELECTOR);
          if(fitting.shadowRoot.querySelector(FITTING_INNER_SELECTOR)){
            custom.classList.add('active');
            observer.disconnect();
            custom.addEventListener('click', e => {
              const shadow = fitting.shadowRoot;

              const button = shadow.querySelector('.open-button-parent');
              button.click();
            })
          }
          
    }
    function observeGrid(wrapper) {
      let debounceTimer;
      const shadowObserver = new MutationObserver(() => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          const fitting = wrapper.querySelector(FITTING_SELECTOR);
          showCustomFitting(wrapper, fitting, shadowObserver);
        }, 60); // 👈 tweak delay if needed
      })
      const observer = new MutationObserver(() => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          const fitting = wrapper.querySelector(FITTING_SELECTOR);
          if (fitting && fitting.shadowRoot) {
            shadowObserver.observe(fitting.shadowRoot, {
              childList: true,
              subtree: true
            });
            observer.disconnect();
          }

        }, 60); // 👈 tweak delay if needed
      });

      observer.observe(wrapper, {
        childList: true,
        subtree: true
      });

      return observer;
    }


    document.addEventListener('DOMContentLoaded', () => {
      const wrapper = document.querySelector(PRODUCT_FORM_SELECTOR);
      if (!wrapper) return;

      observeGrid(wrapper);
    });
  })();
</script>
