            }
            const colorOptions = Array.from(options).map(swatch => {
              const swatchNameEle = document.querySelector(`.opt-label[for="${swatch.id}"]`);
              const colorName = swatchNameEle ? swatchNameEle.innerText.trim() : '';
              return { colorName, swatch };
            });
            colorOptions.sort((a, b) => b.colorName.length - a.colorName.length);
            const matchedSlides = new Set();

            colorOptions.forEach(({ colorName, swatch }) => {
              if (!colorName) return;

              // Uses \$= to match if the alt ends with the color name case-insensitively
              const matchingImages = container.querySelectorAll(`.product__image[alt$="${colorName}" i]`);
              const slidesToAppend = [];

              matchingImages.forEach(img => {
                const slide = img.closest(".swiper-slide");
                
                // Only add if this slide hasn't been claimed by a longer color name yet
                if (slide && !matchedSlides.has(slide)) {
                  matchedSlides.add(slide);
                  slidesToAppend.push(slide);
                }
              });

              // Append the specific slides for this color to the swiper wrapper
              if (slidesToAppend.length > 0) {
                //alert(colorName)
                const swatchNameEle = document.querySelector(`.opt-label[for="${swatch.id}"]`);
                const newSwiper = mainSwiper.cloneNode(true);
                newSwiper.querySelector('.swiper-wrapper').innerHTML = null
                newSwiper.querySelector('.swiper-wrapper').append(...Array.from(container.querySelectorAll(`.product__image[alt="${swatchNameEle.innerText}" i]`)).map(ele => ele.closest(".swiper-slide")))
                newSwiper.setAttribute('data-swatch-anchor', swatchNameEle.innerText)
                container.append(newSwiper)
                if(swatch.checked){
                  newSwiper.classList.add('active')
                  setTimeout(() => {
                    document.querySelector('.prodcut__images-con').style.setProperty('--height', newSwiper.scrollHeight + 'px')
                  }, 10);
                  
