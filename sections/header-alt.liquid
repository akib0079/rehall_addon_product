    <script>
      {% comment %} document.querySelectorAll('.header-alt_megamenu-second-level').forEach(link => link.classList.add('to-be-animated')) {% endcomment %}
      document.addEventListener("DOMContentLoaded", () => {
        const mobile = window.matchMedia("(max-width: 767px)").matches;

        document.querySelectorAll('.header-alt__toggle-ic-mobile').forEach(btn => {
          btn.addEventListener('click', () => {
            document.body.classList.toggle('megamenu-active');
            if(document.body.classList.contains('megamenu-active')){
              document.addEventListener('click', closeMegamenu)
            }
          })
        })
        document.querySelectorAll('.header-alt__megamenu-back-link').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            btn.closest('.active').classList.remove('active');
            document.body.classList.remove('megamenu-second-level')
          })
        })
        document.querySelectorAll('.header-alt__close-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            document.body.classList.remove('megamenu-active');
            document.querySelectorAll('.header-alt_megamenu-second-level.active').forEach(item => item.classList.remove('active'));
          })
        })
        
        function closeMegamenu(e){
          if (document.body.classList.contains('megamenu-active') && (e == null || (e.target.closest('.collection-mega-wrap') === null && e.target.closest('.collection-mega-outer') === null))) { // or use: event.target.closest(selector) === null
            document.body.classList.remove('megamenu-active')
            document.querySelector('.header-alt_megamenu.active').classList.remove('active')
            document.querySelector('.header-alt__toggle-btn.active').classList.remove('active')
            document.removeEventListener('click', closeMegamenu)
          }
        }
        document.querySelectorAll('.header-alt__toggle-btn[data-toggle-target]').forEach(btn => {
          const target = document.querySelector(`.header-alt_megamenu[data-megamenu="${btn.dataset.toggleTarget}"]`)
          if(target){
            btn.addEventListener('mouseenter', () => {
              if(window.matchMedia("(pointer: fine)").matches)
              {
                closeMegamenu(null)
                document.body.classList.add('megamenu-active')
                document.addEventListener('click', closeMegamenu)
                target.classList.add('active')
                btn.classList.add('active')
              }
            })
            btn.addEventListener('click', () => {
              if(!mobile && document.body.classList.contains('megamenu-active')){
                closeMegamenu(null)
              }
              else{
                if(!mobile){
                  document.addEventListener('click', closeMegamenu)
                  document.body.classList.add('megamenu-active')
                  btn.classList.add('active')
                }
                target.classList.add('active')
              }
              {% comment %} 
              if(window.matchMedia("(pointer: fine)").matches) {
                if(!document.body.classList.contains('megamenu-active')){
                  document.removeEventListener('click', closeMegamenu)
                  target.classList.remove('active')
                  btn.classList.remove('active')
                }
                else{
                  document.addEventListener('click', closeMegamenu)
                  target.classList.add('active')
                  btn.classList.add('active')
                }
              } {% endcomment %}
            })
          }
        })
        document.querySelectorAll('.header-alt_megamenu').forEach(megamenu => {
          const midLevelWrap = megamenu.querySelector('.header-alt_megamenu-second-level-wrap');
          megamenu.querySelectorAll('.header-alt_megamenu-top-link').forEach((link,i) => {
            const level = megamenu.querySelector(`.header-alt_megamenu-second-level[data-anchor="${link.dataset.anchor}"]`)
            const image = megamenu.querySelector(`.header-alt_megamenu-block-wrap-inner.secondary[data-menu="${link.querySelector("span").textContent.toLowerCase()}"]`)
            
            link.addEventListener('mouseenter', (e) => {
              if(link.classList.contains('active') || mobile) return;
              megamenu.querySelectorAll('.active').forEach(ele => ele.classList.remove('active'));
              if(level){
                level.classList.add('active')
                midLevelWrap.style.setProperty('--height', level.scrollHeight + 'px');
              }else{
                midLevelWrap.style.setProperty('--height', '0px');
              }
              if(!mobile && image){
                image.classList.add('active')
              }
              link.classList.add('active')
              if (e.augmentedTrigger) return;
            })
            if(level){
              link.addEventListener('click', (e) => {
                e.preventDefault();
                if(mobile){
                  level.classList.add('active')
                  document.body.classList.add('megamenu-second-level')
                }
              })
            }
            if(!mobile && i==0){
              const event = new MouseEvent('mouseenter', {
                bubbles: true,
                cancelable: true,
                view: window
              });
              event.augmentedTrigger = true; 
              link.dispatchEvent(event);
            }
          })
        })
      })
        
    </script>
<script>
  document.addEventListener('DOMContentLoaded', ()=>{
    {% comment %} {% if template.name == 'index' %}
      ScrollTrigger.create({
        trigger:document.querySelector('.section-slideshow'),
        start:"top top",
        end:"bottom-=45px top",
        onLeave: () => {
          document.body.classList.remove('white-header')
        },
        onEnterBack: () => {
          document.body.classList.add('white-header')
        },
      })

    {% endif %} {% endcomment %}
    
    {% comment %} let abortController;
    function fetchRehallSearch(){
      if (abortController) {
          abortController.abort();
      }
  
      abortController = new AbortController();
      const signal = abortController.signal;
      $('.header__search-form-results').addClass('ajax-loading');
      fetch(theme.routes.search_url+'?q='+$('.header__search-field').val()+'&type=product&view=ajax-rehall', {signal}).
        then((response) => {
          if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
          }
          return response.text();
        }).
        then((response) => {
          const $parsed = $(`<div>${response}</div>`);
          $('.header__search-form-results').html($parsed.find('[data-ajax-container="products"]').html());
          $('.header__search-form-results').removeClass('ajax-loading');

          new Swiper('.pageheader .search_sugg-wrap .swiper', {
            slidesPerView: 'auto',
            spaceBetween: 20,
            freeMode: {
              enabled: true,
              sticky: true,
              momentumRatio: 0.8,
            },
            speed: 400,
            scrollbar: {
              el: '.pageheader .search_sugg-wrap .swiper-scrollbar',
              draggable: true
            },
          });
          document.querySelectorAll('.search_sugg-wrap .swiper-slide').forEach(item => {
            item.addEventListener('click', ()=>{
              if(item.classList.contains('link') && !item.dataset.link.endsWith('#')){
                const link = item.dataset.link;
                if(link.startsWith('/')) window.location.href = `${window.location.origin}${link}`;
                else window.location.href = link;
              } else{
                window.location.href = `${window.location.origin}{{ routes.search_url }}?q=${item.innerText.toLowerCase()}`;
              }
            })
          })
          theme.initAnimateOnScroll();
        });
    } {% endcomment %}
    {% comment %} document.querySelectorAll('.header__search-form-wrap').forEach(formWrap => {
      const field = formWrap.querySelector('.header__search-field');
      const form = formWrap.querySelector('.header__search-form');
      const popup = formWrap.querySelector('.header__search-form-results-container');
      const closeBtn = formWrap.querySelector('.header__search-form-close');
      function closePopup(e){
        if(e.target == formWrap || formWrap.contains(e.target)) return;
        formWrap.classList.remove('active');
        document.body.classList.remove('search-popup-active');
        document.removeEventListener('click', closePopup);
      }
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        formWrap.classList.remove('active');
        document.body.classList.remove('search-popup-active');
        document.removeEventListener('click', closePopup);
      })
      formWrap.querySelector('.header__search-field');
      field.addEventListener('focus', () => {
        formWrap.classList.add('active');
        document.body.classList.add('search-popup-active');
        document.addEventListener('click', closePopup);
      })
      
      $(field).keyup(function(e){
        if (e.key !== 'Enter') {
            fetchRehallSearch();
        }
      });
      $(form).submit(function(e){
        e.preventDefault();
      });
    })
    fetchRehallSearch(); {% endcomment %}
  })
</script>

