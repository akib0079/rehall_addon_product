{%- assign mobile_expand_with_entire_link = true -%}

{% style %}
  .logo img {
    width: {{ section.settings.logo_img_width_int }}px;
  }
  .logo-area__middle--logo-image {
    max-width: {{ section.settings.logo_img_width_int }}px;
  }
  @media (max-width: 767.98px) {
    .logo img {
      width: {{ section.settings.mobile_logo_img_width_int }}px;
    }
    .logo-area__middle--logo-image {
      max-width: {{ section.settings.mobile_logo_img_width_int }}px;
    }
  }
  {%- if section.settings.enable_sticky -%}
  .section-header {
    position: -webkit-sticky;
    position: sticky;
    top: var(--magic-margin);
  }
  {%- endif -%}
{% endstyle %}

<div data-section-type="header-alt" data-cc-animate>
  {% for block in section.blocks %}
    {% if block.type == 'top-header' %}
      <div class="card-scheme--2" {{ block.shopify_attributes }}>
        <div class="header__top wide-container">
          <div class="header__top_col">
            <h5 class="header__top_heading">
              {{ block.settings.heading }}
            </h5>
            {%- assign top_links = block.settings.list | split: '|' -%}
            {% if top_links.size > 0 %}
              <ul class="header__top_list">
                {% for link in top_links %}
                  <li class="header__top_list-item">
                    {% render 'svg-checked-circle' %}
                    <span>{{ link | strip }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <div class="header__top_col">
            <div class="header__top_star-main">
              {% render 'star-rating', rating: block.settings.rating, class: 'header__top__stars-wrap' %}
              <h6 class="header__top_star_heading">{{ block.settings.rating | times: 1.0 | round: 1 }}</h6>
            </div>
            <p class="header__top_star_para">{{ block.settings.rating_text }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  <div
    id="pageheader"
    class="pageheader pageheader--layout-{{ section.settings.menu_layout }} pageheader--layout-inline-permitted{% if section.settings.enable_sticky %} pageheader--sticky{% endif %}"
  >
    <div class="card header-alt__row">
      <div class="logo" itemscope itemtype="http://schema.org/Organization">
        <meta itemprop="name" content="{{ shop.name | escape }}">

        {%- if request.page_type == 'index' and section.settings.logo_h1 -%}
          <h1 class="logo__h1">
        {%- endif -%}

        <a class="logo__link{% if section.settings.logo_white != blank %} with-white{%- endif -%}" href="{{ routes.root_url }}" title="{{ shop.name }}" itemprop="url">
          {%- if section.settings.logo != blank -%}
            {%- capture img_size -%}{{ section.settings.logo_img_width_int | times: 2 }}x{%- endcapture -%}
            <img
              class="logo__image desktop-only"
              src="{{ section.settings.logo | img_url: img_size }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              itemprop="logo"
            >
            <img
              class="logo__image mobile-only"
              src="{{ section.settings.logo_mobile | default: section.settings.logo | img_url: img_size }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              itemprop="logo"
            >
          {%- else -%}
            <span class="logotext">{{ shop.name }}</span>
          {%- endif -%}
          {%- if section.settings.logo_white != blank -%}
            {%- capture img_size -%}{{ section.settings.logo_img_width_int | times: 2 }}x{%- endcapture -%}
            <img
              class="logo__image logo-white desktop-only"
              src="{{ section.settings.logo_white | img_url: img_size }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              itemprop="logo"
            >
            <img
              class="logo__image logo-white mobile-only"
              src="{{ section.settings.logo_white_mobile | default: section.settings.logo_white | img_url: img_size }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              itemprop="logo"
            >
          {%- endif -%}
        </a>

        {%- if request.page_type == 'index' and section.settings.logo_h1 -%}
          </h1>
        {%- endif -%}
      </div>

      <div class="header-alt__mid-col">
        <div class="collection-mega-wrap">
          {% for block in section.blocks %}
            {% if block.type == 'megamenu' %}
              <button
                class="btn--icon header-alt__toggle-btn desktop-only"
                aria-label="{{ 'general.navigation.menu_toggle_aria_label' | t }}"
                data-toggle-target="megamenu-{{ block.id }}"
              >
                <span class="btn-text">{{ block.settings.label }}</span>
                {% comment %} <div class="header-alt__toggle-ic">
                {%- render 'svg-chevron-down' -%}
                </div> {% endcomment %}
              </button>
            {% endif %}
          {% endfor %}
          <div class="header-alt__toggle-ic-mobile mobile-only">
            {%- render 'svg-menu' -%}
            {%- render 'svg-cross' -%}
          </div>
        </div>
        {% if section.settings.left_menu != blank %}
          <ul class="header-alt__mid-menu">
            {% for link in section.settings.left_menu.links %}
              <li class="header-alt__mid-menu_item">
                <a class="header-alt__mid-menu_item-link" href="{{ link.url }}">
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="logo-area__right__inner">
        
        <div class="header__search-form-wrap">
          <form class="header__search-form" action="{{ routes.search_url }}" method="get">
            <a class="header__search-form-close" href="#"> 
              <span class="mobile-only">{% render 'svg-chevron-left' %}</span>
              <span class="desktop-only">{% render 'svg-cross' %}</span>
            </a>
            <a class="header__search-form-clear" href="#"> {% render 'svg-cross' %}</a>
            <input type="text" class="header__search-field" placeholder="{{ 'general.header.search_placeholder' | t }}" name="q" value="{{ search.terms | escape }}" autocomplete="off">
            <button type="submit" class="header__search-button">{% render 'svg-search-alt' %}</button>
          </form>
          
        </div>
          {% comment %} <a class="header-alt-link" href="{{ pages['black-friday'].url }}">
            <span class="header-alt-link_text login-text">
              Black Friday
            </span>
          </a> {% endcomment %}
          {%- if section.settings.show_helpdesk -%}
          <a class="header-alt-link" href="{{ section.settings.helpdesk_url | default: '#' }}">
            <span class="header-alt-link_text">
              {{section.settings.helpdesk}}
            </span>
          </a>
          {%- endif -%}
          <a class="header-alt-link login" href="{{ routes.account_url }}">
            <span class="header-alt-link_icon">{% render 'svg-user-alt' %}</span>
            <span class="header-alt-link_text login-text">
              {%- if customer -%}
                {%- if customer.first_name != blank -%}
                   {{ customer.first_name }}{% render 'svg-dot' %}
                {% else %}
                  {{ 'customer.account.title' | t }}{% render 'svg-dot' %}
                {%- endif -%}
              {% else %}
               {{ 'customer.login.title' | t }}
              {%- endif -%}
            </span>
          </a>
          <a class="header-alt-link cart inactive" href="{{ routes.cart_url }}">
            <span class="header-alt-link_icon">{% render 'svg-cart-alt' %}</span>
            <span class="header-alt-link_text">{{ 'layout.header.cart' | t }}</span>
            {%- if cart.item_count > 0 -%}
              <span class="cart__count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
      </div>
    </div>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'bottom-header' %}
      <div class="card card-scheme--2" {{ block.shopify_attributes }}>
        <div class="header__bottom wide-container">
          <h6 class="header__bottom_text">
            <span class="desktop-only">{{ block.settings.heading }}</span
            ><span class="mobile-only">{{ block.settings.heading_mobile | default: block.settings.heading }}</span>
          </h6>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>
<div class="collection-mega-outer">
  <button class="header-alt__close-btn mobile-only">{% render 'svg-cross' %}</button>
  {% for block in section.blocks %}
    {% if block.type == 'megamenu' %}
      {% comment %} <button
        class="btn--icon header-alt__toggle-btn mobile-only"
        aria-label="{{ 'general.navigation.menu_toggle_aria_label' | t }}"
        data-toggle-target="megamenu-{{ block.id }}"
      >
        <span class="btn-text">{{ block.settings.label }}</span>
        {% render 'svg-megamenu-arrow' %}
      </button> {% endcomment %}
      {% assign megamenu = linklists[block.settings.menu].links %}
      {% if megamenu != blank and request.design_mode != true %}
        <div class="header-alt_megamenu{% if block.settings.show_in_mobile %} show-in-mobile{% endif %}" {{ block.shopify_attributes }} data-megamenu="megamenu-{{ block.id }}">
          <div class="header-alt_megamenu-scroller">
            <div class="header-alt_megamenu-inner">
              {% assign second_level = '' %}
              <div class="header-alt_megamenu-level header-alt_megamenu-first-level">
                {% comment %} <a class="header-alt__megamenu-back-link mobile-only" href="#">
                  {% render 'svg-chevron-left' %}
                  {{ block.settings.back }}
                </a> {% endcomment %}
                {% assign highlight_item = block.settings.highlight_item | downcase %}
                {% for link in megamenu %}
                  {% assign item_sanitized = link.title | downcase %}
                  <a class="header-alt_megamenu-top-link{% if item_sanitized == highlight_item %} highlighted{% endif %}" href="{{ link.url }}"{% if link.links != blank %} data-anchor="t-{{ link.handle }}"{% endif %}>
                      <span>{{ link.title }}</span>
                      {% if link.links != blank %}
                        {% render 'svg-chevron-right' %}
                        {% capture m_item %}
                        <div class="header-alt_megamenu-level header-alt_megamenu-second-level" data-anchor="t-{{ link.handle }}">
                            <button class="header-alt__close-btn mobile-only">{% render 'svg-cross' %}</button>
                            <a class="header-alt__megamenu-back-link mobile-only" href="#">
                              {% render 'svg-chevron-left' %}
                              {{ block.settings.back }}
                            </a>
                            <h4 class="header-alt_megamenu-second-level_title">{{ link.title }}</h4>
                            {% for link in link.links %}
                              <a class="header-alt_megamenu-middle-link" href="{{ link.url }}"{% if link.links != blank %} data-anchor="m-{{ link.handle }}"{% endif %}>
                                <span><span>{{ link.title }}</span></span>
                                {% render 'svg-megamenu-arrow' %}
                              </a>
                            {% endfor %}
                            {% if block.settings.show_in_mobile and block.settings.all_products_url != blank %}
                              <a class="header-alt_megamenu-middle-link all-products-link mobile-only" href="{{ block.settings.all_products_url }}">
                                <span><span>{{ block.settings.all_products_text }}</span></span>
                                {% render 'svg-megamenu-arrow' %}
                              </a>
                            {% endif %}
                        {% if section.settings.mobile_footer_menu != blank %}
                          <div class="header-alt__mobile-footer-menu mobile-only">
                            <div class="header-alt__mobile-footer-menu_inner">
                            {% for link in section.settings.mobile_footer_menu.links %}
                                <a class="header-alt__mobile-footer-item" href="{{ link.url }}">
                                  <span>{{ link.title }}</span>
                                </a>
                            {% endfor %}
                            </div>
                          </div>
                        {% endif %}
                          </div>
                        {% endcapture %}
                        {% assign second_level = second_level | append: m_item %}
                      {% endif %}
                  </a>
                {% endfor %}
              </div>
              <div class="header-alt_megamenu-second-level-wrap">
                <div class="header-alt_megamenu-second-level-wrap-inner">
                  {{second_level }}
                </div>
              </div>
              {% if block.settings.block %}
                <div class="header-alt_megamenu-block-wrap">
                <div class="header-alt_megamenu-block-wrap-inner">
                  <a class="header-alt_megamenu-block" href="{{block.settings.block_url }}">
                    {% if block.settings.block_image != blank %}
                    {{ block.settings.block_image | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                    {% endif %}
                    <div class="header-alt_megamenu-block-content-row">
                      <div class="header-alt_megamenu-block-content">
                        {% if block.settings.block_title != blank %}
                          <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title }}</h4>
                        {% endif %}
                        {% if block.settings.block_desc != blank %}
                          <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc }}</div>
                        {% endif %}
                      </div>
                      {% if block.settings.block_url != blank %}
                        <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                      {% endif %}
                    </div>
                  </a>
                  <a class="header-alt_megamenu-block" href="{{ block.settings.block_url_2 }}">
                    {% if block.settings.block_image_2 != blank %}
                    {{ block.settings.block_image_2 | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                    {% endif %}
                    <div class="header-alt_megamenu-block-content-row">
                      <div class="header-alt_megamenu-block-content">
                        {% if block.settings.block_title_2 != blank %}
                          <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title_2 }}</h4>
                        {% endif %}
                        {% if block.settings.block_desc_2 != blank %}
                          <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc_2 }}</div>
                        {% endif %}
                      </div>
                      {% if block.settings.block_url_2 != blank %}
                        <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                      {% endif %}
                    </div>
                  </a>
                  <a class="header-alt_megamenu-block" href="{{block.settings.block_url_3 }}">
                    {% if block.settings.block_image_3 != blank %}
                    {{ block.settings.block_image_3 | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                    {% endif %}
                    <div class="header-alt_megamenu-block-content-row">
                      <div class="header-alt_megamenu-block-content">
                        {% if block.settings.block_title_3 != blank %}
                          <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title_3 }}</h4>
                        {% endif %}
                        {% if block.settings.block_desc_3 != blank %}
                          <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc_3 }}</div>
                        {% endif %}
                      </div>
                      {% if block.settings.block_url_3 != blank %}
                        <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                      {% endif %}
                    </div>
                  </a>
                </div>
                {% assign megamenu_title = block.settings.label | downcase | strip %}
                {% for block in section.blocks %}
                  {% assign match_title = block.settings.megamenu_title | downcase | strip %}
                  {% if block.type == 'megamenu_image' and match_title == megamenu_title and block.settings.menu_title != blank %}
                    <div class="header-alt_megamenu-block-wrap-inner secondary" data-menu="{{ block.settings.menu_title | downcase }}">
                      <a class="header-alt_megamenu-block" href="{{block.settings.block_url }}">
                        {% if block.settings.block_image != blank %}
                        {{ block.settings.block_image | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                        {% else %}
                          {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                        {% endif %}
                        <div class="header-alt_megamenu-block-content-row">
                          <div class="header-alt_megamenu-block-content">
                            {% if block.settings.block_title != blank %}
                              <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title }}</h4>
                            {% endif %}
                            {% if block.settings.block_desc != blank %}
                              <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc }}</div>
                            {% endif %}
                          </div>
                          {% if block.settings.block_url != blank %}
                            <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                          {% endif %}
                        </div>
                      </a>
                      <a class="header-alt_megamenu-block"  href="{{ block.settings.block_url_2 }}">
                        {% if block.settings.block_image_2 != blank %}
                        {{ block.settings.block_image_2 | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                        {% else %}
                          {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                        {% endif %}
                        <div class="header-alt_megamenu-block-content-row">
                          <div class="header-alt_megamenu-block-content">
                            {% if block.settings.block_title_2 != blank %}
                              <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title_2 }}</h4>
                            {% endif %}
                            {% if block.settings.block_desc_2 != blank %}
                              <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc_2 }}</div>
                            {% endif %}
                          </div>
                          {% if block.settings.block_url_2 != blank %}
                            <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                          {% endif %}
                        </div>
                      </a>
                      <a class="header-alt_megamenu-block" href="{{block.settings.block_url_3 }}">
                        {% if block.settings.block_image_3 != blank %}
                        {{ block.settings.block_image_3 | image_url: width: nil | image_tag: class: "header-alt_megamenu__block-img" }}
                        {% else %}
                          {{ 'collection-1' | placeholder_svg_tag: 'header-alt_megamenu__block-img' }}
                        {% endif %}
                        <div class="header-alt_megamenu-block-content-row">
                          <div class="header-alt_megamenu-block-content">
                            {% if block.settings.block_title_3 != blank %}
                              <h4 class="header-alt_megamenu__block-title">{{block.settings.block_title_3 }}</h4>
                            {% endif %}
                            {% if block.settings.block_desc_3 != blank %}
                              <div class="header-alt_megamenu__block-desc">{{block.settings.block_desc_3 }}</div>
                            {% endif %}
                          </div>
                          {% if block.settings.block_url_3 != blank %}
                            <div class="header-alt_megamenu__block-link">{% render 'svg-megamenu-arrow' %}</div>
                          {% endif %}
                        </div>
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
        
        
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if section.settings.left_menu != blank %}
    {% for link in section.settings.left_menu.links %}
      <li class="header-alt__megamenu-item">
        <a class="header-alt__megamenu-item-link" href="{{ link.url }}">
          <span>{{ link.title }}</span>
        </a>
      </li>
    {% endfor %}
  {% endif %}
  {% if section.settings.left_menu != blank %}
    {% for link in section.settings.left_menu.links %}
      <li class="header-alt__megamenu-item">
        <a class="header-alt__megamenu-item-link" href="{{ link.url }}">
          <span>{{ link.title }}</span>
        </a>
      </li>
    {% endfor %}
  {% endif %}
  {% if section.settings.mobile_menu != blank %}
    <div class="header-alt_megamenu-mobile-top-links mobile-only">
      {% for link in section.settings.mobile_menu.links %}
          <a class="header-alt_megamenu-top-link" href="{{ link.url }}">
            <span>{{ link.title }}</span>
          </a>
      {% endfor %}
    </div>
  {% endif %}
  {% if section.settings.mobile_footer_menu != blank %}
    <div class="header-alt__mobile-footer-menu mobile-only">
      <div class="header-alt__mobile-footer-menu_inner">
      {% for link in section.settings.mobile_footer_menu.links %}
          <a class="header-alt__mobile-footer-item" href="{{ link.url }}">
            <span>{{ link.title }}</span>
          </a>
      {% endfor %}
      </div>
    </div>
  {% endif %}
    {% comment %} <div class="alt_megamenu-footer-wrap mobile-only">
      <div class="alt_megamenu-footer">
        <a class="header-alt-link" href="{{ routes.account_url }}">
          <span class="header-alt-link_icon">{% render 'svg-user-alt' %}</span>
          <span class="header-alt-link_text">
            {%- if customer -%}
              {%- if customer.first_name != blank -%}
                {{ customer.first_name }}{% render 'svg-dot' %}
              {% else %}
                {{ 'customer.account.title' | t }}{% render 'svg-dot' %}
              {%- endif -%}
            {% else %}
            {{ 'customer.login.title' | t }}
            {%- endif -%}
          </span>
        </a>
        <a class="header-alt-link inactive" href="{{ routes.cart_url }}">
          <span class="header-alt-link_icon">{% render 'svg-cart-alt' %}</span>
          <span class="header-alt-link_text">{{ 'layout.header.cart' | t }}</span>
        </a>
      </div>
    </div> {% endcomment %}
</div>
<div class="header-alt__megamenu-bg"></div>
{% javascript %}

  theme.HeaderSectionAlt = new function () {
    this.onSectionLoad = function (container) {
       this.$container = $(container);

       // set anything that alters based on contents/viewport/scroll, etc
       this.section = document.querySelector('.section-header');

       this.functions.setSticky.call(this);
       this.functions.setHeaderHeightProperty.call(this);
       this.functions.setScrollClass.call(this);

       $(window).on('scroll.headerSection', this.functions.afterScroll.bind(this));
       $(window).on('debouncedresize.headerSection', this.functions.afterResize.bind(this));

       // account / localization (after mobile nav initialises)
       $('.disclosure', container).each(function () {
         $(this).data('disclosure', new theme.Disclosure($(this)));
       });

       $('.mobile-navigation-drawer .disclosure').each(function () {
         $(this).data('disclosure', new theme.Disclosure($(this)));
       });

       // reveal cart drawer
       if (theme.settings.cart_type == 'drawer' && document.querySelector('.cart-drawer')) {
         $(container).on('click', '.cart-link', (evt) => {
           evt.preventDefault();
           document.dispatchEvent(
             new CustomEvent('theme:open-cart-drawer', { bubbles: true, cancelable: false })
           );
         });
       }

       // listen to cart changes
       $(document).on('theme:cartchanged.headerSection', function () {
         $.getJSON(location.origin + '?sections=header-alt', function (data) {
           var cartSummarySelectors = ['#pageheader .header-alt-link.cart'];
           for (var i = 0; i < cartSummarySelectors.length; i++) {
             var $newCartObj = $('<div>' + data['header-alt'] + '</div>').find(cartSummarySelectors[i]).first();
             var $currCart = $(cartSummarySelectors[i]);
             $currCart.html($newCartObj.html());
           }
         });
       });

       // init mobile nav again if it's open and this is a reload
       if (Shopify.designMode && $('body').hasClass('reveal-mobile-nav')) {
         theme.openMobileNav();
       }

       // search
       if ($('.header-search-template', container).length) {
         $(container).on('click.headerSection', '.show-search-link', (evt) => {
           evt.preventDefault();
           evt.stopPropagation();

           if (document.querySelector('.header-search-content:not(.hidden)')) {
             this.functions.closeSearch.call(this);
           } else {
             this.functions.openSearch.call(this);
           }
         });
       }
     };

     this.onSectionUnload = function (container) {
       $(container).off('.headerSection');
       $(document).off('.headerSection');
