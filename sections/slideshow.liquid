<div id="section-id-{{ section.id }}" class="slideshow-container card-br-oh" data-section-type="slideshow" data-cc-animate data-cc-animate-delay="0.2s">
  
    {%- style -%}
      {%- if section.settings.height == 'fixed' -%}
      #section-id-{{ section.id }} {
        --image-height: {{ section.settings.height_mobile }}px;
      }
      {%- elsif section.settings.height == 'adapt' and section.blocks.size > 0 and section.blocks.first.settings.image -%}
        #section-id-{{ section.id }} .background-image {
          --ar-padding: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}% !important;
        }
        {%- if section.blocks.first.settings.mobile_image -%}
          @media (max-width: 767px) {
            #section-id-{{ section.id }} .background-image.mobile-only {
              --ar-padding: {{ 1 | divided_by: section.blocks.first.settings.mobile_image.aspect_ratio | times: 100 }}% !important;
            }
          }
        {%- endif -%}
      {%- endif -%}
  
      @media (min-width: 768px) {
        {%- if section.settings.height == 'fixed' -%}
        #section-id-{{ section.id }} {
          --image-height: {{ section.settings.height_desktop }}px;
        }
        {%- endif -%}
      }
    {%- endstyle -%}
  {% assign slides = 0 %}
    <div class="card-scheme card-scheme--{{ section.settings.color_scheme }} slideshow slideshow--navigation-{{ section.settings.slide_navigation | split: ' ' | first }} slick-slider-overlay-dots-desktop {% if section.settings.mobile_overlay_under %}slick-slider--mobile-stack{% else %}slick-slider-overlay-dots{% endif %}" data-transition="{{ section.settings.slide_transition }}" data-autoplay="{{ section.settings.autoplay }}" data-autoplay-speed="{{ section.settings.autoplay_speed }}" data-navigation="{{ section.settings.slide_navigation | split: ' ' | first }}">
      {%- for block in section.blocks -%}
        {% if block.type == 'image' %}
         {% assign slides = slides | plus: 1 %}
        {%- liquid
          assign show_overlay_text = false
          if block.settings.title != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_label_1 != blank or block.settings.button_label_2 != blank
            assign show_overlay_text = true
            assign wrap_slide_with_link = true
            if block.settings.slide_link == blank or block.settings.text contains '</a>' or block.settings.button_url_1 != blank or block.settings.button_url_2 != blank
              assign wrap_slide_with_link = false
            endif
          elsif block.settings.slide_link != blank
            assign wrap_slide_with_link = true
          endif
  
          if section.settings.mobile_overlay_under and section.settings.color_scheme == 'none'
            assign image_class = 'card-br-oh'
          else
            assign image_class = ''
          endif
        -%}
        <div class="slide slide-{{ forloop.index }} {{ block.settings.scheme }} height--{{ section.settings.height }} image-overlay image-overlay--bg-{{ section.settings.overlay_style }} {% if section.settings.mobile_overlay_under %}overlay-text-parent--mobile-stack{% endif %}" {{ block.shopify_attributes }}>
          
        {% style %}
          .slide-{{ forloop.index }} .overlay-text{
            top: {{block.settings.vertical_inset}}; 
            bottom: {{block.settings.vertical_inset}}; 
          }
          @media (max-width: 767px){
            .slide-{{ forloop.index }} .overlay-text{
              top: {{block.settings.vertical_inset_mobile}}; 
              bottom: {{block.settings.vertical_inset_mobile}}; 
            }
          }
        {% endstyle %}
          {%- if wrap_slide_with_link -%}
            <a class="image-overlay__image-link focus-inset" href="{{ block.settings.slide_link }}">
          {%- endif -%}
  
          {%- if block.settings.image == blank and block.settings.video == nil -%}
            <div class="placeholder-image placeholder--banner{% if show_overlay_text %} dark{% endif %} {{ image_class }}" {% if section.settings.height == 'adapt' %}style="padding-top: 50%"{% endif %}>
              {% capture current %}{% cycle 1, 2 %}{% endcapture %}
              {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- else -%}
            {%- if block.settings.video != nil -%}
              {% capture bg %}
                background-image: url({{ block.settings.image | image_url: width: nil }})
              {% endcapture %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '0x', class: "slideshow__slide_video desktop-only", style: bg, poster: "", preload: "none" }}
              {% capture bg %}
                background-image: url({{ block.settings.mobile_image | default: block.settings.image | image_url: width: nil }})
              {% endcapture %}
              {{ block.settings.video_mobile | default: block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '0x', class: "slideshow__slide_video mobile-only", style: bg, poster: "", preload: "none" }}
            {%- else -%}
              {%-
                render 'background-image',
                  image: block.settings.image,
                  mobile_image: block.settings.mobile_image,
                  wide_image: block.settings.image_wide,
                  mobile_image_position: block.settings.mobile_image.presentation.focal_point,
                  eager: forloop.first,
                  no_transition_in: true,
                  wide: true,
                  extra_classes: image_class
              -%}
            {%- endif -%}
          {%- endif -%}
  
          {%- if show_overlay_text -%}
            <div class="overlay-text card overlay-text--with-reveal overlay-text--for-banner overlay--v-{{ block.settings.text_alignment | split: ' ' | first }} overlay--h-{{ block.settings.text_alignment | split: ' ' | last }} image-overlay__over">
              <div class="overlay-text__inner" style="max-width: {{ block.settings.content_max_width }}px">
                <div class="overlay-text__text">
                  {%- if block.settings.subheading != blank -%}
                    <div class="overlay-text__reveal"><div class="overlay-text__subheading subheading subheading--over">{{ block.settings.subheading | escape }}</div></div>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <div class="overlay-text__reveal">
                      {% if block.settings.use_h1 %}
                        <h1 class="overlay-text__title {{ block.settings.title_size }}">{% render 'feature-heading-text', text: block.settings.title, item_settings: block.settings %}</h1>
                      {% else %}
                        <h2 class="overlay-text__title {{ block.settings.title_size }}">{% render 'feature-heading-text', text: block.settings.title, item_settings: block.settings %}</h2>
                      {% endif %}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="overlay-text__reveal"><div class="overlay-text__rte rte{% if block.settings.enlarge_text %} large-text{% endif %}">{{ block.settings.text }}</div></div>
                  {%- endif -%}
                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    <div class="overlay-text__button-row">
                      {%- if wrap_slide_with_link -%}
                        {%- if block.settings.button_label_1 != blank -%}
                          <span class="overlay-text__button btn btn--link"><span class="btn__text">{{ block.settings.button_label_1 }}</span></span>
                        {%- endif -%}
                        {%- if block.settings.button_label_2 != blank -%}
                          <span class="overlay-text__button btn btn--link"><span class="btn__text">{{ block.settings.button_label_2 }}</span></span>
                        {%- endif -%}
                      {%- else -%}
                        {%- if block.settings.button_label_1 != blank -%}
                          {% render 'btn-global', class: 'overlay-text__button btn', url: block.settings.button_url_1, label: block.settings.button_label_1, icon: true %}
                        {%- endif -%}
                        {%- if block.settings.button_label_2 != blank -%}
                          {% render 'btn-global', class: 'overlay-text__button btn', url: block.settings.button_url_2, label: block.settings.button_label_2, icon: true %}
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
  
          {%- if wrap_slide_with_link -%}
            </a>
          {%- endif -%}
        </div>
      {% endif %}
    {%- endfor -%}
  </div>

  {% if section.settings.slide_navigation contains 'arrows' and slides > 1 %}
    <div class="slideshow-controls slideshow-controls--count slideshow-controls--count-{{ section.settings.slide_navigation | split: ' ' | last }}">
      <div class="slideshow-controls__count">1 / {{ section.blocks.size }}</div>
    </div>
  {% endif %}
  {%- for block in section.blocks -%}
    {% if block.type == 'hotspot' %}
      {% if block.settings.product != blank %}
        {% assign product = block.settings.product %}
        {% capture variables %}
          --posX:{{ block.settings.h_pos }}%;
          --posY:{{ block.settings.v_pos }}%;
          --dist: {{ block.settings.dist }}px;
          --angle: {{ block.settings.angle }};
          {%- if block.settings.repos_mobile %}
            --posX-mobile:{{ block.settings.h_pos_mobile }}%;
            --posY-mobile:{{ block.settings.v_pos_mobile }}%;
            --dist-mobile: {{ block.settings.dist_mobile }}px;
            --angle-mobile: {{ block.settings.angle_mobile }};
          {%- endif -%}
          {%- if block.settings.repos_wide %}
            --posX-wide:{{ block.settings.h_pos_wide }}%;
            --posY-wide:{{ block.settings.v_pos_wide }}%;
            --dist-wide: {{ block.settings.dist_wide }}px;
            --angle-wide: {{ block.settings.angle_wide }};
          {%- endif -%}
        {% endcapture %}
        <div class="w2024-adjustable__hotspot{% if block.settings.repos_mobile %} mobile-repos{% endif %}{% if block.settings.repos_wide %} wide-repos{% endif %}" style="{{ variables }}" {{ block.shopify_attributes }}>
          <div class="w2024-adjustable__hotspot_anchor"></div>
           <div class="w2024-adjustable__hotspot_angle">
             <a class="w2024-adjustable__hotspot_wrap" href="{{ product.url }}">
               <div class="w2024-adjustable__hotspot_img-wrap">
                 {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 100 | image_tag: class: 'w2024-adjustable__hotspot_img' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'w2024-adjustable__hotspot_img placeholder' }}
                {% endif %}
               </div>
               <div class="w2024-adjustable__hotspot_text-wrap">
                 <h4 class="w2024-adjustable__hotspot_title">{{ product.title }}</h4>
                 <p class="w2024-adjustable__hotspot_price">{{ product.price | money }}</p>
                 <span class="w2024-adjustable__hotspot_btn">
                   <span class="w2024-adjustable__hotspot_btn-text">{{ block.settings.btn_text }}</span>
                   {% render 'svg-arrow-w2024-hotspot' %}
                 </span>
               </div>
             </a>
           </div>
        </div>
      {% endif %}
    {% endif %}
  {%- endfor -%}
</div>

  

<script>
   document.addEventListener("DOMContentLoaded", () => {
     // if (window.matchMedia("(min-width: 768px)").matches) {
       document.querySelectorAll('#section-id-{{ section.id }} .w2024-adjustable__hotspot').forEach(hotspot => {
         const anchor = hotspot.querySelector('.w2024-adjustable__hotspot_anchor');
         const hotspotWrap = hotspot.querySelector('.w2024-adjustable__hotspot_wrap');
         const tween = gsap.fromTo(hotspotWrap, {opacity: 0}, {opacity: 1, duration: 0.5 , paused: true, 
            onStart: () => {
              hotspotWrap.style.display = "flex";
            },
            onReverseComplete: () => {
              hotspotWrap.style.display = "none";
            },
         })
         function closeFunction(e) {
            if(e.target != hotspotWrap && !hotspotWrap.contains(e.target)){
              // e.stopPropagation();
              tween.reverse()
              hotspot.classList.remove('active')
              document.removeEventListener('click', closeFunction);
            }
          }
         anchor.addEventListener('click', (e) => {
           // e.stopPropagation();
           if(hotspot.classList.contains('active')){
             document.removeEventListener('click', closeFunction);
             tween.reverse()
             hotspot.classList.remove('active')
             return;
           };
           document.querySelector('.section-id-{{ section.id }} .w2024-adjustable__hotspot')?.classList.remove('active')
           tween.play()
           hotspot.classList.add('active')
           setTimeout(()=>{
             document.addEventListener('click', closeFunction);
           })
         })
       })
     })
</script>
{% schema %}
  {
    "name": "Slideshow",
    "class": "section-slideshow",
    "max_blocks": 8,
    "disabled_on": {
      "groups": [
        "aside"
      ]
    },
    "settings": [
      {
        "type": "radio",
        "id": "height",
        "label": "Slide height",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to first image"
          },
          {
            "value": "full",
            "label": "Full screen"
          },
          {
            "value": "fixed",
            "label": "Fixed height"
          }
        ],
        "default": "fixed"
      },
      {
        "type": "range",
        "id": "height_desktop",
        "min": 200,
        "max": 1000,
        "step": 20,
        "unit": "px",
        "label": "Desktop fixed height",
        "default": 600
      },
      {
        "type": "range",
        "id": "height_mobile",
        "min": 100,
        "max": 1000,
        "step": 20,
        "unit": "px",
        "label": "Mobile fixed height",
        "default": 460
      },
      {
        "id": "mobile_overlay_under",
        "type": "checkbox",
        "label": "Show text below image on mobile",
        "default": false
      },
      {
        "id": "overlay_style",
        "type": "select",
        "label": "Overlay style",
        "default": "shadow",
        "options": [
          {
            "value": "full",
            "label": "Tint"
          },
          {
            "value": "shadow",
            "label": "Text shadow"
          },
          {
            "value": "full image-overlay--bg-shadow",
            "label": "Text shadow and tint"
          },
          {
            "value": "no_background",
            "label": "No background"
          }
        ]
      },
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "info": "Only seen when text shows under image",
        "default": "1",
        "options": [
          {
            "value": "1",
            "label": "Card 1"
          },
          {
            "value": "2",
            "label": "Card 2"
          },
          {
            "value": "3",
            "label": "Card 3"
