{%- comment -%}
  Rehall — Vacatures header
  Aparte sectie: achtergrondafbeelding met gradient en titel linksonder.
  Identiek aan het Figma-ontwerp (node 7832:3179).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --vac-content-max: {{ s.content_max }}px;
    --vac-side-pad: {{ s.side_padding }}px;
  }

  #shopify-section-{{ section.id }} .vac-header {
    width: 100%;
    margin-inline: auto;
    max-width: calc(var(--vac-content-max) + (var(--vac-side-pad) * 2));
    padding-inline: var(--vac-side-pad);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .vac-header__inner {
    position: relative;
    width: 100%;
    height: {{ s.height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 40px;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: {{ s.border_radius }}px;
  }

  #shopify-section-{{ section.id }} .vac-header__media,
  #shopify-section-{{ section.id }} .vac-header__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .vac-header__placeholder {
    position: absolute;
    inset: 0;
    background: #1d2733;
  }
  #shopify-section-{{ section.id }} .vac-header__placeholder svg {
    width: 100%;
    height: 100%;
    fill: rgba(255,255,255,.12);
  }

  #shopify-section-{{ section.id }} .vac-header__overlay {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: {{ s.overlay_height }}%;
    background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,{{ s.overlay_opacity | divided_by: 100.0 }}));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .vac-header__title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.1;
    font-size: {{ s.title_size }}px;
    word-break: break-word;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .vac-header__inner {
      height: {{ s.height | times: 0.7 | round }}px;
      padding: 28px;
    }
    #shopify-section-{{ section.id }} .vac-header__title {
      font-size: {{ s.title_size | times: 0.6 | round }}px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .vac-header {
      --vac-side-pad: 16px;
    }
    #shopify-section-{{ section.id }} .vac-header__inner {
      height: {{ s.height | times: 0.55 | round }}px;
      padding: 20px;
    }
    #shopify-section-{{ section.id }} .vac-header__title {
      font-size: {{ s.title_size | times: 0.5 | round }}px;
    }
  }
{%- endstyle -%}

<div class="vac-header" style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px;">
  <div class="vac-header__inner">
    {%- if s.image != blank -%}
      <div class="vac-header__media">
        {{ s.image | image_url: width: 3000 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 2000, 3000', alt: s.image.alt | default: s.title }}
      </div>
    {%- else -%}
      <div class="vac-header__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    <div class="vac-header__overlay"></div>

    {%- if s.title != blank -%}
      <h1 class="vac-header__title">{{ s.title | escape }}</h1>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vacatures header",
  "tag": "section",
  "class": "section-vacatures-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Achtergrondafbeelding"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Onze vacatures"
    },
    {
      "type": "header",
      "content": "Vormgeving"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Titelgrootte",
      "default": 54
    },
    {
      "type": "range",
      "id": "height",
      "min": 240,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Hoogte",
      "default": 470
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Hoekafronding",
      "default": 0
    },
    {
      "type": "range",
      "id": "overlay_height",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hoogte donkere gradient",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Sterkte gradient",
      "default": 80
    },
    {
      "type": "header",
      "content": "Breedte & ruimte"
    },
    {
      "type": "range",
      "id": "content_max",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max. breedte content",
      "default": 1540
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Zijmarge (desktop)",
      "default": 94
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Vacatures header"
    }
  ]
}
{% endschema %}
