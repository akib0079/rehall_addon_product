<section class="duur-toewijding-section" style="--height:{{ section.settings.height }};--height-mobile:{{ section.settings.height_mobile }};"{% if section.settings.scroller-id != blank %} data-scroller-id="{{ section.settings.scroller-id }}"{% endif %}>
  <div class="duur-toewijding-container">
    <div class="duur-toewijding-inner-wrap">
      {% if section.settings.subtitle != blank %}
        <li class="duur-section-subtitle"><span>{{ section.settings.subtitle }}</span></li>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="duur-section-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.desc != blank %}
        <div class="duur-toewijding-desc">
          {{ section.settings.desc }}
        </div>
      {% endif %}
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: nil | image_tag: class: 'duur-toewijding-logo'  }}
      {% endif %}
    </div>
  </div>
  {% if section.settings.bg != blank %}
    {{ section.settings.bg_wide | default: section.settings.bg | image_url: width: nil | image_tag: class: 'duur-toewijding-bg wide-only'  }}
    {{ section.settings.bg | image_url: width: nil | image_tag: class: 'duur-toewijding-bg desktop-only'  }}
    {{ section.settings.bg_mobile | default: section.settings.bg | image_url: width: nil | image_tag: class: 'duur-toewijding-bg mobile-only'  }}
  {% endif %}
</section>
{% schema %}
  {
    "name": "Duurzaamheid Toewijding",
    "settings": [
      {
        "type": "text",
        "id": "scroller-id",
        "label": "Scroller ID",
        "default": "toewijding",
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Sub title",
        "default": "Toewijding",
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Eerlijk en duurzaam",
      },
      {
        "type": "richtext",
        "id": "desc",
        "label": "Description",
        "default": "<p>Bij Rehall Outerwear</p>"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "bg",
        "label": "Background image"
      },
      {
        "type": "image_picker",
        "id": "bg_mobile",
        "label": "Background image mobile"
      },
      {
        "type": "image_picker",
        "id": "bg_wide",
        "label": "Background image mobile"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "text",
        "id": "height",
        "label": "Height",
        "default": "847px",
      },
      {
        "type": "text",
        "id": "height_mobile",
        "label": "Height mobile",
        "default": "847px",
      },
    ],
    "presets": [
      {
        "name": "Duurzaamheid Toewijding"
      }
    ]
  }
{% endschema %}