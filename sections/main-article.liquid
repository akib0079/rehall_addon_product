<div class="section-container">
  {% if section.settings.show_date or section.settings.show_article_tags %}
    <div class="article__meta-header">
      {% if section.settings.show_article_tags %}
        {% for tag in article.tags %}
          <span class="article__meta-single tag">
          {{ tag }}
          </span>
        {% endfor %}
      {% endif %}
      {% if section.settings.show_date %}
        <span class="article__meta-single date">
        {{ article.published_at | date: format: 'month_date_year' }}
        </span>
      {% endif %}
    </div>
  {% endif %}
{% if article.title != blank %}
  <h1 class="article__title">{{ article.title | escape }}</h1>
{% endif %}
{% if article.excerpt != blank %}
  <div class="article__excerpt">{{ article.excerpt }}</div>
{% endif %}
{% if section.settings.show_featured_image and article.image != blank %}
  <div class="article__image-wrap">
    {{ article.image | image_url: width: nil | image_tag: class: 'article__image'}}
  </div>
{% endif %}


<div class="article__content-wrap">

  <div class="article__content" data-cc-animate>
    {{ article.content }}
  </div>
  
  <div class="article__right-col" data-cc-animate>
    <div class="article__related-wrap" data-cc-animate>
        {%- liquid
        assign related_articles = nil
        for link in linklists['blog-categories'].links
          assign blog = link.object
          assign related_articles = related_articles | concat: blog.articles
        endfor
        assign related_articles = related_articles | reject: "id", article.id
        assign related_articles = related_articles | sort: 'created_at' | reverse
      -%}
      {% if related_articles != nil %}
        <h5 class="article__related-title" >{{ section.settings.related_title }}</h5>
        <div class="article__related-col">
          {% for article in related_articles limit: 3 %}
          <div class="article__related-single">
            <a class="blogs-archive__article_img-wrap" href="{{ article.url }}">
                {% if article.image != blank %}
                  {{ article.image | image_url: width: nil | image_tag: class: 'blogs-archive__article_img'}}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder blogs-archive__article_img'}}
                {% endif %}
            </a>
            <div class="blogs-archive__article_content">
              <a href="{{ article.url }}"><h4 class="blogs-archive__article_title">{{ article.title }}</h4></a>
              {% if article.excerpt != blank %}
                <div class="blogs-archive__article_excerpt">{{ article.excerpt }}</div>
              {% endif %}
              <a href="{{ article.url }}" class="blogs-archive__article_btn"><span>{{ 'blogs.general.learn_more' | t }}</span> {% render 'svg-blog-arrow' %}</a>
            </div>
          </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_sharing_icons %}
      <div class="lightly-spaced-row" data-cc-animate>
        {% render 'social-sharing', share_title: article.title, share_permalink: article.url, share_image: article.image %}
      </div>
      {% endif %}

      {% comment %} <div class="article-meta" data-cc-animate>
        {% if section.settings.show_date or section.settings.show_author %}
          <span class="iconmeta time">
            {% if section.settings.show_date %}
              {{ article.published_at | date: format: 'month_date_year' }}
            {% endif %}
            {% if section.settings.show_author %}
              {% if section.settings.show_date %} von {% endif %}
              <span class="author">{{ article.author }}</span>
            {% endif %}
          </span>
        {% endif %}

        {% if section.settings.show_article_tags %}
        {% capture tag_markup %}
        <div class="iconmeta tags">
          <span class="label">{{ 'blogs.article.tags' | t }}:</span>
          {% for tag in article.tags %}
            {{ tag | link_to_tag: tag }}
          {% endfor %}
        </div>
        {% endcapture %}
        {% if tag_markup contains '</a>' %}{{ tag_markup }}{% endif %}
        {% endif %}
      </div> {% endcomment %}
    </div>
  </div>

  {% comment %} <div class="pagination-row pagination-row-tabular" data-cc-animate>
    <span class="prev">
      {% if blog.previous_article %}
        <a class="with-icon" href="{{ blog.previous_article }}">
          <span class="icon-container icon icon--small icon-natcol ltr-icon">{% render 'svg-chevron-left' %}</span>
          <span class="with-icon__beside">{{ 'blogs.article.older_post' | t }}</span>
        </a>
      {% endif %}
    </span>

    <span class="back">{{ 'blogs.article.back_to_blog_html' | t: blog: blog.title | link_to: blog.url }}</span>

    <span class="next">
      {% if blog.next_article %}
        <a class="with-icon" href="{{ blog.next_article }}">
          <span class="with-icon__beside">{{ 'blogs.article.newer_post' | t }}</span>
          <span class="icon-container icon icon--small icon-natcol ltr-icon">{% render 'svg-chevron-right' %}</span>
        </a>
      {% endif %}
    </span>
  </div> {% endcomment %}

</div>

{% if blog.comments_enabled? %}
    {% paginate article.comments by 50 %}
        {% if article.comments != blank %}
          <div id="comments" class="container cf fully-padded-row--medium" data-cc-animate>
            <h4 class="align-centre">{{ 'blogs.comments.title' | t }}</h4>

            {% comment %} Show a comment that was *just* submitted {% endcomment %}
            {% if comment and comment.status != 'published' %}
                <div class="comment lightly-spaced-row">
                  <p class="author">{{ 'blogs.comments.author_meta_said' | t: author: comment.author }}</p>
                  <div class="text">{{ comment.content }}</div>
                </div>
            {% endif %}

            {% comment %} Loop through approved comments: {% endcomment %}
            {% for comment in article.comments %}
                <div class="comment lightly-spaced-row {% if forloop.first %}first{% endif %}">
                  <p class="author">{{ 'blogs.comments.author_meta_said' | t: author: comment.author }}</p>
                  <div class="text">{{ comment.content }}</div>
                </div>
            {% endfor %}
          </div> <!-- /#comments -->

          {% render 'pagination-control', paginate: paginate %}
        {% endif %}
    {% endpaginate %}

    <div id="template" class="form container container--reading-width" data-cc-animate>
      {% form article %}
        <h4 id="add-comment-title">{{ 'blogs.comments.form_title' | t }}</h4>

        {% if form.posted_successfully? %}
        <p>{{ 'blogs.comments.success' | t }}</p>
        {% endif %}

        {% if blog.moderated? %}
        <p>{{ 'blogs.comments.moderated' | t }}</p>
        {% endif %}

        {% if form.errors %}
            <ul class="errors">
            {% for field in form.errors %}
                <li>{{ field | capitalize }} {{ form.errors.messages[field] }}</li>
            {% endfor %}
            </ul>
        {% endif %}

        <div class="input-row {% if form.errors contains 'author' %}has-error{% endif %}">
            <label for="comment_author">{{ 'blogs.comments.name' | t }}</label>
            <input type="text" id="comment_author" name="comment[author]" size="40" value="{{form.author}}" required />
        </div>
        <div class="input-row {% if form.errors contains 'email' %}has-error{% endif %}">
            <label for="comment_email">{{ 'blogs.comments.email' | t }}</label>
            <input type="email" id="comment_email" name="comment[email]" size="40" value="{{form.email}}" required />
        </div>
        <div class="input-row {% if form.errors contains 'body' %}has-error{% endif %}">
            <label for="comment_body">{{ 'blogs.comments.message' | t }}</label>
            <textarea id="comment_body" name="comment[body]" cols="40" rows="5" required>{{form.body}}</textarea>
        </div>

        <div class="action_bottom">
            <button type="submit" id="comment-submit" class="btn">{{ 'blogs.comments.post' | t }}</button>
        </div>

      {% endform %}
    </div>
{% endif %}
</div>

{% render 'structured-data-article', article: article %}

{% schema %}
  {
    "name": "Article pages",
    "class": "section-main-article",
    "settings": [
      {
        "type": "inline_richtext",
        "id": "related_title",
        "label": "Related blogs title",
        "default": "Aktuelle Blogs"
      },
  	  {
        "type": "checkbox",
        "id": "show_date",
        "label": "Show date",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_author",
        "label": "Show author",
        "default": true
      },
  	  {
        "type": "checkbox",
        "id": "show_article_tags",
        "label": "Show article tags",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sharing_icons",
        "label": "Show social sharing icons",
        "default": true
      },
      {
        "type": "header",
        "content": "Featured image"
      },
      {
        "type": "checkbox",
        "id": "show_featured_image",
        "label": "Show featured image",
        "default": true
      },
      {
        "type": "select",
        "id": "featured_image_height",
        "label": "Height",
        "options": [
          {
            "value": "small",
            "label": "Compact"
          },
          {
            "value": "medium",
            "label": "Small"
          },
          {
            "value": "large",
            "label": "Medium"
          },
          {
            "value": "huge",
            "label": "Large"
          },
          {
            "value": "natural",
            "label": "Natural"
          }
        ],
        "default": "huge"
      },
      {
        "id": "overlay_style",
        "type": "select",
        "label": "Overlay style",
        "default": "shadow",
        "options": [
          {
            "value": "full",
            "label": "Tint"
          },
          {
            "value": "shadow",
            "label": "Text shadow"
          },
          {
            "value": "full image-overlay--bg-shadow",
            "label": "Text shadow and tint"
          },
          {
            "value": "no_background",
            "label": "No background"
          }
        ]
      }
	  ]
  }
{% endschema %}
