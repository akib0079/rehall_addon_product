{%- comment -%}
  ============================================================
  Footer Rehall
  ------------------------------------------------------------
  - Nieuwsbrief-balk (ENJOY YOUR RIDES)
  - Menukolommen via blocks: per kolom een eigen titel + gekoppeld menu
  - Betaalmiddelen (automatisch uit shop.enabled_payment_types)
  - Groot REHALL-wordmark met instelbare gradient + scroll-reveal animatie
  - Socials uit je theme-instellingen (alleen ingevulde kanalen tonen)
  - Native taalselector (Shopify localization)
  - Copyright-balk
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}

<style>
  #footer-rehall-{{ sid }} {
    --fr-px: {{ s.padding_horizontal | default: 80 }}px;
    --fr-bg: {{ s.background_color | default: '#ffffff' }};
    --fr-border-soft: rgba(0,0,0,0.1);
    --fr-border-line: #e5e5e5;
    --fr-border-faint: rgba(0,0,0,0.05);
    --fr-muted: rgba(0,0,0,0.5);
    --fr-font: 'Roundo', var(--font-body-family, inherit), -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --fr-logo-c1: {{ s.gradient_color_start | default: '#d9d9d9' }};
    --fr-logo-c2: {{ s.gradient_color_end | default: '#f4f4f4' }};
    --fr-logo-angle: {{ s.gradient_angle | default: 90 }}deg;
    --fr-logo-px: {{ s.logo_side_padding | default: 24 }}px;
    background: var(--fr-bg);
    font-family: var(--fr-font);
    color: #000;
    position: relative;
  }

  /* ---------- Lagen voor de onthulling (Dometic-stijl) ---------- */
  /* De scrollende laag dekt het vaste blok af en schuift er bij het einde overheen weg. */
  #footer-rehall-{{ sid }} .fr-flow {
    position: relative;
    z-index: 2;
    background: var(--fr-bg);
  }
  /* Het onderste blok (logo + copyright) zit vast onderaan het scherm en wordt
     van onder naar boven onthuld terwijl de scrollende laag erover wegschuift. */
  #footer-rehall-{{ sid }} .fr-reveal {
    position: sticky;
    bottom: 0;
    z-index: 1;
    background: var(--fr-bg);
  }
  #footer-rehall-{{ sid }} .fr-reveal[data-fr-no-reveal] {
    position: static;
  }

  /* ---------- Nieuwsbrief-balk ---------- */
  #footer-rehall-{{ sid }} .fr-newsletter {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 20px var(--fr-px);
    border-top: 1px solid var(--fr-border-soft);
  }
  #footer-rehall-{{ sid }} .fr-newsletter__heading {
    font-size: 20px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: normal;
    margin: 0;
    white-space: nowrap;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__form {
    display: flex;
    align-items: stretch;
    width: 320px;
    max-width: 100%;
    margin: 0;
    flex-wrap: wrap;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__input {
    flex: 1 1 0;
    min-width: 0;
    width: auto;
    height: 45px;
    box-sizing: border-box;
    border: 1px solid var(--fr-border-line) !important;
    border-right: 0 !important;
    border-radius: 0 !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 11px !important;
    font-family: var(--fr-font);
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    color: #000;
    background: #fff !important;
    outline: none;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__input:focus {
    border-color: #000 !important;
    box-shadow: none !important;
    outline: none;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__input::placeholder {
    color: var(--fr-muted);
    opacity: 1;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__button {
    flex: 0 0 auto;
    height: 45px;
    box-sizing: border-box;
    padding: 0 20px !important;
    margin: 0 !important;
    background: #000 !important;
    color: #fff !important;
    border: 0 !important;
    border-radius: 0 !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    box-shadow: none !important;
    font-family: var(--fr-font);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 16px;
    cursor: pointer;
    white-space: nowrap;
    transition: none;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__button:hover {
    background: #000 !important;
    color: #fff !important;
    opacity: 0.9;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__feedback {
    font-size: 12px;
    margin: 6px 0 0;
    width: 100%;
  }
  #footer-rehall-{{ sid }} .fr-newsletter__feedback--error { color: #c0392b; }
  #footer-rehall-{{ sid }} .fr-newsletter__feedback--success { color: #1e824c; }

  /* ---------- Menukolommen ---------- */
  #footer-rehall-{{ sid }} .fr-nav {
    border-top: 1px solid var(--fr-border-line);
    border-bottom: 1px solid var(--fr-border-line);
    padding: 0 var(--fr-px);
  }
  #footer-rehall-{{ sid }} .fr-nav__inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  #footer-rehall-{{ sid }} .fr-col {
    flex: 1 0 0;
    min-width: 0;
    padding: 50px 0 30px;
  }
  #footer-rehall-{{ sid }} .fr-col__title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 20px;
  }
  #footer-rehall-{{ sid }} .fr-col__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #footer-rehall-{{ sid }} .fr-col__list a {
    font-size: 12px;
    line-height: 20px;
    color: #000;
    text-decoration: none;
  }
  #footer-rehall-{{ sid }} .fr-col__list a:hover { text-decoration: underline; }

  /* ---------- Meta-rij (betaalmiddelen / socials / taal) ---------- */
  #footer-rehall-{{ sid }} .fr-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 30px var(--fr-px) 0;
    flex-wrap: wrap;
  }
  #footer-rehall-{{ sid }} .fr-payments {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  #footer-rehall-{{ sid }} .fr-payments .icon,
  #footer-rehall-{{ sid }} .fr-payments svg {
    height: 22px;
    width: auto;
  }
  #footer-rehall-{{ sid }} .fr-meta__right {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  #footer-rehall-{{ sid }} .fr-socials {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  #footer-rehall-{{ sid }} .fr-socials a {
    display: inline-flex;
    color: #000;
  }
  #footer-rehall-{{ sid }} .fr-socials svg { width: 20px; height: 20px; }

  /* ---------- Taalselector ---------- */
  #footer-rehall-{{ sid }} .fr-locale { position: relative; }
  #footer-rehall-{{ sid }} .fr-locale__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--fr-font);
    font-size: 12px;
    color: #000;
  }
  #footer-rehall-{{ sid }} .fr-locale__toggle svg {
    width: 12px; height: 12px;
    transition: transform .2s ease;
  }
  #footer-rehall-{{ sid }} .fr-locale[aria-expanded="true"] .fr-locale__toggle svg { transform: rotate(180deg); }
  #footer-rehall-{{ sid }} .fr-locale__list {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    min-width: 140px;
    background: #fff;
    border: 1px solid var(--fr-border-line);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    display: none;
    z-index: 5;
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  }
  #footer-rehall-{{ sid }} .fr-locale[aria-expanded="true"] .fr-locale__list { display: block; }
  #footer-rehall-{{ sid }} .fr-locale__list button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 8px 16px;
    font-family: var(--fr-font);
    font-size: 12px;
    color: #000;
    cursor: pointer;
  }
  #footer-rehall-{{ sid }} .fr-locale__list button:hover { background: #f5f5f5; }
  #footer-rehall-{{ sid }} .fr-locale__list button[aria-current="true"] { font-weight: 600; }

  /* ---------- Groot wordmark ---------- */
  #footer-rehall-{{ sid }} .fr-logo {
    padding: 16px var(--fr-logo-px);
  }
  #footer-rehall-{{ sid }} .fr-logo__img {
    display: block;
    width: 100%;
    aspect-ratio: 1610 / 230;    /* zelfde verhouding als in het design */
    object-fit: contain;
    object-position: center;
  }
  #footer-rehall-{{ sid }} .fr-logo__mark {
    display: block;
    width: 100%;
    aspect-ratio: 1610 / 230;
    background: linear-gradient(var(--fr-logo-angle), var(--fr-logo-c1), var(--fr-logo-c2));
    -webkit-mask: var(--fr-logo-src) no-repeat center / contain;
            mask: var(--fr-logo-src) no-repeat center / contain;
  }

  /* ---------- Copyright ---------- */
  #footer-rehall-{{ sid }} .fr-copyright {
    border-top: 1px solid var(--fr-border-faint);
    padding: 20px var(--fr-px);
    font-size: 12px;
    line-height: 16px;
    color: var(--fr-muted);
  }
  #footer-rehall-{{ sid }} .fr-copyright a { color: inherit; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    #footer-rehall-{{ sid }} .fr-nav__inner { flex-wrap: wrap; }
    #footer-rehall-{{ sid }} .fr-col { flex: 1 0 30%; }
  }
  @media (max-width: 749px) {
    #footer-rehall-{{ sid }} { --fr-px: 20px; }
    #footer-rehall-{{ sid }} .fr-newsletter { flex-direction: column; align-items: flex-start; gap: 16px; }
    #footer-rehall-{{ sid }} .fr-newsletter__form { width: 100%; }
    #footer-rehall-{{ sid }} .fr-col { flex: 1 0 45%; padding: 30px 0 10px; }
    #footer-rehall-{{ sid }} .fr-meta { flex-direction: column; align-items: flex-start; gap: 20px; }
    #footer-rehall-{{ sid }} .fr-meta__right { width: 100%; justify-content: space-between; }
    #footer-rehall-{{ sid }} .fr-logo { padding: 16px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    #footer-rehall-{{ sid }} .fr-reveal { position: static; }
  }
</style>

<footer id="footer-rehall-{{ sid }}" class="footer-rehall" role="contentinfo">

  {%- comment -%} ===== Scrollende laag (schuift over het vaste blok) ===== {%- endcomment -%}
  <div class="fr-flow">

  {%- comment -%} ===== Nieuwsbrief-balk ===== {%- endcomment -%}
  {%- if s.show_newsletter -%}
    <div class="fr-newsletter">
      {%- if s.newsletter_heading != blank -%}
        <p class="fr-newsletter__heading">{{ s.newsletter_heading }}</p>
      {%- endif -%}
      {%- form 'customer', class: 'fr-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="fr-newsletter__feedback fr-newsletter__feedback--success">{{ s.newsletter_success | default: 'Bedankt voor je aanmelding!' }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="fr-newsletter__feedback fr-newsletter__feedback--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <input
            type="email"
            name="contact[email]"
            class="fr-newsletter__input"
            placeholder="{{ s.newsletter_placeholder | default: 'Enter your email address...' }}"
            required
            aria-label="{{ s.newsletter_placeholder | default: 'Enter your email address...' }}">
          <button type="submit" class="fr-newsletter__button">{{ s.newsletter_button_label | default: 'Sign up' }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- comment -%} ===== Menukolommen (blocks) ===== {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <nav class="fr-nav" aria-label="Footer">
      <div class="fr-nav__inner">
        {%- for block in section.blocks -%}
          {%- assign menu = block.settings.menu -%}
          <div class="fr-col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="fr-col__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if menu != blank and linklists[menu].links.size > 0 -%}
              <ul class="fr-col__list">
                {%- for link in linklists[menu].links -%}
                 {%- unless link.url contains 'impressum' and localization.language.iso_code != 'de' -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </nav>
  {%- endif -%}

  {%- comment -%} ===== Meta-rij: betaalmiddelen + socials + taal ===== {%- endcomment -%}
  <div class="fr-meta">

    {%- if s.show_payment_icons -%}
      <div class="fr-payments" aria-label="{{ 'general.payment.method' | t | default: 'Betaalmethoden' }}">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div></div>
    {%- endif -%}

    <div class="fr-meta__right">

      {%- comment -%} Socials: alleen tonen wat in de theme-instellingen is ingevuld {%- endcomment -%}
      {%- liquid
        assign has_social = false
        if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_linkedin_link != blank
          assign has_social = true
        endif
      -%}
      {%- if has_social -%}
        <div class="fr-socials">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.8c-3.15 0-3.52.01-4.76.07-.9.04-1.39.2-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.28.81-.32 1.71-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.04.9.2 1.39.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.81.28 1.71.32 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c.9-.04 1.39-.2 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.28-.81.32-1.71.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.04-.9-.2-1.39-.32-1.71a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.12-.81-.28-1.71-.32-1.24-.06-1.61-.07-4.76-.07Zm0 3.06a4.98 4.98 0 1 1 0 9.96 4.98 4.98 0 0 1 0-9.96Zm0 8.21a3.23 3.23 0 1 0 0-6.46 3.23 3.23 0 0 0 0 6.46Zm6.34-8.41a1.16 1.16 0 1 1-2.33 0 1.16 1.16 0 0 1 2.33 0Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.12 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 0 1-1-2.82h-3.1v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .8-5.05V9.69a5.83 5.83 0 0 0-.8-.06A5.69 5.69 0 1 0 15.6 15.3V8.99a7.34 7.34 0 0 0 4.28 1.37V7.27a4.28 4.28 0 0 1-3.28-1.45Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.5a3 3 0 0 0-2.12-2.12C19.5 3.86 12 3.86 12 3.86s-7.5 0-9.38.52A3 3 0 0 0 .5 6.5 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.5 3 3 0 0 0 2.12 2.12c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.5ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26L22.83 21.75h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.17 2.25h6.83l4.71 6.23 5.53-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.04l12.04 15.64Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.42 7.63 11.17-.11-.95-.2-2.4.04-3.44.22-.93 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.2.6 2.18 1.78 2.18 2.14 0 3.78-2.26 3.78-5.51 0-2.88-2.07-4.9-5.02-4.9-3.42 0-5.43 2.57-5.43 5.22 0 1.03.4 2.14.9 2.74.1.12.11.22.08.34l-.33 1.37c-.05.22-.18.27-.4.16-1.5-.7-2.44-2.89-2.44-4.65 0-3.78 2.75-7.26 7.92-7.26 4.16 0 7.39 2.96 7.39 6.92 0 4.13-2.6 7.46-6.22 7.46-1.21 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 1 0 12 0Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_linkedin_link != blank -%}
            <a href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45C23.2 24 24 23.22 24 22.26V1.74C24 .78 23.2 0 22.22 0Z"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Taalselector (native Shopify localization) {%- endcomment -%}
      {%- if s.show_locale_selector and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'fr-locale-form' -%}
          <div class="fr-locale" data-fr-locale aria-expanded="false">
            <button type="button" class="fr-locale__toggle" aria-haspopup="listbox" aria-label="{{ 'localization.language_label' | t | default: 'Taal' }}">
              <span>{{ localization.language.iso_code | upcase }}</span>
              <svg viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6l5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-fr-locale-input>
            <ul class="fr-locale__list" role="listbox">
              {%- for language in localization.available_languages -%}
                <li role="option">
                  <button type="button" data-fr-locale-value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endform -%}
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ===== Einde scrollende laag ===== {%- endcomment -%}
  </div>

  {%- comment -%} ===== Vast onthul-blok: groot wordmark + copyright (Dometic-stijl) ===== {%- endcomment -%}
  <div class="fr-reveal" {% if s.enable_logo_reveal == false %}data-fr-no-reveal{% endif %}>

    {%- if s.big_logo != blank -%}
      <div class="fr-logo">
        {%- if s.logo_gradient -%}
          <span class="fr-logo__mark" role="img" aria-label="{{ shop.name | escape }}"
            style="--fr-logo-src: url('{{ s.big_logo | image_url: width: 1600 }}');"></span>
        {%- else -%}
          <img class="fr-logo__img" src="{{ s.big_logo | image_url: width: 1600 }}" alt="{{ shop.name | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.copyright_text != blank -%}
      <div class="fr-copyright">
        {{ s.copyright_text }}
      </div>
    {%- endif -%}

  </div>

</footer>

<script>
  (function () {
    var root = document.getElementById('footer-rehall-{{ sid }}');
    if (!root) return;

    /* ---- Taalselector ---- */
    var locale = root.querySelector('[data-fr-locale]');
    if (locale) {
      var form = locale.closest('form');
      var hidden = locale.querySelector('[data-fr-locale-input]');
      var toggle = locale.querySelector('.fr-locale__toggle');

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        locale.setAttribute('aria-expanded', locale.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
      });

      locale.querySelectorAll('[data-fr-locale-value]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          hidden.value = btn.getAttribute('data-fr-locale-value');
          if (form) form.submit();
        });
      });

      document.addEventListener('click', function (e) {
        if (!locale.contains(e.target)) locale.setAttribute('aria-expanded', 'false');
      });
    }
  })();
</script>

