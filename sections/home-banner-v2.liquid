<div class="section-container">
    <div id="section-id-{{ section.id }}" class="section-home-banner-v2-wrap{% if section.settings.overlay %} with-overlay{% endif %}" data-cc-animate>
        <div class="home-banner-v2__content">
            {% if section.settings.title != blank %}
                <h2 class="home-banner-v2__title">{{ section.settings.title }}</h2>
            {% endif %}
            {% comment %} <div class="home-banner-v2__desc">
                {% if section.settings.text_1 != blank %}
                    <span>{{ section.settings.text_1 }}</span>
                {% endif %}
                {% if section.settings.icon_1 != blank %}
                    {{ section.settings.icon_1 | image_url: width: nil | image_tag }}
                {% endif %}
                {% if section.settings.text_2 != blank %}
                    <span>{{ section.settings.text_2 }}</span>
                {% endif %}
                {% if section.settings.icon_2 != blank %}
                    {{ section.settings.icon_2 | image_url: width: nil | image_tag }}
                {% endif %}
            </div> {% endcomment %}
            {% if section.settings.btn_text != blank %}
            <a class="home-banner-v2__btn" href="{{ section.settings.btn_url }}">
              <span class="btn__text">{{ section.settings.btn_text | escape }}</span>
              <span  class="btn__icon">{% render 'svg-arrow-up-left' %}</span>
            </a>
            {% endif %}
        </div>
        {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: nil | image_tag: class: "home-banner-v2__img desktop-only" }}
            {{ section.settings.image_mobile | default: section.settings.image | image_url: width: nil | image_tag: class: "home-banner-v2__img mobile-only" }}
        {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'home-banner-v2__img placeholder' }}
        {% endif %}
    </div>
</div>
{% style %}
    .section-home-banner-v2-wrap{
      height: 620px;
      display: flex;
      align-items: flex-end;
      position: relative;
      z-index: 1;
    }
    .section-home-banner-v2-wrap.with-overlay::before{
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 33%;
      z-index: -1;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.00) 0%, rgba(0, 0, 0, 0.80) 100%);
    }
    .home-banner-v2__content{
      padding: 116px 61px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      color: #FFF;
    }
    .home-banner-v2__title{
      color: inherit;
      font-size: 40px;
      font-weight: 700;
      line-height: normal;
      letter-spacing: -0.8px;
    }
    .home-banner-v2__desc {
      display: flex;
      grid-gap: 1px 13px;
      align-items: center;
      margin-top: 5px;
      font-size: 12px;
      line-height: 26px;
      flex-wrap: wrap;
    }
