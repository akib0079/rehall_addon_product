    .home-banner-v2__btn {
  color: inherit;
  display: flex;
  padding: 8px 30px;
  margin-top: 48px;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 18px;
  font-weight: 500;
  line-height: 98%;
  letter-spacing: -0.36px;
  font-family: 'Roundo', 'Assistant', sans-serif;
  border: 1px solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10.65px);
  position: relative; /* REQUIRED for the shimmer reflection */
  overflow: hidden;   /* REQUIRED to keep the light inside the button */
  transition: all 0.3s ease;
  cursor: pointer;
}

  /* The light beam */
  .home-banner-v2__btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.45),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.55s ease;
  }

  /* --- HOVER STATE --- */
  .home-banner-v2__btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .home-banner-v2__btn:hover::after {
    left: 150%; /* Triggers the light sweep */
  }

  .home-banner-v2__btn svg {
    width: 25px;
    height: 24px;
    transition: transform 0.3s ease;
  }

  .home-banner-v2__btn:hover svg {
    transform: translateX(4px); /* Gently pushes the icon right */
  }

.home-banner-v2__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  object-fit: cover;
}
    .home-banner-v2__img{
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      object-fit: cover;
    }
    .home-banner-v2__img.placeholder{
      background-color: #b5b5b5;
    }
    @media (max-width: 767px){
      .section-home-banner-v2-wrap{
        height: 500px;
        align-items: center;
        justify-content: center;
      }
      .home-banner-v2__content{
        padding: 50px 20px;
        text-align: center;
        align-items: center;
      }
      .home-banner-v2__title{
        font-size: 32px;
      }
      .home-banner-v2__desc{
        align-items: center;
      }
    }
  {% endstyle %}


{% schema %}
  {
    "name": "Our story banner",
    "class": "section-home-banner-v2",
    "disabled_on": {
      "groups": [
        "aside"
      ]
    },
    "settings": [
      {
        "id": "title",
        "type": "inline_richtext",
        "label": "Title",
        "default": "END OF SEASON SALE"
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button text",
        "default": "Shop Alles"
      },
      {
        "type": "url",
        "id": "btn_url",
        "label": "Button url",
        "default": "/collections/all"
      },
      {
        "type": "inline_richtext",
        "id": "text_1",
        "label": "Text 1",
        "default": "Excellent"
      },
      {
        "type": "image_picker",
        "id": "icon_1",
        "label": "Icon 1"
      },
      {
        "type": "inline_richtext",
        "id": "text_2",
        "label": "Text 2",
        "default": "436 reviews on"
      },
      {
        "type": "image_picker",
        "id": "icon_2",
        "label": "Icon 2"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Background Image"
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "Background Image mobile"
      },
      {
        "type": "checkbox",
        "id": "overlay",
        "label": "Overlay",
        "default": true
      },
    ],
    "presets": [
      {
        "name": "Home Banner V2"
      }
    ]
  }
{% endschema %}
