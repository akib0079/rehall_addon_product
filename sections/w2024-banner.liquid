{% style %}
    .section-id-{{ section.id }}{
      height: {{ section.settings.height }};
    }
    {% if section.settings.bg_image != blank %}
    .section-id-{{ section.id }} .w2024-banner__inner{
      background-image: url({{ section.settings.bg_image | image_url }});
    }
    {% endif %}
    @media (max-width: 767px) {
      .section-id-{{ section.id }}{
        height: {{ section.settings.height_mobile }};
      }
    }
  html, body{
    scroll-behavior: auto;
  }
{% endstyle %}
<div class="w2024-banner section-id-{{ section.id }}">
  <div class="w2024-banner__inner">
    {% if section.settings.bg_image != blank %}
      {{ section.settings.bg_image | image_url: width: nil | image_tag: class: 'w2024-banner__bg-img desktop-only', loading: 'eager' }}
      {{ section.settings.bg_image_mobile | default: section.settings.bg_image | image_url: width: nil | image_tag: class: 'w2024-banner__bg-img mobile-only', loading: 'eager' }}
    {% endif %}
    <div class="w2024-banner__scene-container scene-1 layer-bg">
      <div class="section-container">
        <h1 class="w2024-banner__bg-title"><span class="mobile-big">{{ section.settings.title_back_p1 }}</span> {{ section.settings.title_back_p2 }}</h1>
      </div>
    </div>
    <div class="w2024-banner__wandering-elipsis"></div>
    {% if section.settings.overlay_image != blank %}
      {{ section.settings.overlay_image | image_url: width: nil | image_tag: class: 'w2024-banner__overlay-img desktop-only', loading: 'eager' }}
      {{ section.settings.overlay_image_mobile | default: section.settings.overlay_image | image_url: width: nil | image_tag: class: 'w2024-banner__overlay-img mobile-only', loading: 'eager' }}
    {% endif %}
    <div class="w2024-banner__scene-container scene-1">
      <div class="section-container">
        <div class="scene-1-text-wrapper">
          <h4 class="w2024-banner__subtitle">{{ section.settings.sub_title }}</h4>
          <h2 class="w2024-banner__title">{{ section.settings.title | newline_to_br}}</h2>
        </div>
      </div>
    </div>
    <div class="w2024-banner__scene-container scene-2">
      <div class="section-container">
          <h2 class="w2024-banner__title second">{{ section.settings.second_title }}</h2>
          <h2 class="w2024-banner__title second light">{{ section.settings.second_title_light}}</h2>
      </div>
    </div>
  </div>
  <div class="w2024-video-section inner-section">
    <div class="w2024-video__bg"></div>
    <div class="section-container">
      <div class="w2024-video__grid">
        <div class="w2024-video__left">
          {% if section.settings.video != blank %}
            {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, class: 'w2024-video__video' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'w2024-video__video placeholder' }}
          {% endif %}
        </div>
        <div class="w2024-video__right">
          <h2 class="w2024-video__title">{{ section.settings.video_title }}</h2>
          <p class="w2024-video__desc">{{ section.settings.video_desc }}</p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger) ;
     gsap.registerPlugin(ScrollToPlugin)
    let tl = gsap.timeline({
      ease: Linear.easeNone,
      scrollTrigger: {
          trigger: '.w2024-banner.section-id-{{ section.id }}',
          start: 'top top',
          end: 'bottom bottom', 
          scrub: 1,
      }
    });
    if (window.matchMedia("(min-width: 768px)").matches) {
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.desktop-only', {objectPosition: '50% 15%', duration: 0.50}, 0);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.desktop-only', {objectPosition: '50% 80%', scale: 0.525, duration: 0.25}, 0);
      tl.fromTo('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-1', {opacity: 0}, {opacity: 1, duration: 0.20}, 0.05);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.desktop-only', {objectPosition: '50% 65%',scale: 0.8, duration: 0.25}, 0.25);
      tl.to('.section-id-{{ section.id }} .w2024-banner__wandering-elipsis', {top: '75%', right: '10%', duration: 0.25}, 0.25);
      tl.to('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-1', {opacity: 0, duration: 0.12}, 0.25);
      tl.fromTo('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-2', {opacity: 0}, {opacity: 1, duration: 0.13}, 0.37);
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.desktop-only', {objectPosition: '50% 100%',scale: 1, duration: 0.50, ease: "power1.in"}, 0.50);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.desktop-only', {objectPosition: '50% 0%',scale: 1, duration: 0.50, ease: "power1.in"}, 0.50);
      tl.to('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-2', {opacity: 0, duration: 0.25, ease: "power1.in"}, 0.50);
      tl.to('.section-id-{{ section.id }} .w2024-video__bg', {opacity: 1, duration: 0.50}, 0.50);
    // tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img', {scale: 0.65, ease: Linear.easeNone, duration: 0.2}, 0);
    } else {
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.mobile-only', {objectPosition: '50% 15%', duration: 0.25}, 0);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.mobile-only', {objectPosition: '50% 100%', scale: 0.5, duration: 0.25}, 0);
      tl.fromTo('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-1', {opacity: 0}, {opacity: 1, duration: 0.20}, 0.05);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.mobile-only', {objectPosition: '50% 65%',scale: 0.8, x: 160,y: -50, duration: 0.25}, 0.25);
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.mobile-only', {objectPosition: '50% 15%',scale: 0.75, duration: 0.25}, 0.25);
      tl.to('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-1', {opacity: 0, duration: 0.12}, 0.25);
      tl.fromTo('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-2', {opacity: 0}, {opacity: 1, duration: 0.13}, 0.37);
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.mobile-only', {objectPosition: '100% 100%',scale: 1, duration: 0.50, ease: "power1.in"}, 0.50);
      tl.to('.section-id-{{ section.id }} .w2024-banner__bg-img.mobile-only', {objectPosition: '100% 100%',scale: 1, duration: 0.1, ease: "power1.in"}, 1);
      tl.to('.section-id-{{ section.id }} .w2024-banner__overlay-img.mobile-only', {objectPosition: '50% 0%',scale: 1, x: 0,y: 0, duration: 0.50, ease: "power1.in"}, 0.50);
      tl.to('.section-id-{{ section.id }} .w2024-banner__scene-container.scene-2', {opacity: 0, duration: 0.25, ease: "power1.in"}, 0.50);
    }
    setTimeout(() => {
      // window.scrollTo({ top: document.querySelector('.section-id-{{ section.id }}').clientHeight * 0.15, behavior: 'smooth' });
       gsap.to(window, { duration: 2, scrollTo: document.querySelector('.section-id-{{ section.id }}').clientHeight * 0.15 });
    }, 200)
  })
</script>
